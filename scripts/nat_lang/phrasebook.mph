; -----------------------------------------------------------------------------
; phrasebook.mph - the shared, language-neutral phrasing-selection layer.
;
; Holds three thing-kinds, NONE of which is clause text or a belief shape
; (those live once, in packs/<lang>/*.mgr):
;   intents:  the closed intent-tag vocabulary every pack's .mgr tags against.
;   schema:   discourse structure - the ordered slots of a description.
;   select:   voice-conditioned rules mapping (speaker regard / disposition)
;             to a ranked phrasing-intent preference for a slot.
;
; Format (Phase 0 spec 0.4.2): block headers (intents:/schema/select) start at
; column 0; their content lines are indented. ';' starts a comment. A select
; rule is `<key:value>... -> <intent>...`; the first rule whose conditions all
; hold wins; '*' matches unconditionally; every list ends in a default.
;
; This file is non-interned and hot-reloadable - editing it needs no .msb
; regen. See Docs/dialogue_nlg_phase4_design.md section 4.5.
; -----------------------------------------------------------------------------

intents: neutral warm curt blunt deferential flowery scornful respectful tender spiteful terse plain metaphorical anecdotal elaborated intro

; --- Discourse schema for a tell_about person description ---------------------
; Slots mirror the proven body-fact order of the legacy descriptions engine,
; now declared as data. opening + at least one body fact are required; the
; rest are optional, relations repeatable.
schema person_description:
  slot opening     req
  slot age         opt
  slot occupation  opt
  slot relations   rep
  slot interest    req
  slot regard      opt
  slot coda        opt

; --- Discourse schema for "tell me about X's relationship" --------------------
; The kind-quantified relationship discourse. Every body fact is a kin / social
; bond clause - the (msg ...) wire's labels are all is_a [k relationship]. The
; opening still names the subject (intro template) so the body can pronominalise;
; the body groups family kin (parents, spouse, children, siblings, extended)
; from non-kin bonds (friends, neighbours).
schema relationship_description:
  slot opening      req
  slot parents      opt
  slot spouse       opt
  slot children     opt
  slot siblings     opt
  slot extended_kin opt
  slot bonds        opt
  slot regard       opt
  slot coda         opt

; --- Discourse schema for "tell me about X's interests" -----------------------
; The kind-quantified interest discourse. Every body fact is a {X interest [k Y]}
; belief - the discourse_planner aggregates them into one Oxford-comma plural
; clause via the existing interest slot's render path.
schema interest_description:
  slot opening      req
  slot interest     rep
  slot coda         opt

; --- Voice-conditioned phrasing-intent selection -----------------------------
; The condition vocabulary: listener:<verb> and subject:<verb> (the speaker's
; regard for whom he speaks to and of: a stance verb of the signal_verbs table,
; holding when his band on its dim is at least as strong, on the same side - a
; dislike holds of a detest), cog:<style>, role:<role>, class / bond / formality.
; A listener: / subject: verb the signal_verbs table does not declare is a load
; error at the end of the bring-up.
;
; Two axes. A row on the speaker's regard, formality or bond picks the ATTITUDE
; of a clause; a row on who he is (schooling, cog, role, class) picks its STYLE.
; Each is the first row of its kind that holds, in the slot's own block, else in
; the `*` block. With an attitude, its intents are tried in order and the style
; ranks the templates of each; with none, the style row's intents stand alone.
; A positional tag (intro) on the slot's style row leads either way.

; The attitudes every slot shares, strongest first: care at its poles, dread,
; esteem, care, warmth. Trust is said as a hedge (decoration hedge, below).
select *:
  subject:hate      -> spiteful curt neutral
  subject:love      -> warm flowery neutral
  subject:wary      -> deferential neutral
  subject:despise   -> scornful blunt curt neutral
  subject:revere    -> respectful deferential neutral
  subject:disdain   -> scornful curt neutral
  subject:admire    -> respectful neutral
  subject:cherish   -> tender warm neutral
  subject:begrudge  -> spiteful curt neutral
  subject:like      -> warm neutral
  subject:dislike   -> curt neutral
  *                 -> neutral

select opening:
  ; `intro` is the slot-bound tag the opening's vocative-name template
  ; carries; leading with it guarantees that template wins over the
  ; generic-possessive template (which has the same MC shape).
  schooling:high    -> intro flowery elaborated neutral
  cog:abstract      -> intro terse neutral
  cog:sensory       -> intro flowery neutral
  *                 -> intro neutral

select age:
  schooling:high    -> elaborated neutral
  cog:abstract      -> terse neutral
  *                 -> neutral

select occupation:
  schooling:high    -> elaborated flowery neutral
  *                 -> neutral

select relations:
  schooling:high    -> elaborated flowery neutral
  cog:abstract      -> terse neutral
  *                 -> neutral

select interest:
  schooling:high    -> elaborated flowery neutral
  *                 -> neutral

select regard:
  schooling:high    -> elaborated neutral
  *                 -> neutral

select coda:
  schooling:high    -> elaborated neutral
  *                 -> neutral

; --- Decorations ---------------------------------------------------------------
; Surface fragments bolted onto a whole utterance - a description, a statement or
; a question - without making .mgr templates enumerate every (decoration,
; clause-shape) combo. Blocks apply in file order, the first rule of each that
; holds; the catch-all "* -> "" " is a no-op. A decoration rule takes the same
; conditions a select rule does. A question vouches for or doubts no one: its
; subject: conditions never hold.

; Hedge suffix: the speaker's trust in whom he speaks of.
decoration hedge:
  position: suffix
  subject:distrust      -> ", for what that is worth"
  subject:rely          -> ", you may depend on it"
  *                     -> ""

; Address-form suffix (distillation §3.1). A deferential / formal speaker
; punctuates with "sir"; one fond of his listener calls him friend, one who
; detests him says so.
decoration address_form:
  position: suffix
  formality:deferential -> ", sir"
  formality:formal      -> ", sir"
  listener:adore        -> ", my friend"
  listener:detest       -> ", you wretch"
  *                     -> ""

; Softener prefix (distillation §3.2). Cushions what is said to one the speaker
; defers to or is wary of.
decoration softener:
  position: prefix
  formality:deferential -> "Forgive me, but "
  listener:wary         -> "Forgive me, but "
  *                     -> ""
