# -----------------------------------------------------------------------------
# phrasebook.mph - the shared, language-neutral phrasing-selection layer.
#
# Holds three thing-kinds, NONE of which is clause text or a belief shape
# (those live once, in packs/<lang>/*.mgr):
#   intents:  the closed intent-tag vocabulary every pack's .mgr tags against.
#   schema:   discourse structure - the ordered slots of a description.
#   select:   affect-conditioned rules mapping (speaker affect / disposition)
#             to a ranked phrasing-intent preference for a slot.
#
# Format (Phase 0 spec 0.4.2): block headers (intents:/schema/select) start at
# column 0; their content lines are indented. '#' starts a comment. A select
# rule is `<key:value>... -> <intent>...`; the first rule whose conditions all
# hold wins; '*' matches unconditionally; every list ends in a default.
#
# This file is non-interned and hot-reloadable - editing it needs no .msb
# regen. See Docs/dialogue_nlg_phase4_design.md section 4.5.
# -----------------------------------------------------------------------------

intents: neutral warm curt blunt deferential flowery terse plain metaphorical anecdotal elaborated intro

# --- Discourse schema for a tell_about person description ---------------------
# Slots mirror the proven body-fact order of the legacy descriptions engine,
# now declared as data. opening + at least one body fact are required; the
# rest are optional, relations repeatable.
schema person_description:
  slot opening     req
  slot age         opt
  slot occupation  opt
  slot relations   rep
  slot interest    req
  slot regard      opt
  slot coda        opt

# --- Discourse schema for "tell me about X's relationship" --------------------
# The kind-quantified relationship discourse. Every body fact is a kin / social
# bond clause - the (msg ...) wire's labels are all is_a [k relationship]. The
# opening still names the subject (intro template) so the body can pronominalise;
# the body groups family kin (parents, spouse, children, siblings, extended)
# from non-kin bonds (friends, neighbours).
schema relationship_description:
  slot opening      req
  slot parents      opt
  slot spouse       opt
  slot children     opt
  slot siblings     opt
  slot extended_kin opt
  slot bonds        opt
  slot coda         opt

# --- Discourse schema for "tell me about X's interests" -----------------------
# The kind-quantified interest discourse. Every body fact is a {X interest [k Y]}
# belief - the discourse_planner aggregates them into one Oxford-comma plural
# clause via the existing interest slot's render path.
schema interest_description:
  slot opening      req
  slot interest     rep
  slot coda         opt

# --- Affect-conditioned phrasing-intent selection ----------------------------
# The condition vocabulary: affect:<term> (the speaker's regard / mood toward
# the subject or listener), cog:<style>, role:<role>, class / bond / formality.
# Conditions are resolved against the voice-input model at step 4.6; here they
# are only parsed and validated.

select opening:
  # `intro` is the slot-bound tag the opening's vocative-name template
  # carries; preferring it first guarantees that template wins over the
  # generic-possessive template (which has the same MC shape). Every chain
  # still ends in neutral as the fallback. Schooling is ADDITIVE: low /
  # unknown leaves the opening at the baseline neutral voice; high biases
  # toward elaborated / flowery variants.
  affect:loves      -> intro warm flowery neutral
  affect:dislikes   -> intro curt neutral
  schooling:high    -> intro flowery elaborated neutral
  cog:abstract      -> intro terse neutral
  cog:sensory       -> intro flowery neutral
  *                 -> intro neutral

select age:
  schooling:high    -> elaborated neutral
  cog:abstract      -> terse neutral
  *                 -> neutral

select occupation:
  affect:loves      -> warm neutral
  affect:resents    -> curt neutral
  schooling:high    -> elaborated flowery neutral
  *                 -> neutral

select relations:
  affect:loves      -> warm neutral
  schooling:high    -> elaborated flowery neutral
  cog:abstract      -> terse neutral
  *                 -> neutral

select interest:
  affect:loves      -> warm flowery neutral
  affect:resents    -> curt neutral
  schooling:high    -> elaborated flowery neutral
  *                 -> neutral

select regard:
  affect:loves      -> warm flowery neutral
  affect:resents    -> blunt curt neutral
  affect:fears      -> deferential neutral
  schooling:high    -> elaborated neutral
  *                 -> neutral

select coda:
  affect:dislikes   -> curt neutral
  affect:likes      -> warm neutral
  schooling:high    -> elaborated neutral
  *                 -> neutral

# --- relationship_description slot selection ---------------------------------
# The opening is the same vocative-name template as person_description
# (already tagged `:: intro` and matched via slot-bound intent priority).
# Body slots default to neutral; future intent-tagged kinship templates can
# differentiate by affect.

select parents:
  affect:loves      -> warm neutral
  *                 -> neutral

select spouse:
  affect:loves      -> warm flowery neutral
  *                 -> neutral

select children:
  affect:loves      -> warm neutral
  *                 -> neutral

select siblings:
  *                 -> neutral

select extended_kin:
  *                 -> neutral

select bonds:
  affect:loves      -> warm neutral
  *                 -> neutral

# --- Phase 9.4 decorations ---------------------------------------------------
# Per-clause optional surface fragments bolted on top of the realized clause
# without making .mgr templates enumerate every (decoration, clause-shape)
# combo. First-match-wins per block; the catch-all "* -> "" " is a no-op so
# untriggered clauses ship unchanged. v1 evaluates only voice-only conditions
# (cog / role / formality / schooling / class); affect / bond decorations
# need clause-subject / audience context and are deferred to a follow-up.

# Address-form suffix (distillation §3.1). A deferential / formal speaker
# punctuates with "sir"; an intimate / familiar speaker drops the honorific.
# v1 ships one polite suffix; class-down forms ("my good man") added when the
# class-delta derivation finds an audience to compare against.
decoration address_form:
  position: suffix
  formality:deferential -> ", sir"
  formality:formal      -> ", sir"
  *                     -> ""

# Softener prefix (distillation §3.2). Cushions the question / statement
# when the speaker holds a deferential register. v1 fires on formality;
# adding warmth / sensitivity conditions needs the per-clause subject
# context the decoration evaluator does not yet thread through.
decoration softener:
  position: prefix
  formality:deferential -> "Forgive me, but "
  *                     -> ""
