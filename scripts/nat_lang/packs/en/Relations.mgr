
:ACTIVE_REL
"lives at"              /pres home              .
"lived at"              /past home              .
; Whereabouts: the dated location memory {X location <venue>}. The past form
; answers "where were you" (the act-memory alibi substrate); the present form
; renders a standing whereabouts (e.g. a prop's current building).


:PASSIVE_PNAME_REL
"name is"               /pres name              .
"name was"              /past name              .


; age is rendered by the dedicated bare-is template ("X is 56") in
; Statements.mgr; only the past form keeps a possessive surface here.
:PASSIVE_NUM_REL
"age was"               /past age               .


:PASSIVE_REL
"$rel(REL) includes"    /pres $rel(REL) ~       .
"$rel(REL) included"    /past $rel(REL) ~       .
"$rel(REL) excludes"    /pres $rel(REL) ^       .
"$rel(REL) excluded"    /past $rel(REL) ^       .
"$rel(REL) is"          /pres $rel(REL)         .
"$rel(REL) was"         /past $rel(REL)         .

:PASSIVE_REL_PLUR
"$rel(REL) includes"    /pres $rel(REL) ~       .
"$rel(REL) included"    /past $rel(REL) ~       .
"$rel(REL) excludes"    /pres $rel(REL) ^       .
"$rel(REL) excluded"    /past $rel(REL) ^       .
"$rel(REL) are"         /pres $rel(REL)         .
"$rel(REL) were"        /past $rel(REL)         .

; Plural relation names. Used by plural-answer questions ("who are your
; siblings"). Labels themselves remain singular - the plural form is just
; the surface noun. Mirrors the entries in :REL below.
:RELP
"siblings"              sibling                 .
"half siblings"         half-sibling            .
"half-siblings"         half-sibling            .
"parents"               parent                  .
"children"              child                   .
"friends"               friend                  .
"acquaintances"         acquaintance            .
"lovers"                lover                   .


:REL
"fiancee"               fiancee                 .
"spouse"                spouse                  .
"mother"                mother                  .
"father"                father                  .
"parent"                parent                  .
"sibling"               sibling                 .
"half sibling"          half-sibling            .
"half-sibling"          half-sibling            .
"child"                 child                   .
"friend"                friend                  .
"acquaintance"          acquaintance            .
"lover"                 lover                   .
"game-role"             game-role               .

; Attribute-style possessive relations - rendered "X's gender is ...".
; Kind-valued targets, rendered by KIND in :NP. nationality is NOT here -
; it is rendered by the dedicated bare-is template ("X is english") in
; Statements.mgr; keeping it in :REL too would let the longer possessive
; phrase outsort the bare-is form (see the greedy lexicon sort).
"gender"                gender                  .
"social class"          class-situation         .
