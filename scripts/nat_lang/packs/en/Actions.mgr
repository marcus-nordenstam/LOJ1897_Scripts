
:SPECIAL_ACTION
; OFFER struck (labour-market `offered` is a status; giving is expressed via `give`). TAKE and
; WEAR struck: no action declares them.


:TRANS_ACTION
"kills"                             /pres kill                 .
"killed"                            /past kill                 .
"walks to"                          /pres WALK               .
"walked to"                         /past WALK               .
"has sex with"                      /pres HAVE-SEX-WITH         .
"had sex with"                      /past HAVE-SEX-WITH         .


:INTRANS_ACTION
"gives birth"                       /pres GIVE-BIRTH            .
"gave birth"                        /past GIVE-BIRTH            .
"dies"                              /pres DIE                   .
"died"                              /past DIE                   .
