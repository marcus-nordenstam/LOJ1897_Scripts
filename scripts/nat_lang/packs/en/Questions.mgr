.
"do you belong to any club"
( prob { ?_you /pres member-of ? } )
.
"what clubs do you belong to"
( every { ?_you /pres member-of ? } ).target
.
"are you a member of $np(Q_NP)"
( prob { ?_you /pres member-of $np(Q_NP) } )
.

