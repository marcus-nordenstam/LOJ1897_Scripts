"what $verb(VERB|do) $who(Q_NP) do [for a living|]"
( any { $who(Q_NP) /pres job } ).target
.
"what $verb(VERB|be) $who(POSS) #job-noun"
( any { $who(POSS) /pres job } ).target
.
"how $verb(VERB|do) $who(Q_NP) #living-verb $who(POSS) living"
( any { $who(Q_NP) /pres job } ).target
.
"by what #job-noun $verb(VERB|do) $who(Q_NP) #living-verb $who(POSS) living"
( any { $who(Q_NP) /pres job } ).target
.

"who employs $who(Q_NP)"
( o /known { ( any { $who(Q_NP) /pres job } ).target /ever org @o } )
.
"who $verb(VERB|be) $who(POSS) employer"
( o /known { ( any { $who(POSS) /pres job } ).target /ever org @o } )
.
"who $verb(VERB|do) $who(Q_NP) work for"
( o /known { ( any { $who(Q_NP) /pres job } ).target /ever org @o } )
.
"in whose service $verb(VERB|be) $who(Q_NP)"
( o /known { ( any { $who(Q_NP) /pres job } ).target /ever org @o } )
.

"[have you ever had another position|have you worked elsewhere]"
( prob { ?_you /past job ? } )
.
"where did you work before"
( o /known { ( any { ?_you /past job } ).target /ever org @o } )
.

; FLAG: wage ("how much do you earn"), tenure ("how long have you worked
