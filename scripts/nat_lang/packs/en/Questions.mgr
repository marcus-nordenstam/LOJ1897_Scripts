
:QS

; A question put inside a wrapper - "could you tell me what your name is", "do you know who
; this is", "tell me, what is your name" - is the bare question: the wrapper is a word class
; (#ask-wrapper, words.mwrd) and carries nothing into the MC. "do you know X" is answered as
; X is: the answer, "I don't know", or a refusal.
"#ask-wrapper $emb(EMBQ)"
( qs [] $emb(EMBQ) )
.

"#ask-wrapper $qs_phrase(QSP)"
( qs [] $qs_phrase(QSP) )
.

"can you identify $np(Q_NP)"
( qs [] ( any { $np(Q_NP) /pres name } ).target )
.


"$qs_phrase(QSP) ++?"
( qs [] $qs_phrase(QSP) )
.

; Phase 9.5 - PROBE_FOR_DETAIL. The player asks the NPC to elaborate on a
; topic the NPC has just mentioned (the dialogue session's last-salient-noun
; carries the canonical referent). The spec form is a single-word echo
; ("Music?" / "Sports?"), but the matcher's NL preprocessor strips terminal
; '?' so the bare-noun form can't be distinguished from any other kind
; reference at the input layer. v1 ships explicit multi-word triggers
; below; the single-word echo lands when the preprocessor learns to keep
; terminal '?' as a literal token (TODO in nat_lang.cc::_preprocess_nl_input).
; All forms route to (formulaic probe <kind>) which the receiver mind's
; .mc rules pattern-match to drive elaboration.

"more about $probe_word(KIND)"
( qs [] ( formulaic [] probe $probe_word(KIND) ) )
.

"tell me more about $probe_word(KIND)"
( qs [] ( formulaic [] probe $probe_word(KIND) ) )
.

"what about $probe_word(KIND)"
( qs [] ( formulaic [] probe $probe_word(KIND) ) )
.

; Any bare question-phrase asked directly - "what is your name", "who is your
; mother", "what is your age", etc. - with no wrapper and no enclosing parens.
; Wraps the QSP in qs so the SAY ships a question payload, which the hearer's
; converse task answers (rules/tasks/converse-task.mc).
"$qs_phrase(QSP)"
( qs [] $qs_phrase(QSP) )
.


:QSP

; A question is written ONCE for every asker: $who(POSS) is "your" / "my" / "John's" (?_you /
; ?_I / the named person, NounPhrases.mgr), $who(Q_NP) is "you" / "I" / "John". Where the verb
; sets the tense, $verb(VERB|be) / $verb(VERB|do) recovers it from "is" / "was", "do" / "did"
; and the MC says /ever; where the belief's tense is fixed (/pres age, /pres birth-date), the
; verb forms are literal and only the asker folds.

"what $verb(VERB|be) $who(POSS) name"
( any { $who(POSS) /ever name } ).target
.

"who is $who(POSS) $rel(REL)"
( o /known { $who(POSS) /ever $rel(REL) @o } )
.
"who was $who(POSS) $rel(REL)"
( o /known { $who(POSS) /past $rel(REL) @o } )
.

; Plural-relation questions. (every ...) gathers every matching belief; the
; .target post-eval field-lookup maps target-extraction across the result
; list. Three possible answer shapes:
;   []      - no matching belief at all (renders as "unknown")
;   [_]     - explicit {?_you sibling _} belief ("I know I have none")
;   [a b c] - one or more real targets, rendered Oxford-comma style.
; All three flow through utterable_msg's list-recurse and the Oxford-comma
; list printer (see Src/Lib/Mental/Knowledge/List/List.cc).
"who are $who(POSS) $rel_plur(RELP)"
( every { $who(POSS) /ever $rel_plur(RELP) ? } ).target
.
"who were $who(POSS) $rel_plur(RELP)"
( every { $who(POSS) /past $rel_plur(RELP) ? } ).target
.

"where $verb(VERB|do) $who(Q_NP) live"
( any { $who(Q_NP) /ever home } ).target
.

; birth date
"when [was|were] $who(Q_NP) born"
( any { $who(Q_NP) /pres birth-date } ).target
.
"what year [was|were] $who(Q_NP) born"
( any { $who(Q_NP) /pres birth-date } ).target
.

; age - derivative belief, computed on demand from birth-date by
; reasoning/age.mc when (any ...) finds no matching age belief.
"how old $verb(VERB|be) $who(Q_NP)"
( any { $who(Q_NP) /pres age } ).target
.
"what $verb(VERB|be) $who(POSS) age"
( any { $who(POSS) /pres age } ).target
.

; birthplace
"where [was|were] $who(Q_NP) born"
( any { $who(Q_NP) /pres birthplace } ).target
.

; alive / dead
"$verb(VERB|be) $who(Q_NP) alive"
( prob { $who(Q_NP) /pres condition [k alive] } )
.
"$verb(VERB|be) $who(Q_NP) dead"
( prob { $who(Q_NP) /pres condition [k dead] } )
.

; date of death
"when did $person(Q_NP) die"
( any { $person(Q_NP) /pres death-date } ).target
.
"what year did $person(Q_NP) die"
( any { $person(Q_NP) /pres death-date } ).target
.

; whereabouts on the night of a crime - the alibi question. Anchored on the
; victim: death-date is the start of the answerer's {victim condition dead}
; belief; night-of wraps that day to its night window; whereabouts-on returns
; the PLACE of the answerer's most recent placed episode overlapping it (every
; episodic belief carries where he was), else the space of a point stamp. No
; memory -> @unknown ("I don't know") until the routine fallback lands. The
; answerer is ?_you (the suspect being questioned).
"where were you the night $person(Q_NP) [was #kill-verb|died]"
( whereabouts-on ?_you ( night-of ( death-date $person(Q_NP) ) ) )
.

; specific interest (do you like X)
"$verb(VERB|do) $who(Q_NP) like $thing(KIND)"
( prob { $who(Q_NP) /pres interest $thing(KIND) } )
.

; nationality
"what $verb(VERB|be) $who(POSS) nationality"
( any { $who(POSS) /pres nationality } ).target
.
"what nationality $verb(VERB|be) $who(Q_NP)"
( any { $who(Q_NP) /pres nationality } ).target
.
"where $verb(VERB|be) $who(Q_NP) from"
( any { $who(Q_NP) /pres nationality } ).target
.
"where $verb(VERB|do) $who(Q_NP) come from"
( any { $who(Q_NP) /pres nationality } ).target
.

; social class
"what $verb(VERB|be) $who(POSS) social class"
( any { $who(POSS) /pres class-situation } ).target
.
"what [social |] class $verb(VERB|be) $who(Q_NP)"
( any { $who(Q_NP) /pres class-situation } ).target
.
"what social class $verb(VERB|do) $who(Q_NP) belong to"
( any { $who(Q_NP) /pres class-situation } ).target
.
"what social class do you consider yourself part of"
( any { ?_you /pres class-situation } ).target
.

"who $np(Q_NP) is"
( any { $np(Q_NP) /pres name } ).target
.
"who $np(Q_NP) was"
( any { $np(Q_NP) /past name } ).target
.
"who is $np(Q_NP)"
( any { $np(Q_NP) /pres name } ).target
.
"who was $np(Q_NP)"
( any { $np(Q_NP) /past name } ).target
.

"does $sub_np(Q_NP) want $goal(NP)"
( prob { $sub_np(Q_NP) /pres goal $goal(NP) } )
.


; =============================================================================
; DETECTIVE-INTERROGATION QUESTION PACK (questionnaire.txt categories)
; -----------------------------------------------------------------------------
; All entries below are :QSP forms - the top-level "$qs_phrase(QSP)" router
; (above) wraps any of them in (qs ...) so the player's SAY ships a question
; payload, which the hearer's converse task evaluates against his own beliefs.
; Each question carries several surface phrasings, blunt -> eloquent, so the
; same fact can be asked plainly ("what do you do") or formally ("by what
; trade do you make your living"); a synonym is a word-class member
; (words.mwrd), never another line here.
;
; Answer-shape conventions (matching the existing file):
;   ( any { S /pres LABEL } ).target      -> single value (kind / number / obj)
;   ( o /known { S /ever LABEL @o } )      -> single bound object (a person/org)
;   ( every { S /ever LABEL ? } ).target  -> Oxford-comma enumeration
;   ( prob { S /pres LABEL <arg> } )       -> Yes / No  (renders @true/@false)
;   ( none { S /pres LABEL @true } )       -> Yes when NO such belief (alive)
; Subjects: ?_you = the witness answering about themselves; $person(Q_NP) = a
; third party (the victim, a neighbour); answers about others are bounded by
; the believe_about disclosure ceiling - the witness can only answer what it
; actually holds.
;
; NOTE (verify in Talkie): the Yes/No forms use ( prob { ... ? } ) as a
; positive existence test. If prob requires a bound target, swap to whatever
; existence-predicate the engine prefers; the belief shapes are correct.
;
; FLAG lines mark sub-questions whose substrate/func is NOT in place yet
; (durations, arbitrary clock-times, day-of-week, arrest/prison, "why" parse,
; scalar-trait categorisation). They are the truly-new work from the plan.
; =============================================================================


; --- 1. IDENTITY (extends the name/age/birth set already above) --------------

"what $verb(VERB|be) $who(POSS) full name"
( any { $who(POSS) /ever name } ).target
.
"by what name $verb(VERB|be) $who(Q_NP) known"
( any { $who(Q_NP) /ever name } ).target
.
"what $verb(VERB|be) $who(Q_NP) called"
( any { $who(Q_NP) /ever name } ).target
.
"have you ever [gone by|used] another name"
( any { ?_you /past name } ).target
.
"what was your maiden name"
( any { ?_you /past name } ).target
.

; FLAG: religion/denomination has no categorical label (piety is a 0..1
; scalar); worship-venue + {interest religion} are the nearest substrate.
"what $verb(VERB|be) $who(POSS) [religion|faith]"
( prob { $who(POSS) /pres interest [k religion ] } )
.
"what faith $verb(VERB|be) $who(Q_NP)"
( prob { $who(Q_NP) /pres interest [k religion ] } )
.


; --- 1b. MARRIAGE / CHILDREN -------------------------------------------------

"$verb(VERB|be) $who(Q_NP) married"
( prob { $who(Q_NP) /pres spouse ? } )
.
"have you a #spouse-noun"
( prob { ?_you /pres spouse ? } )
.
"were you ever married"
( prob { ?_you /past spouse ? } )
.
"are you a [widow|widower]"
( prob { ?_you /past spouse ? } )
.
"who is $who(POSS) #spouse-noun"
( o /known { $who(POSS) /pres spouse @o } )
.

"$verb(VERB|do) $who(Q_NP) have [any |] children"
( prob { $who(Q_NP) /pres child ? } )
.
"have you [any |] children"
( prob { ?_you /pres child ? } )
.
"are you a [father|mother]"
( prob { ?_you /pres child ? } )
.

; "are they alive" - per-named-person; mirrors the existing alive/dead set.
"is $who(POSS) $rel(REL) [alive|still alive|living]"
( prob { ( o /known { $who(POSS) /ever $rel(REL) @o } ) /pres condition [k alive] } )
.


; --- 3. EDUCATION & TRAINING -------------------------------------------------

"what did you study"
( any { ?_you /ever study ? } ).target
.
"what were you schooled in"
( any { ?_you /ever study ? } ).target
.
"[were you educated|did you have any schooling|did you go to school|were you schooled]"
( prob { ?_you /ever study ? } )
.

"[were you apprenticed|did you serve an apprenticeship]"
( prob { ?_you /ever master ? } )
.
"[who was your master|who taught you your #job-noun|to whom were you apprenticed]"
( o /known { ?_you /ever master @o } )
.

"[what are you skilled in|what is your training|what are your skills]"
( every { ?_you /ever skilled-in ? } ).target
.
"are you skilled in $thing(KIND)"
( prob { ?_you /pres skilled-in $thing(KIND) } )
.

"[did you serve in the army|have you a military record]"
( prob { ?_you /ever serve ? } )
.
"what rank did you hold"
( any { ?_you /ever serve ? } ).target
.

; FLAG: literacy ("can you read") has no dedicated belief; education is a
; 0..1 dimension. Needs a categorical literacy projection or a reading skill.


