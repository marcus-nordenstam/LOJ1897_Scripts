; =============================================================================
; OBJECT-CENTRIC FORMS
; -----------------------------------------------------------------------------
; People ask about the SPECIFIC entity behind a fact - "what church do you
; attend", "what firm employs you", "who is your closest friend" - not just the
; abstract category. These forms return the bound object (a building / org /
; person) via ( any { ... } ).target or ( o /known { ... @o } ).
;
; An inline alternation "[go to|attend]" expands at LOAD time to one row per
; branch, all sharing this meaning; a word class "#firm-noun" expands to none,
; the matcher taking whichever member stands there.
; =============================================================================

; --- Residence / birthplace (object) -----------------------------------------
"#which-det #home-noun do you [live at|reside at|live in]"
( any { ?_you /pres home } ).target
.
"#which-det [town|parish] were you born in"
( any { ?_you /pres birthplace } ).target
.

; --- Profession: the employer ENTITY (org) -----------------------------------
"#which-det #firm-noun [do you work for|employs you]"
( o /known { ( any { ?_you /pres job } ).target /ever org @o } )
.
"[who|what house] does $person(Q_NP) [work for|serve]"
( o /known { ( any { $person(Q_NP) /pres job } ).target /ever org @o } )
.

; --- Social: the specific person -------------------------------------------
"who is $who(POSS) #dear-adj friend"
( o /known { $who(POSS) /pres friend @o } )
.

; --- Romance: the specific person -------------------------------------------
"who are you [courting|sweet on|fond of]"
( o /known { ?_you /pres fancy @o } )
.

; --- Education: the school ENTITY (object) -----------------------------------
; FLAG: the school as an ENTITY is NOT in the substrate - hsim mints
; {pupil study <curriculum>} with the SUBJECT as target and leaves study's
; (aux org) institution slot unset (hse_engine.cc enroll), and there is no
; `.aux` accessor. So this returns @unknown today. To answer it: (1) hsim must
; set study's aux org to the school entity at enroll, and (2) add a `.aux`
; post-eval field accessor (parallel to `.target`/`.label`/`.sub`). The phrasing
; is staged here so it is ready the moment the substrate lands; for now it
; best-effort confirms WHAT was studied, not WHERE.
"#which-det school did you [go to|attend|study at]"
( any { ?_you /ever study ? } ).target
.

; --- More ways to ask the questions above -----------------------------------
"[what do they call you|what do people call you|what name do you go by]"
( any { ?_you /pres name } ).target
.
"[when is your birthday|what is your date of birth]"
( any { ?_you /pres birth-date } ).target
.
"[where is your home|where do you reside|what is your address]"
( any { ?_you /pres home } ).target
.
"what is $who(POSS) #spouse-noun ++'s name"
( any { ( o /known { $who(POSS) /pres spouse @o } ) /pres name } ).target
.


:EMBQ

; A question as it is asked inside another - "tell me what your name is" - or as the
; thing asked for - "tell me your name". The MC is the direct question's.
"[your name|what your name is]"
( any { ?_you /pres name } ).target
.
"[your age|how old you are]"
( any { ?_you /pres age } ).target
.
"[your date of birth|when you were born]"
( any { ?_you /pres birth-date } ).target
.
"where you were born"
( any { ?_you /pres birthplace } ).target
.
"[your address|where you live]"
( any { ?_you /pres home } ).target
.
"[your nationality|where you are from]"
( any { ?_you /pres nationality } ).target
.
"your social class"
( any { ?_you /pres class-situation } ).target
.
"your religion"
( prob { ?_you /pres interest [k religion ] } )
.
"[whether|if] you are married"
( prob { ?_you /pres spouse ? } )
.
"[whether|if] you have children"
( prob { ?_you /pres child ? } )
.
"who your #spouse-noun is"
( o /known { ?_you /pres spouse @o } )
.
"who your $rel(REL) is"
( o /known { ?_you /ever $rel(REL) @o } )
.
"[whether|if] your $rel(REL) is alive"
( prob { ( o /known { ?_you /ever $rel(REL) @o } ) /pres condition [k alive] } )
.
"what you studied"
( any { ?_you /ever study ? } ).target
.
"what you are skilled in"
( every { ?_you /ever skilled-in ? } ).target
.
"[what you do|what your #job-noun is]"
( any { ?_you /pres job } ).target
.
"who employs you"
( o /known { ( any { ?_you /pres job } ).target /ever org @o } )
.
"who owes you money"
( o /known { @o /pres owe ?_you } )
.
"who you trust"
( o /known { ?_you /pres trust @o } )
.
"who your #dear-adj friend is"
( o /known { ?_you /pres friend @o } )
.
"[where you drink|where you take a drink]"
( any { ?_you /pres frequent [k pub-building] ? } ).target
.
"#which-det #pub-noun you #frequent-verb"
( any { ?_you /pres frequent [k pub-building] ? } ).target
.
"[where you worship|where you go to church]"
( any { ?_you /pres frequent [k church-building] ? } ).target
.
"#which-det #church-noun you #attend-verb"
( any { ?_you /pres frequent [k church-building] ? } ).target
.
"where you spend your evenings"
( any { ?_you /pres frequent ? [k evening] } ).target
.
; The identity of the one indicated or named: "do you know who this is", "who John is".
"who this is"
( any { ?_this /pres name } ).target
.
"who this was"
( any { ?_this /past name } ).target
.
"who $np(Q_NP) is"
( any { $np(Q_NP) /pres name } ).target
.
