
:MSG

; A place said on its own, an answer to where, is where he is. These come first: an address bound
; to a plainer template's hole would otherwise be said bare. His own home is "at home", said only
; when its func holds in his mind.
"at home ++, in my $room(KIND)"
( msg [] [address $place room $room(KIND) ] )
:: realize-only when:self-home-room
.

"at home"
( msg [] [address $place room _ ] )
:: realize-only when:self-home
.

"in $where(ADDRESS)"
( msg [] [address $where(ADDRESS) room $room(KIND) ] )
:: realize-only
.

"at $where(ADDRESS)"
( msg [] [address $where(ADDRESS) room _ ] )
:: realize-only
.

; A post said on its own, an answer to what he does: his trade and where - "a clerk at Meridian Bank".
"a $kind(KIND) at $org(NP)"
( msg [] ( o $kind(KIND|/isa|job) { @o org $org(NP) } { @o job-id ? } ) )
:: realize-only
.

; A time reckoned from the meal before it, when he no longer knows the clock exactly: the meal, and the
; clock it puts the time at.
"well ++, it was after my $meal(KIND) ++, so maybe $t(NP) ++?"
( msg [] $t(NP) { ?_I /past eat $meal(KIND) ? } )
:: realize-only
.

"it was after my $meal(KIND) ++, so it must have been around $t(NP)"
( msg [] $t(NP) { ?_I /past eat $meal(KIND) ? } )
:: realize-only terse curt
.

"let me think ++ - I had had my $meal(KIND) ++, so it would have been around $t(NP) ++, I suppose"
( msg [] $t(NP) { ?_I /past eat $meal(KIND) ? } )
:: realize-only elaborated flowery
.

; When a thing began that he never saw begin: that he does not know, and the clock he surely saw it at.
"I don't know ++, but $who(NP) had it on at $t(NP)"
( msg [] @unknown $t(NP) { $who(NP) wear ? ? } )
:: realize-only
.

; Formulaic phrases

"$form(FORM)"
$form(FORM)
.

; Bare kind of thing (e.g. "a beer"); a category ("middle class") is said bare, as a noun phrase.

"$kind(INDEF_KIND|/isa|object)"
( msg [] $kind(INDEF_KIND|/isa|object) )
.

"$things(THING_PLUR)"
( msg [] $things(THING_PLUR) )
:: realize-only
.

; Then non-formulaics:

"$st(ST)"
( msg [] $st(ST) )
.

; A place said on its own - an answer to where - is where a man is: "at the Red Lion".
"at $place(PNAME)"
( msg [] ( o $place(PNAME) $kind(KIND|/isa|building) ) )
:: realize-only
.

"$np(NP)"
( msg [] $np(NP) )
.

; Plural answer payloads (lists of relatives / friends / etc.).
; utterable_msg's list-recurse rephrases each item to descriptor form
; ((o [n X]) for living, (o {@o /past name [n X]}) for deceased), and
; List::print under kPrintNatLang emits them Oxford-comma-joined. NP_PLUR
; consumes that form; this rule wraps it as a (msg ...) payload.
"$np_plur(NP_PLUR)"
( msg [] $np_plur(NP_PLUR) )
.

:CONTEXT

; What frames a question, said before it as a sentence of its own: the line the one asked said
; earlier, in another talk, that the question is about.
"you told me that $fact(ST) ++."
[ quote @you ( msg [] $fact(ST) ) ]
:: realize-only
.

; A ghost read in a document: the document the question is about.
"I have read $doc(NP) ++."
[ doc $doc(NP) ]
:: realize-only
.
