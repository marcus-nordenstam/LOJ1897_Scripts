; -----------------------------------------------------------------------------
; morphology.mmorph - English-pack morphology (Phase 7, plan section 7.1).
;
; Currently scoped to cardinal-number-to-words. compose style = english adds
; hyphens between tens and ones ("twenty-four") and uses "and" between
; hundreds and the residual ("one hundred and twenty-three").
;
; Authored data; mirrors the C++ tables that lived in nat_lang_utils.cc
; before Phase 7. Non-interned and hot-reloadable - editing this file needs
; no .msb regen.
; -----------------------------------------------------------------------------

style: english

; The plural endings the parse strips from an input word to find the kind it names, in
; order: countries -> country, boxes -> box, dogs -> dog. `singular: <suffix> [<replacement>]`.
singular: ies y
singular: es
singular: s
hundred: hundred
; The clitic a template glues on to make a possessor, "John ++'s home": the speaker and the one he
; speaks to say their possessive pronoun in its stead (Pronouns.mgr case:possessive).
possessive: 's

; How the hour is told: the words for a minute of it ({h} the hour on the dial, {n} the next hour,
; {m} the minutes), `past` and `to` for any other minute before and after the half; then the part of
; the day, from the hour it begins (listed in order); and the hours named alone on the hour.
clock-say: 0 {h} o'clock
clock-say: 15 a quarter past {h}
clock-say: 30 half past {h}
clock-say: 45 a quarter to {n}
clock-say: past {m} minutes past {h}
clock-say: to {m} minutes to {n}
clock-part: 0 at night
clock-part: 5 in the morning
clock-part: 12 in the afternoon
clock-part: 17 in the evening
clock-part: 21 at night
clock-name: 0 midnight
clock-name: 12 noon

; Ones
number 0 = zero
number 1 = one
number 2 = two
number 3 = three
number 4 = four
number 5 = five
number 6 = six
number 7 = seven
number 8 = eight
number 9 = nine

; Teens
number 10 = ten
number 11 = eleven
number 12 = twelve
number 13 = thirteen
number 14 = fourteen
number 15 = fifteen
number 16 = sixteen
number 17 = seventeen
number 18 = eighteen
number 19 = nineteen

; Tens (the composer fills 21..29 = "twenty-one".."twenty-nine" etc.)
number 20 = twenty
number 30 = thirty
number 40 = forty
number 50 = fifty
number 60 = sixty
number 70 = seventy
number 80 = eighty
number 90 = ninety
