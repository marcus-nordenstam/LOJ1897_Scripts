(abstract name (name-kind human)
  (child first-name
    (child male-name
      ; A name's (alias ..) are the short forms it goes by: "Tom" is Thomas to every name match,
      ; and no pool ever draws an alias as a man's name.
      (child male-english-name (+ pname)
        (children Arthur Albert Abel Barnaby
                  Bertram Cecil Clarence Cornelius David
                  Donald Edwin Ernest Francis Felix George
                  Harold Harry Henry Herbert Hugh Horace Hubert Humphrey
                  Jack John Jasper Leopold Matthew
                  Maurice Mortimer Oscar Percy Phineas
                  Reginald Rupert Sidney Stephen
                  Thaddeus Vernon Wilbur Wilfred Winthrop)
        (child Alfred (alias Alf))
        (child Archibald (alias Archie))
        (child Bartholomew (alias Bart))
        (child Benjamin (alias Ben))
        (child Charles (alias Charlie))
        (child Christopher (alias Kit))
        (child Daniel (alias Dan Danny))
        (child Edward (alias Ed Ted Ned))
        (child Frederick (alias Fred Freddie))
        (child James (alias Jim Jimmy Jem))
        (child Joseph (alias Joe))
        (child Leonard (alias Len))
        (child Michael (alias Mick))
        (child Nathaniel (alias Nat))
        (child Peter (alias Pete))
        (child Richard (alias Dick Rick))
        (child Robert (alias Rob Bob Bobby))
        (child Samuel (alias Sam))
        (child Thomas (alias Tom Tommy))
        (child Walter (alias Walt Wally))
        (child William (alias Will Bill Billy))))
    (child female-name
      (child female-english-name (+ pname)
        (children Alice Arabella Ada Anna Beatrice
                  Sophia Sophie Clara Doris
                  Edith Emmeline Eliza Eleanor Nora Emily Flora
                  Cecilia Ivy
                  Lillian Louisa Jane Mary Mabel Maggie Martha
                  Minnie Rose Olivia Sarah Violet)
        (child Amelia (alias Millie))
        (child Caroline (alias Carrie))
        (child Catherine (alias Kate Kitty))
        (child Charlotte (alias Lottie))
        (child Constance (alias Connie))
        (child Elizabeth (alias Beth Betsy Bess Lizzie))
        (child Florence (alias Flo Florrie))
        (child Harriet (alias Hattie))
        (child Henrietta (alias Hetty))
        (child Isabella (alias Bella))
        (child Matilda (alias Tilly))
        (child Rebecca (alias Becky))
        (child Susannah (alias Sue Susie))
        (child Victoria (alias Vicky)))))
  (child surname
    (child common-surname
      (child common-english-surname (+ pname)
        (children Adams Abbott Archer Baker Barker Bennett Black Blake
                  Bolton Brooks Bond Booth Brown Burton Carter
                  Chapman Clarke Clark Coleman Cook Cooper Cox Dawson
                  Davis Dixon Ellis Edwards Evans Fisher Foster Green
                  Gardner Gibson Griffiths Harris Harvey Hayes Henderson Higgins
                  Hill Howard Hall Jackson Jenkins Johnson Jones Kemp
                  Lane Lawrence Lee Lloyd Lewis King Mason Matthews
                  Miller Morgan Morris Martin Mitchell Moore Parker Parry
                  Perry Phillips Porter Powell Price Reed Reynolds Richards
                  Robinson Roberts Rogers Russell Scott Shaw Simmons Simpson
                  Spencer Stone Taylor Thompson Turner Walker Watson Webb
                  White Williams Wright)))
    (child upper-class-surname
      (child upper-class-english-surname (+ pname)
        (children Ainsworth Ashford Barrington Beaumont Bedford Bellingham Blakely Cavendish
                  Chatsworth Chesterfield Chetwynd Clarendon Clifton Compton Cantor Darcy
                  Devereux Fairfax Fitzwilliam Grosvenor Harrington Heathcote Langley Lascelles
                  Lovat Mandeville Montague Pembroke Pemberley Radcliffe Ravenscroft Rossetti
                  Rothschild Sandford Somerset Stanhope Talbot Trelawney Wentworth Wetherby
                  Wrotham)))))
