(define-func now-min ()
  (+ (* (time hour) 60) (time minute)))

(define-func work-starts-soon (?start ?end)
  (and (not (hours ?start ?end))
       (> (flip (< (- (* ?start 60) (now-min)) 0)
                (+ (- (* ?start 60) (now-min)) 1440)
                (- (* ?start 60) (now-min))) 0)
       (<= (flip (< (- (* ?start 60) (now-min)) 0)
                 (+ (- (* ?start 60) (now-min)) 1440)
                 (- (* ?start 60) (now-min))) (* (work-lead-hours) 60))))
