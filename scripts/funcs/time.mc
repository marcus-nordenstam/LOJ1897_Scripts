(define-func now-min ()
  (+ /float (* /float (time hour) (minutes_per_hour)) (time minute)))

(define-func work-starts-soon (?start ?end)
  (bind (- (* /float ?start (minutes_per_hour)) (now-min)) ?start-offset)
  (bind (flip (< ?start-offset 0.0)
              (+ ?start-offset (* (hours_per_day) (minutes_per_hour)))
              ?start-offset)
        ?minutes-until-start)
  (and (not (hours ?start ?end))
       (> ?minutes-until-start 0.0)
       (<= ?minutes-until-start (* (work-lead-hours) (minutes_per_hour)))))
