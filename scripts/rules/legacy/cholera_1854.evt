event "cholera_1854" {
    display "Cholera Pandemic of 1854"
    tag pandemic
    schedule pandemic_curve from=1854 to=1856
    magnitude 90
    role "victim" {
        kind=npc alive lower_class age=0..90
        optional
    }
    on_tick {
        kill victim cause=cause_disease
    }
    on_end {
        region_mood_delta region_of=victim plague-fear 0.4
    }
}
