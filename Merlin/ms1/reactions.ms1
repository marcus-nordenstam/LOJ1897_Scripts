; ----------------------------------------------------------------------------
; reactions.ms1 - emotion / appraisal tuning data.
;
; Loaded by Merlin at ontology-load time (appraisal_load_norms, called from
; t_simulator::load_ontology). Editing this file re-tunes the emotion model
; for isim AND hsim - no rebuild, no rule changes. See
; Docs/emotion/emotion_system.md.
;
; The category tests, effect signatures and reaction rows are AUTHORED as
; npc-reflex rules (historical/rules/reflexes/); this file holds only the
; SCALAR TUNING the mint ops and stance/standing passes consume - affects,
; trait gains, signal dims, couplings, mobilisation weights, knobs.
; ----------------------------------------------------------------------------

; ---- global tuning ---------------------------------------------------------
; max-emotion-salience  : hours - ceiling on a compounded emotion's decay
;                         window (a re-appraised grievance bumps salience up
;                         to this cap).
; max-pressure-salience : hours - ceiling on a compounded pressure's decay
;                         window. Pressures run weeks-to-years vs emotion's
;                         hours-to-days; default 8760h = 1 year (plan section
;                         10.3-AFFECT item A).
; mood-salience-gain    : agitation 0 -> emotion salience x1.0; peak agitation
;                         -> x(1 + gain). The event -> emotion -> mood ->
;                         biased-appraisal feedback loop.
(tuning
  /max-emotion-salience   336
  /max-pressure-salience  8760
  /mood-salience-gain     0.5
  ; stance-lr: emotion -> durable-stance learning rate (see
  ; Docs/social/relational_stance.md). Each genuinely-new emotion mint toward a focus PERSON
  ; nudges the appraiser's standing stance scalars by (coupling-weight *
  ; stance-lr), clamped to [-1,1]. Low so a single event is a small step and a
  ; PATTERN of events accumulates into a durable stance.
  /stance-lr              0.2
  ; --- per-simulation-mode default salience (see Docs/memory/memory_system.md) ---
  ; t_event() reads s_default_salience[current_mode] for fresh beliefs.
  ;   isim : 24h post-end recall (one day; matches interactive cadence)
  ;   hsim : 8640h = 12 * 30 * 24 = 12 months at monthly ticks, so a
  ;          default-salience belief survives a year of sim time before
  ;          salience-decay sweeps it.
  /default-salience-isim  24
  /default-salience-hsim  8640)

; ---- emotion affect --------------------------------------------------------
; Per-emotion-kind valence and arousal. derive_mood folds the salience-
; weighted aggregate of these into the contentment / agitation dimensions.
;   valence : -1.0 (negative) .. +1.0 (positive)
;   arousal :  0.0 (calm)      ..  1.0 (activated)
; One row per kind in the Concepts.mon `emotion` taxonomy.
(emotion-affect joy       /valence  1.0 /arousal 0.6)
(emotion-affect pride     /valence  1.0 /arousal 0.5)
(emotion-affect hope      /valence  1.0 /arousal 0.4)
(emotion-affect relief    /valence  1.0 /arousal 0.2)
(emotion-affect gratitude /valence  1.0 /arousal 0.3)
(emotion-affect affection /valence  1.0 /arousal 0.3)
(emotion-affect grief     /valence -1.0 /arousal 0.2)
(emotion-affect distress  /valence -1.0 /arousal 0.7)
(emotion-affect anger     /valence -1.0 /arousal 0.9)
(emotion-affect fear      /valence -1.0 /arousal 0.9)
(emotion-affect shame     /valence -1.0 /arousal 0.4)
(emotion-affect guilt     /valence -1.0 /arousal 0.4)
(emotion-affect envy      /valence -1.0 /arousal 0.6)
(emotion-affect jealousy  /valence -1.0 /arousal 0.7)
(emotion-affect disgust   /valence -1.0 /arousal 0.5)
(emotion-affect contempt  /valence -1.0 /arousal 0.4)
(emotion-affect admiration /valence 1.0 /arousal 0.4)
(emotion-affect longing    /valence 0.7 /arousal 0.6)

; ---- pressure affect -------------------------------------------------------
; Per-pressure-kind contribution to the `stress` mood dimension (plan section
; 10.3-AFFECT item F). Higher /stress = more stress per intensity unit. A
; pressure kind without a row contributes zero stress (so authoring is
; opt-in). stress feeds the inhibition classifier (item D, lowers the
; inhibition floor) and the stress-biased categorize() threshold (item G,
; makes ambiguous events read as wrong / threaten when the appraiser is
; loaded - the paranoid-spiral / simmering-revenge feedback loop).
(pressure-affect humiliation        /stress 0.8)
(pressure-affect existential_threat /stress 1.0)
(pressure-affect exposure_risk      /stress 0.7)
(pressure-affect moral_violation    /stress 0.6)
(pressure-affect injustice          /stress 0.7)
(pressure-affect status_loss        /stress 0.6)
(pressure-affect attachment_loss    /stress 0.7)
(pressure-affect autonomy_loss      /stress 0.5)
(pressure-affect resource_scarcity  /stress 0.6)
(pressure-affect obligation_strain  /stress 0.4)
(pressure-affect rivalry_pressure   /stress 0.5)

; ---- trait affect ----------------------------------------------------------
; How a personality aspect modulates the salience of the emotion / pressure
; kinds it governs. When the appraiser holds <aspect> at value t in [0,1]
; (mean 0.5), the named kind's base salience is scaled by 1 + (deviation *
; gain), where deviation is (t - 0.5) for symmetric Big Five rows and
; max(0, t - 0.5) for one-sided Dark Tetrad rows (plan section 10.3-AFFECT
; item K). Rows multiply when several name the same kind. The aspect is
; read from the appraiser's own {@self <aspect> <f>} self-belief.
;
;   /amplifies <kind>...    kinds this aspect's deviation INCREASES
;   /dampens   <kind>...    kinds this aspect's deviation DECREASES
;                           (alias for /amplifies with negated gain)
;   /gain      <fraction>   swing strength
;   /one_sided              flag (REQUIRED for Dark Tetrad rows): the
;                           trait's effect floors at the population mean
;                           so low values contribute zero, not the
;                           symmetric inverse. Low sadism is "normal
;                           human aversion," not an anti-sadism bonus.
;
; Big Five rows (symmetric - Neuroticism / Extraversion).
(trait-affect volatility /amplifies anger fear distress jealousy /gain 0.8)
(trait-affect withdrawal /amplifies grief fear shame guilt /gain 0.8)
(trait-affect enthusiasm /amplifies joy hope pride gratitude affection relief /gain 0.6)

; Dark Tetrad rows (one-sided - low values contribute zero bias). Plan
; section 10.3-AFFECT item K: narcissism inflates threat-to-ego (humiliation
; pressure, injustice pressure, shame / anger / contempt); psychopathy
; dampens the negative-affect remorse cluster (low fear conditioning, low
; remorse capacity); machiavellianism modulates conduct via inhibition
; classifier and branch-weight composer (no emotion / pressure amplification
; - Machiavellians read accurately, they just do not care); sadism modulates
; via POV-row substitution (handled in apply_construal, not here) and
; inhibition classifier - again no trait-affect emotion bias.
(trait-affect narcissism  /amplifies humiliation injustice shame anger contempt /gain 1.2 /one_sided)
(trait-affect psychopathy /dampens   guilt fear moral_violation /gain 0.6 /one_sided)

; ---- relational-signal dimensions ------------------------------------------
; The per-(mind, object) continuous stance regulators (see signal_dims.h and
; Docs/social/relational_stance.md). Each (signal ...) declares one dimension:
;   /range       signed [-1,1] (warmth-like) or unsigned [0,1] (attraction-like)
;   /retention   per-sleep leak factor (1.0 = never fades)
;   /thresholds  band magnitude cut points, increasing (2 signed, 3 one-sided)
;   /neg /pos    verb-state belief minted per band level (neg: -1,-2; pos: +1..)
; The five stance dims MUST be declared first, in warmth/esteem/trust/attraction/
; dread order (the t_stance_dim enum contract the C++ readers rely on).
(signal warmth     /range signed   /retention 0.938 /thresholds 0.20 0.60      /neg dislike detest   /pos like adore)
(signal esteem     /range signed   /retention 0.938 /thresholds 0.20 0.60      /neg disdain despise  /pos admire revere)
(signal trust      /range signed   /retention 0.938 /thresholds 0.20 0.60      /neg distrust suspect /pos trust rely)
(signal attraction /range unsigned /retention 0.938 /thresholds 0.20 0.60 0.85 /pos fancy desire crave)
(signal dread      /range unsigned /retention 0.99  /thresholds 0.20 0.60 0.85 /pos wary dread terror)

; ---- stance coupling -------------------------------------------------------
; Emotion -> durable relational stance (see Docs/social/relational_stance.md).
; When an emotion is minted toward a focus PERSON, it nudges the appraiser's
; standing stance scalars toward that person. The transient emotion is the
; flow; these nudges are the slow stock (the _stance_by_object leaky integral,
; decayed each sleep). One row per emotion kind that leaves a relational
; residue; weights are in stance-space [-1,1], scaled by stance-lr per
; genuinely-new mint. An unlisted emotion leaves no durable residue.
;   /warmth      affiliation ("do I wish you well")
;   /esteem      evaluation  ("do I look up or down")
;   /trust       reliability ("will you keep faith")
;   /attraction  romantic / sexual pull
(stance-coupling anger      /warmth -0.4 /esteem -0.1 /trust -0.2)
(stance-coupling contempt   /esteem -0.5 /warmth -0.2)
(stance-coupling disgust    /esteem -0.4 /warmth -0.3)
(stance-coupling envy       /esteem -0.3)
(stance-coupling jealousy   /warmth -0.3 /trust -0.2)
(stance-coupling fear       /warmth -0.2 /trust -0.3 /dread 0.6)   ; fear feeds the durable, slow-decay dread stance (whom you fear, for a lifetime)
(stance-coupling gratitude  /warmth  0.4 /trust  0.2)
(stance-coupling affection  /warmth  0.5)
(stance-coupling admiration /esteem  0.5 /warmth  0.2)

; ---- Class II standing comparison ------------------------------------------
; The standing leg of derive_stance pulls stance toward who a known person IS,
; with no triggering event. It reads what the appraiser already knows of the
; target (conduct / class / prestige / wealth learned via believe_about's
; reputation band, plus enemy bonds and the bond graph) and nudges accordingly.
; Runs amortised over known people (centrality-gated, strided, capped).
;
; (standing ...) - cross-cutting weights (magnitudes; direction is in the math):
;   /lr                   overall standing nudge rate (gentle; accumulates)
;   /centrality-gate      only targets with centrality > this (known people)
;   /stride               process 1/stride of targets per tick (amortise)
;   /budget               max targets processed per tick (cap)
;   /caring-base          baseline conduct-judging weight (added to own-virtue)
;   /class-mismatch-warmth / /class-match-warmth   out-group / in-group warmth
;   /rival-warmth / /rival-esteem                  standing rivalry (enemy bond)
;   /envy-esteem / /envy-gap-min                   upward fortune gap -> esteem-
;   /transitive-warmth    a low-warmth target's friend -> warmth- (feud spread)
(standing
  /lr                    0.15
  /centrality-gate       3
  /stride                4
  /budget                4096
  /caring-base           0.4
  /class-mismatch-warmth 0.20
  /class-match-warmth    0.08
  /rival-warmth          0.30
  /rival-esteem          0.15
  /envy-esteem           0.30
  /envy-gap-min          0.15
  /transitive-warmth     0.25
  ; Attraction (Phase 4): mate-value -> the one-sided attraction scalar
  ; (fancy/desire/crave), gated by sex/orientation/age/kin. Looks + status
  ; weights are sex-asymmetric (period-typical). /attr-lr 0 disables the driver.
  /attr-lr               0.40
  /attr-min-age          16
  /attr-looks-male       0.70
  /attr-looks-female     0.35
  /attr-status-male      0.20
  /attr-status-female    0.55
  /attr-agegap-penalty   0.50)

; (conduct-stance <dimension> /esteem f /warmth f /trust f [/vice 1])
; Character / value antipathy. For each known person, the appraiser compares
; their conduct on this axis (a [0,1] dimension belief) to the neutral midpoint,
; scaled by how much the appraiser holds that virtue (judging by one's own
; standard). Weights are positive magnitudes; a `vice` row inverts the level so
; high = condemned. Virtues earn esteem/warmth/trust when high; criminality
; drags all three when high. Trust priors (honesty/criminality -> trust) live
; here too rather than as a separate driver.
(conduct-stance honesty     /esteem 0.25 /warmth 0.10 /trust 0.40)
(conduct-stance piety       /esteem 0.30 /warmth 0.15 /trust 0.05)
(conduct-stance sobriety    /esteem 0.20 /warmth 0.10 /trust 0.10)
(conduct-stance decorum     /esteem 0.25 /warmth 0.20 /trust 0.05)
(conduct-stance criminality /esteem 0.40 /warmth 0.30 /trust 0.50 /vice 1)

; ---- kin / third-party mobilisation ----------------------------------------
; (mobilisation <warmth-verb> <weight>) - how strongly a witnessing third party
; who holds this warmth verb-state (any tense) toward a WRONGED party mobilises a
; pressure to act on their behalf. The scale is kin-mult x this-weight x justice-
; disposition. Declared strongest-warmth first: the first held verb wins, so an
; NPC who both dislikes and adores the victim (any tense) mobilises as an adorer. A
; stranger (no verb held) down-weights to the neutral default (0.30).
(mobilisation adore   1.00)
(mobilisation like     0.70)
(mobilisation dislike  0.12)
(mobilisation detest   0.05)

; ---- category reactions ----------------------------------------------------
; The (reaction <category> /pov ..) rows are RETIRED: reaction doctrine is
; authored as npc-reflex react rules in historical/rules/reflexes/reactions.hs
; (POV by @self position, mints via mint-emotion / mint-pressure / end-bond).
; This file keeps only the TUNING tables the mint ops and stance/standing
; passes consume.
