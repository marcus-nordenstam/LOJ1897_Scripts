
# -----------
# Formulaics
# -----------

:FORM

#"Good day to you"                   ( formulaic opening goodDay @unknown )    .
#"Good day to you, too"              ( formulaic response goodDay @unknown )  .

"How do you do"                     ( formulaic opening how_do @unknown )       .
"How do you do <r>"                 ( formulaic response how_do @unknown )      .

"How do you do, $name(PNAME)"       ( formulaic opening how_do $name(PNAME) )    .
"How do you do, $name(PNAME) <r>"   ( formulaic response how_do $name(PNAME) )  .

#"A moment, if you please; I am engaged in conversation"                        ( formulaic refusal conv busy ) .
"I can't talk right now because $st(ST)"                                        ( formulaic refusal $st(ST) ) .

# Letter envelope lines. "Signed, <name>" carries the AUTHOR, "To <name>" the
# ADDRESSEE - decode (message_codec) resolves @i / @you from these and never
# adopts them as beliefs. $name(PNAME) takes a proper name ([n ...]) or a
# ?var bound to a name-symbol. Case-insensitive via the lowercasing preprocess.
"Signed, $name(PNAME)"                                                          ( formulaic author $name(PNAME) ) .
"To $name(PNAME)"                                                               ( formulaic addressee $name(PNAME) ) .

"No, I don't know"                                                              ( formulaic no_dont_know ) .
"Yes, it's $answer(NP)"                                                         ( formulaic yes_its $answer(NP) ) .
"Yes, this is my $rel(REL) $name(PNAME)"                                        ( formulaic yes_this_is $rel(REL) $name(PNAME) ) .

"..."                                                                           ( formulaic opening player_talk ) .
"Yes?"                                                                          ( formulaic response player_talk ) .

"..."                                                                           ( formulaic leave_taking player_bye ) .




# Leavetaking (initiating)
#"Bye"
"Goodbye"
( formulaic leave_taking bye ) .

# Leavetaking (response)
#"Bye"
#"Goodbye"
