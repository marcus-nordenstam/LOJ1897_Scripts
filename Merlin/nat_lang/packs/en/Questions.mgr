
:QS

"do you know $qs_phrase(QSP)"
( qs /do_you_know $qs_phrase(QSP) )
.

"do you know who this is"
( qs /do_you_know /this ( any { ?_this /pres name } ).target )
.

"do you know who this was"
( qs /do_you_know /this ( any { ?_this /past name } ).target )
.

"can you identify this"
( qs /do_you_know /this ( any { ?_this /pres name } ).target )
.

"can you identify $np(Q_NP)"
( qs /do_you_know ( any { $np(Q_NP) /pres name } ).target )
.

#"right then, what's yer pleasure"
#"what are ye havin'"
"what'll it be then"
( qs ( any { ?_you /pres order ? ?_i } ).target )
.

"'(' $qs_phrase(QSP) ++? ')'"
( qs $qs_phrase(QSP) )
.

# Phase 9.5 - PROBE_FOR_DETAIL. The player asks the NPC to elaborate on a
# topic the NPC has just mentioned (the dialogue session's last-salient-noun
# carries the canonical referent). The spec form is a single-word echo
# ("Music?" / "Sports?"), but the matcher's NL preprocessor strips terminal
# '?' so the bare-noun form can't be distinguished from any other kind
# reference at the input layer. v1 ships explicit multi-word triggers
# below; the single-word echo lands when the preprocessor learns to keep
# terminal '?' as a literal token (TODO in nat_lang.cc::_preprocess_nl_input).
# All forms route to (formulaic probe <kind>) which the receiver mind's
# .ms2 rules pattern-match to drive elaboration.

"more about $probe_word(KIND)"
( qs (formulaic probe $probe_word(KIND)) )
.

"tell me more about $probe_word(KIND)"
( qs (formulaic probe $probe_word(KIND)) )
.

"what about $probe_word(KIND)"
( qs (formulaic probe $probe_word(KIND)) )
.

# Any bare question-phrase asked directly - "what is your name", "who is your
# mother", "what is your age", etc. - with no "do you know" prefix and no
# enclosing parens. Wraps the QSP in qs so the SAY ships a question payload
# (-> compute-answer / tell-answer), not a (msg ...) statement. Without this
# a plain question matched the bare QSP at top level and shipped as a
# statement, which hear-tell's mood gate ignores, so the NPC never answered.
"$qs_phrase(QSP)"
( qs $qs_phrase(QSP) )
.


:QSP

"what is $person(Q_NP) ++'s name"
( any { $person(Q_NP) /pres name } ).target
.
"what was $person(Q_NP) ++'s name"
( any { $person(Q_NP) /past name } ).target
.
"what is your name"
( any { ?_you /pres name } ).target
.
"what was your name"
( any { ?_you /past name } ).target
.
"what is my name"
( any { ?_I /pres name } ).target
.
"what was my name"
( any { ?_I /past name } ).target
.

"who is $person(Q_NP) ++'s $rel(REL)"
( o /known { $person(Q_NP) /ever $rel(REL) @o } )
.
"who was $person(Q_NP) ++'s $rel(REL)"
( o /known { $person(Q_NP) /past $rel(REL) @o } )
.
"who is your $rel(REL)"
( o /known { ?_you /ever $rel(REL) @o } )
.
"who was your $rel(REL)"
( o /known { ?_you /past $rel(REL) @o } )
.
"who is my $rel(REL)"
( o /known { ?_I /ever $rel(REL) @o } )
.
"who was my $rel(REL)"
( o /known { ?_I /past $rel(REL) @o } )
.

# Plural-relation questions. (every ...) gathers every matching belief; the
# .target post-eval field-lookup maps target-extraction across the result
# list. Three possible answer shapes:
#   []      - no matching belief at all (renders as "unknown")
#   [_]     - explicit {?_you sibling _} belief ("I know I have none")
#   [a b c] - one or more real targets, rendered Oxford-comma style.
# All three flow through utterable_msg's list-recurse and the Oxford-comma
# list printer (see Src/Lib/Mental/Knowledge/List/List.cc).
"who are your $rel_plur(RELP)"
( every { ?_you /ever $rel_plur(RELP) ? } ).target
.
"who are my $rel_plur(RELP)"
( every { ?_I /ever $rel_plur(RELP) ? } ).target
.
"who are $person(Q_NP) ++'s $rel_plur(RELP)"
( every { $person(Q_NP) /ever $rel_plur(RELP) ? } ).target
.
"who were your $rel_plur(RELP)"
( every { ?_you /past $rel_plur(RELP) ? } ).target
.
"who were my $rel_plur(RELP)"
( every { ?_I /past $rel_plur(RELP) ? } ).target
.
"who were $person(Q_NP) ++'s $rel_plur(RELP)"
( every { $person(Q_NP) /past $rel_plur(RELP) ? } ).target
.

"where does $person(Q_NP) live"
( any { $person(Q_NP) /pres home } ).target
.
"where did $person(Q_NP) live"
( any { $person(Q_NP) /past home } ).target
.
"where do you live"
( any { ?_you /pres home } ).target
.
"where do I live"
( any { ?_I /pres home } ).target
.

# birth date
"when were you born"
( any { ?_you /pres birth_date } ).target
.
"when was I born"
( any { ?_I /pres birth_date } ).target
.
"when was $person(Q_NP) born"
( any { $person(Q_NP) /pres birth_date } ).target
.
"what year were you born"
( any { ?_you /pres birth_date } ).target
.
"what year was I born"
( any { ?_I /pres birth_date } ).target
.
"what year was $person(Q_NP) born"
( any { $person(Q_NP) /pres birth_date } ).target
.

# age - derivative belief, computed on demand from birth_date by
# reasoning/age.ms2 when (any ...) finds no matching age belief.
"how old are you"
( any { ?_you /pres age } ).target
.
"how old am I"
( any { ?_I /pres age } ).target
.
"how old is $person(Q_NP)"
( any { $person(Q_NP) /pres age } ).target
.
"what is your age"
( any { ?_you /pres age } ).target
.
"what is my age"
( any { ?_I /pres age } ).target
.
"what is $person(Q_NP) ++'s age"
( any { $person(Q_NP) /pres age } ).target
.

# birthplace
"where were you born"
( any { ?_you /pres birthplace } ).target
.
"where was I born"
( any { ?_I /pres birthplace } ).target
.
"where was $person(Q_NP) born"
( any { $person(Q_NP) /pres birthplace } ).target
.

# alive / dead
# `none` returns @true if no matching belief exists, @false if it does.
# So "is X alive" succeeds (Yes) precisely when X has no /pres deceased @true belief.
"is $person(Q_NP) alive"
( none { $person(Q_NP) /pres deceased @true } )
.
"are you alive"
( none { ?_you /pres deceased @true } )
.
"is $person(Q_NP) dead"
( prob { $person(Q_NP) /pres deceased @true } )
.

# date of death
"when did $person(Q_NP) die"
( any { $person(Q_NP) /pres deceased_year } ).target
.
"what year did $person(Q_NP) die"
( any { $person(Q_NP) /pres deceased_year } ).target
.

# whereabouts on the night of a crime - the alibi question. Anchored on the
# victim: death_date is the start of the answerer's {victim condition dead}
# belief; night_of wraps that day to its night window; whereabouts_on returns
# the location memory overlapping it, and .target yields the venue ("the Red
# Lion"). No memory -> @unknown ("I don't know") until the routine fallback
# lands. The answerer is ?_you (the suspect being questioned).
"where were you the night $person(Q_NP) was killed"
( whereabouts_on ?_you ( night_of ( death_date $person(Q_NP) ) ) ).target
.
"where were you the night $person(Q_NP) was murdered"
( whereabouts_on ?_you ( night_of ( death_date $person(Q_NP) ) ) ).target
.
"where were you the night $person(Q_NP) died"
( whereabouts_on ?_you ( night_of ( death_date $person(Q_NP) ) ) ).target
.

# specific interest (do you like X)
"do you like $thing(KIND)"
( prob { ?_you /pres interest $thing(KIND) } )
.
"do I like $thing(KIND)"
( prob { ?_I /pres interest $thing(KIND) } )
.
"does $person(Q_NP) like $thing(KIND)"
( prob { $person(Q_NP) /pres interest $thing(KIND) } )
.

# nationality
"what is your nationality"
( any { ?_you /pres nationality } ).target
.
"what is my nationality"
( any { ?_I /pres nationality } ).target
.
"what is $person(Q_NP) ++'s nationality"
( any { $person(Q_NP) /pres nationality } ).target
.
"what nationality are you"
( any { ?_you /pres nationality } ).target
.
"what nationality am I"
( any { ?_I /pres nationality } ).target
.
"what nationality is $person(Q_NP)"
( any { $person(Q_NP) /pres nationality } ).target
.
"where are you from"
( any { ?_you /pres nationality } ).target
.
"where am I from"
( any { ?_I /pres nationality } ).target
.
"where is $person(Q_NP) from"
( any { $person(Q_NP) /pres nationality } ).target
.

# social class
"what is your social class"
( any { ?_you /pres class_situation } ).target
.
"what is my social class"
( any { ?_I /pres class_situation } ).target
.
"what is $person(Q_NP) ++'s social class"
( any { $person(Q_NP) /pres class_situation } ).target
.
"what social class are you"
( any { ?_you /pres class_situation } ).target
.
"what social class am I"
( any { ?_I /pres class_situation } ).target
.
"what social class is $person(Q_NP)"
( any { $person(Q_NP) /pres class_situation } ).target
.
"what social class do you belong to"
( any { ?_you /pres class_situation } ).target
.
"what social class do I belong to"
( any { ?_I /pres class_situation } ).target
.
"what social class does $person(Q_NP) belong to"
