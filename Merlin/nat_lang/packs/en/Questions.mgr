"does $sub_np(Q_NP) want $goal(NP)"
( prob { $sub_np(Q_NP) /pres goal $goal(NP) } )
.


# =============================================================================
# DETECTIVE-INTERROGATION QUESTION PACK (questionnaire.txt categories)
# -----------------------------------------------------------------------------
# All entries below are :QSP forms - the top-level "$qs_phrase(QSP)" router
# (above) wraps any of them in (qs ...) so mx_player_say ships them as a
# question-payload SAY and compute-answer / tell-answer evaluate them against
# the answerer's own beliefs. Each question carries several surface phrasings, blunt -> eloquent,
# so the same fact can be asked plainly ("what do you do") or formally ("by
# what trade do you make your living").
#
# Answer-shape conventions (matching the existing file):
#   ( any { S /pres LABEL } ).target      -> single value (kind / number / obj)
#   ( o /known { S /ever LABEL @o } )      -> single bound object (a person/org)
#   ( every { S /ever LABEL ? } ).target  -> Oxford-comma enumeration
#   ( prob { S /pres LABEL <arg> } )       -> Yes / No  (renders @true/@false)
#   ( none { S /pres LABEL @true } )       -> Yes when NO such belief (alive)
# Subjects: ?_you = the witness answering about themselves; $person(Q_NP) = a
# third party (the victim, a neighbour); answers about others are bounded by
# the believe_about disclosure ceiling - the witness can only answer what it
# actually holds.
#
# NOTE (verify in Talkie): the Yes/No forms use ( prob { ... ? } ) as a
# positive existence test. If prob requires a bound target, swap to whatever
# existence-predicate the engine prefers; the belief shapes are correct.
#
# # FLAG lines mark sub-questions whose substrate/func is NOT in place yet
# (durations, arbitrary clock-times, day-of-week, arrest/prison, "why" parse,
# scalar-trait categorisation). They are the truly-new work from the plan.
# =============================================================================


# --- 1. IDENTITY (extends the name/age/birth set already above) --------------

"what is your full name"
( any { ?_you /pres name } ).target
.
"by what name are you known"
( any { ?_you /pres name } ).target
.
"what are you called"
( any { ?_you /pres name } ).target
.
"have you ever gone by another name"
( any { ?_you /past name } ).target
.
"have you ever used another name"
( any { ?_you /past name } ).target
.
"what was your maiden name"
( any { ?_you /past name } ).target
.

# # FLAG: religion/denomination has no categorical label (piety is a 0..1
# scalar); worship-venue + {interest religion} are the nearest substrate.
"what is your religion"
( prob { ?_you /pres interest [k religion ] } )
.


