.
"have you a wife"
( prob { ?_you /pres spouse ? } )
.
"have you a husband"
( prob { ?_you /pres spouse ? } )
.
"were you ever married"
( prob { ?_you /past spouse ? } )
.
"are you a widow"
( prob { ?_you /past spouse ? } )
.
"are you a widower"
( prob { ?_you /past spouse ? } )
.
"who is your wife"
( o /known { ?_you /pres spouse @o } )
.
"who is your husband"
( o /known { ?_you /pres spouse @o } )
.
"is $person(Q_NP) married"
( prob { $person(Q_NP) /pres spouse ? } )
.

"do you have children"
( prob { ?_you /pres child ? } )
.
"have you any children"
( prob { ?_you /pres child ? } )
.
"are you a father"
( prob { ?_you /pres child ? } )
.
"are you a mother"
( prob { ?_you /pres child ? } )
.

# "are they alive" - per-named-person; mirrors the existing alive/dead set.
"is your $rel(REL) alive"
( none { ( o /known { ?_you /ever $rel(REL) @o } ) /pres deceased @true } )
.


