
:SPECIAL_ACTION
# OFFER struck (labour-market `offered` is a status; giving is expressed via `give`).
"takes $obj_np(NP) with $gripper_np(NP)"            /pres TAKE $obj_np(NP) $gripper_np(NP)  .
"took $obj_np(NP) with $gripper_np(NP)"             /past TAKE $obj_np(NP) $obj_np(NP)      .
"puts $obj_np(NP) on their $bodypart_np(NP)"        /pres WEAR $obj_np(NP) $bodypart_np(NP) .
"put $obj_np(NP) on their $bodypart_np(NP)"         /pres WEAR $obj_np(NP) $bodypart_np(NP) .


:TRANS_ACTION
"kills"                             /pres kill                 .
"killed"                            /past kill                 .
"walks to"                          /pres WALK_TO               .
"walked to"                         /past WALK_TO               .
"has sex with"                      /pres HAVE-SEX-WITH         .
"had sex with"                      /past HAVE-SEX-WITH         .
"acquires"                          /pres ACQUIRE               .
"acquired"                          /past ACQUIRE               .


:INTRANS_ACTION
"gives birth"                       /pres GIVE_BIRTH            .
"gave birth"                        /past GIVE_BIRTH            .
"dies"                              /pres DIE                   .
"died"                              /past DIE                   .
