# ---------------------------------------------------------------------------

# BEHAVIOURAL INTEREST PROSE - one template per domain kind. A description
# voices an interest as the behaviour it produces ("she haunts the curiosity
# shops"), not as inventory ("she is interested in antiques"). Each entry
# leads with a $verb hole so the surrounding belief's tense carries (a
# deceased subject's interests render in the past); the literal tail after
# the verb must stay non-finite (no "whenever the weather allows" - the baked
# present tense would survive into past renderings). MUST come before the
# generic interested-in templates below - the realize matcher is first-match-
# wins by file order, so a kind-literal entry placed later would lose to the
# variable-kind generic. Untagged = neutral; behavioural variants for the
# warm / curt / elaborated voices are a follow-up. An unauthored future kind
# falls through to the generic "interested in" form.

# academic_field
" $sub_np(NP) $verb(VERB|spend) long hours with the Greek and Latin authors "
{ $sub_np(NP) /ever interest [k classics ] } .
" $sub_np(NP) $verb(VERB|tinker) endlessly with machines and contrivances "
{ $sub_np(NP) /ever interest [k engineering ] } .
" $sub_np(NP) $verb(VERB|read) every medical tract worth the name "
{ $sub_np(NP) /ever interest [k medicine ] } .
" $sub_np(NP) $verb(VERB|follow) the courts closely "
{ $sub_np(NP) /ever interest [k law ] } .
" $sub_np(NP) $verb(VERB|read) deeply in works of divinity "
{ $sub_np(NP) /ever interest [k theology ] } .
" $sub_np(NP) $verb(VERB|keep) a close eye on the markets "
{ $sub_np(NP) /ever interest [k commerce ] } .
" $sub_np(NP) $verb(VERB|collect) specimens of every description "
{ $sub_np(NP) /ever interest [k natural_science ] } .
" $sub_np(NP) $verb(VERB|keep) meticulous ledgers "
{ $sub_np(NP) /ever interest [k accountancy ] } .
" $sub_np(NP) $verb(VERB|pore) over charts and tide-tables "
{ $sub_np(NP) /ever interest [k navigation ] } .
" $sub_np(NP) $verb(VERB|be) happiest among the livestock "
{ $sub_np(NP) /ever interest [k husbandry ] } .
" $sub_np(NP) $verb(VERB|practise) letters and sums of an evening "
{ $sub_np(NP) /ever interest [k primary_school_curriculum ] } .
" $sub_np(NP) $verb(VERB|keep) up with the schoolbooks "
{ $sub_np(NP) /ever interest [k secondary_school_curriculum ] } .
" $sub_np(NP) $verb(VERB|be) a great reader of histories "
{ $sub_np(NP) /ever interest [k history ] } .
" $sub_np(NP) $verb(VERB|attend) the public lectures "
{ $sub_np(NP) /ever interest [k science ] } .

# performance_art
" $sub_np(NP) $verb(VERB|go) to every concert in town "
{ $sub_np(NP) /ever interest [k music ] } .
" $sub_np(NP) $verb(VERB|go) to the theatre at every opportunity "
{ $sub_np(NP) /ever interest [k theatre ] } .
" $sub_np(NP) $verb(VERB|spend) a great deal of time in the library "
{ $sub_np(NP) /ever interest [k literature ] } .

# martial
" $sub_np(NP) $verb(VERB|practise) with pistol and rifle "
{ $sub_np(NP) /ever interest [k marksmanship ] } .
" $sub_np(NP) $verb(VERB|handle) a knife with uncommon familiarity "
{ $sub_np(NP) /ever interest [k knife_fighting ] } .
" $sub_np(NP) $verb(VERB|fence) with anyone willing "
{ $sub_np(NP) /ever interest [k swordsmanship ] } .
" $sub_np(NP) $verb(VERB|follow) the prize-fights "
{ $sub_np(NP) /ever interest [k pugilism ] } .
" $sub_np(NP) $verb(VERB|miss) no wrestling match "
{ $sub_np(NP) /ever interest [k wrestling ] } .
" $sub_np(NP) $verb(VERB|spend) every spare hour on horseback "
{ $sub_np(NP) /ever interest [k horsemanship ] } .
" $sub_np(NP) $verb(VERB|ride) at every opportunity "
{ $sub_np(NP) /ever interest [k riding ] } .

# illicit
" $sub_np(NP) $verb(VERB|know) a great deal about poisons "
{ $sub_np(NP) /ever interest [k poisoning_knowledge ] } .
" $sub_np(NP) $verb(VERB|have) a suspicious talent for imitating another's hand "
{ $sub_np(NP) /ever interest [k forgery ] } .
" $sub_np(NP) $verb(VERB|tinker) with locks "
{ $sub_np(NP) /ever interest [k lockpicking ] } .
" $sub_np(NP) $verb(VERB|be) always climbing something "
{ $sub_np(NP) /ever interest [k climbing ] } .
" $sub_np(NP) $verb(VERB|have) a way of disappearing at convenient moments "
{ $sub_np(NP) /ever interest [k evading ] } .
" $sub_np(NP) $verb(VERB|poke) about in other people's business "
{ $sub_np(NP) /ever interest [k detecting ] } .

# athletics / avocation / devotional / civic
" $sub_np(NP) $verb(VERB|turn) out for every sporting contest "
{ $sub_np(NP) /ever interest [k sports ] } .
" $sub_np(NP) $verb(VERB|haunt) the curiosity shops "
{ $sub_np(NP) /ever interest [k antiques ] } .
" $sub_np(NP) $verb(VERB|be) at church more than most "
{ $sub_np(NP) /ever interest [k religion ] } .
" $sub_np(NP) $verb(VERB|dabble) in table-rapping and spirit circles "
{ $sub_np(NP) /ever interest [k spiritualism ] } .
" $sub_np(NP) $verb(VERB|go) to the suffrage meetings "
{ $sub_np(NP) /ever interest [k suffrage ] } .

# Interest is a kind-valued plural-attr; one belief per interest topic. KIND
# strips the bracket form so [k music] -> "music". The neutral default - kept
# as the fallback the .mph select chain always lands on. $verb(VERB|be) carries
# both tenses (is / was interested in) so a deceased subject's interests render.
# With the behavioural templates above, this generic form fires only for
# unauthored kinds, for the aggregated interest_description list, and for the
# parse direction.
" $sub_np(NP) $verb(VERB|be) interested in $kind(KIND|/isa|domain) "
{ $sub_np(NP) /ever interest $kind(KIND|/isa|domain) } .

# Warm - the speaker holds the subject in regard. "Fond of" softens the bare
# fact into approval; the interest becomes something the subject is loved for.
" $sub_np(NP) is fond of $kind(KIND|/isa|domain) "
{ $sub_np(NP) /pres interest $kind(KIND|/isa|domain) }
:: warm
.

# Flowery - the .mph escalates warm to flowery when cog:sensory holds.
# A figurative, romantic-narrator reach: not an interest, but a passion.
" $sub_np(NP) has a great love of $kind(KIND|/isa|domain) "
{ $sub_np(NP) /pres interest $kind(KIND|/isa|domain) }
:: flowery
.

# Elaborated - the schooled voice. "Takes a serious interest in" frames the
# interest as a considered pursuit rather than a bare preference. Picked by
# the .mph interest select when schooling:high holds.
" $sub_np(NP) takes a serious interest in $kind(KIND|/isa|domain) "
{ $sub_np(NP) /pres interest $kind(KIND|/isa|domain) }
:: elaborated
.

# Curt - the speaker resents the subject. Dismissive bare-acknowledgement form
# - "cares for" said with a shrug, the way the disapproving narrator concedes
# a fact they don't think much of.
" $sub_np(NP) cares for $kind(KIND|/isa|domain) "
{ $sub_np(NP) /pres interest $kind(KIND|/isa|domain) }
:: curt
.


# POSSESSIVE RELATIONS EXPRESSED IN THE PASSIVE FORM
# e.g. john's mother is/was...

# First-person possessive with any attribute (my X is Y)
# e.g. my game-role is npc, my mother is $mother
" $my(PRONOUN) $rel(REL) $verb(VERB|be) $value(NP) "
{ $my(PRONOUN) /ever $rel(REL) $value(NP) }
.

# Affectionate variant - the sentence planner picks this when the speaker's
# regard toward the subject (the $value here) is `loves` or the slot's intent
# preference is `warm`. The MC belief shape is identical to the neutral form,
# so parsing accepts either; only the generation choice differs.
" $my(PRONOUN) dear $rel(REL) is $value(NP) "
{ $my(PRONOUN) /pres $rel(REL) $value(NP) }
:: warm
.

# Curt variant - "Mary, my mother" - drops the copula. The literal comma is
# tokenised as its own NL token; the bind-tokens ("++,") would only matter for
# generation glue, and on parse the matcher walks tokens left-to-right.
" $value(NP) ++, $my(PRONOUN) $rel(REL) "
{ $my(PRONOUN) /pres $rel(REL) $value(NP) }
:: curt
.


# any possessive relation that is a proper name, e.g. john's name is ...
# Uses PNAME for the value so proper names get [n ...] wrapper
" $sub_np(NP) ++'s $pname_rel(PASSIVE_PNAME_REL) $pname(PNAME)"
{ $sub_np(NP)      $pname_rel(PASSIVE_PNAME_REL) $pname(PNAME) } .

# any possessive relation that is a number, e.g. john's age is 20
" $sub_np(NP) ++'s $num_rel(PASSIVE_NUM_REL) $num(NUM)"
{ $sub_np(NP)      $num_rel(PASSIVE_NUM_REL) $num(NUM) } .

# any possessive PLURAL relation that is a noun-phrase, e.g. john's friends are sam and mary
" $sub_np(NP) ++'s $passive_rel(PASSIVE_REL_PLUR) $conj(CONJ) "
{ $sub_np(NP)      $passive_rel(PASSIVE_REL_PLUR) $conj(CONJ) }
.

# any possessive relation that is a noun-phrase, e.g. john's friend is a big red pig
" $sub_np(NP) ++'s $passive_rel(PASSIVE_REL) $np(NP) "
{ $sub_np(NP)      $passive_rel(PASSIVE_REL) $np(NP) }
.

# any possessive relation involving 'this', e.g. this is/was john's friend
"this is $sub_np(NP) ++'s $rel(REL)"
{ $sub_np(NP) /pres $rel(REL) ( this ) }
.
"this was $sub_np(NP) ++'s $rel(REL)"
{ $sub_np(NP) /past $rel(REL) ( this ) }
.

# extended to include the name, e.g. this is john's friend sam
"this is $sub_np(NP) ++'s $rel(REL) $pname(PNAME)"
{ $sub_np(NP) /pres $rel(REL) ( this $pname(PNAME) ) }
.
"this was $sub_np(NP) ++'s $rel(REL) $pname(PNAME)"
{ $sub_np(NP) /past $rel(REL) ( this $pname(PNAME) ) }
.


# POSSESSIVE RELATIONS EXPRESSED AS VERBS (ACTIVE relations)
# e.g. john lives/lived at ... (instead of the passive john's home is/was)

" $sub_np(NP)  $active_rel(ACTIVE_REL)  $obj_np(NP) "
{ $sub_np(NP)  $active_rel(ACTIVE_REL)  $obj_np(NP) }
.


# SPEECH ACTIONS
# SAY is the ONE verbal action label - the payload func discriminates the
# mood ($msg = statement, $qs = question).

" $sub_np(NP) says ++:   $msg(MSG) to $obj_np(NP)"
{ $sub_np(NP) /pres SAY $msg(MSG)    $obj_np(NP) }
.
" $sub_np(NP) said ++:   $msg(MSG) to $obj_np(NP)"
{ $sub_np(NP) /past SAY $msg(MSG)    $obj_np(NP) }
.

" $sub_np(NP) says ++:   $qs(QS) to $obj_np(NP)"
{ $sub_np(NP) /pres SAY $qs(QS)    $obj_np(NP) }
.
" $sub_np(NP) said ++:   $qs(QS) to $obj_np(NP)"
{ $sub_np(NP) /past SAY $qs(QS)    $obj_np(NP) }
.

# SPEECH TASKS

" $sub_np(NP) tells      $obj_np(NP) ++: $msg(MSG)"
{ $sub_np(NP) /pres tell $msg(MSG)       $obj_np(NP) }
.
" $sub_np(NP) told       $obj_np(NP) ++: $msg(MSG)"
{ $sub_np(NP) /past tell $msg(MSG)       $obj_np(NP) }
.

" $sub_np(NP) asks      $obj_np(NP) ++: $qs(QS)"
{ $sub_np(NP) /pres ask $qs(QS)         $obj_np(NP) }
.
" $sub_np(NP) asked     $obj_np(NP) ++: $qs(QS)"
{ $sub_np(NP) /past ask $qs(QS)         $obj_np(NP) }
.


#
# Reported speech
#
# Reported speech is translated in a two-step process; we separately translate the message (appearing here as '_')
# followed by translating the actual speaking event.  We do this because the speaker/recipient pronouns in the 
# message may not match those of the speaking event.  For example, in "John said 'you are mean' to me", 'you' in the
# message refers to 'me' in the speaking event.
#
#"$speaker(NP) said to $recipient(NP) ++: '_'"
#{ $speaker(NP) UTTER _ $recipient(NP) /past }
#.

# ACTION-SENTENCES

" $sub_np(NP) $action(SPECIAL_ACTION)"
{ $sub_np(NP) $action(SPECIAL_ACTION) }
.
" $sub_np(NP) $action(TRANS_ACTION) $obj_np(NP)"
{ $sub_np(NP) $action(TRANS_ACTION) $obj_np(NP) }
.
" $sub_np(NP) $action(INTRANS_ACTION)"
{ $sub_np(NP) $action(INTRANS_ACTION) }
.

# TASK-SENTENCES

" $sub_np(NP) $task(SPECIAL_TASK)"
{ $sub_np(NP) $task(SPECIAL_TASK) }
.
" $sub_np(NP) $task(TRANS_TASK) $obj(CONJ|ST|QS|MSG|NP)"
{ $sub_np(NP) $task(TRANS_TASK) $obj(CONJ|ST|QS|MSG|NP) }
.
" $sub_np(NP) $task(INTRANS_TASK)"
{ $sub_np(NP) $task(INTRANS_TASK) }
.

# STATE-SENTENCES

" $sub_np(NP) $state(SPECIAL_STATE) "
{ $sub_np(NP) $state(SPECIAL_STATE) }
.

" $sub_np(NP) $state(STATE) $obj(ST|QS|MSG|NP) "
{ $sub_np(NP) $state(STATE) $obj(ST|QS|MSG|NP) }
.


# =============================================================================
# DETECTIVE-INTERROGATION RESPONSE GRAMMAR (questionnaire.txt)
# -----------------------------------------------------------------------------
# Full-sentence renderings for the belief labels surfaced by the new
# Questions.mgr detective pack. The direct-answer path returns a bare value
# (".target") and renders it as a noun phrase ("A physician.", "At the Red
# Lion."); these templates give the FULL-SENTENCE form used when the NPC
# volunteers the fact, when a person_description voices it, and for the parse
# direction. Each names its specific label (no generic-state poaching), mirrors
# the existing job / nationality / home shapes above, and uses /ever so a
# deceased subject's history still renders. Placed at end-of-file so first-
# match-wins by file order never lets these outsort an earlier template.
# =============================================================================

# --- EMPLOYER (org-valued; distinct from the job-kind templates above) -------
" $sub_np(NP) $verb(VERB|work) for $value(NP) "
{ $sub_np(NP) /ever employer $value(NP) } .
" $sub_np(NP) is employed by $value(NP) "
{ $sub_np(NP) /pres employer $value(NP) }
:: elaborated
.
" $sub_np(NP) is in the service of $value(NP) "
{ $sub_np(NP) /pres employer $value(NP) }
:: flowery
.

# --- MEMBER_OF (clubs / societies) -------------------------------------------
" $sub_np(NP) belongs to $value(NP) "
{ $sub_np(NP) /ever member_of $value(NP) } .
" $sub_np(NP) is a member of $value(NP) "
{ $sub_np(NP) /pres member_of $value(NP) }
:: elaborated
.

# --- STUDY (academic_field) --------------------------------------------------
" $sub_np(NP) studied $kind(KIND|/isa|academic_field) "
{ $sub_np(NP) /past study $kind(KIND|/isa|academic_field) } .
" $sub_np(NP) studies $kind(KIND|/isa|academic_field) "
{ $sub_np(NP) /pres study $kind(KIND|/isa|academic_field) } .

# --- MASTER (apprenticeship) -------------------------------------------------
" $sub_np(NP) was apprenticed to $value(NP) "
{ $sub_np(NP) /past master $value(NP) } .
" $sub_np(NP) ++'s master is $value(NP) "
{ $sub_np(NP) /pres master $value(NP) } .

# --- SKILLED_IN (domain) -----------------------------------------------------
" $sub_np(NP) $verb(VERB|be) skilled in $kind(KIND|/isa|domain) "
{ $sub_np(NP) /ever skilled_in $kind(KIND|/isa|domain) } .

# --- SERVED (military_rank) --------------------------------------------------
" $sub_np(NP) served as a $kind(KIND|/isa|military_rank) "
{ $sub_np(NP) /past served $kind(KIND|/isa|military_rank) } .

# --- REPUTE (repute band; distinct surface from class/isa) -------------------
" $sub_np(NP) ++'s reputation is $kind(KIND|/isa|repute) "
{ $sub_np(NP) /ever repute $kind(KIND|/isa|repute) } .
" $sub_np(NP) $verb(VERB|be) considered $kind(KIND|/isa|repute) "
{ $sub_np(NP) /ever repute $kind(KIND|/isa|repute) }
:: elaborated
.

# --- OWE (creditor; debt as a standing relation) -----------------------------
" $sub_np(NP) owes money to $value(NP) "
{ $sub_np(NP) /pres owe $value(NP) } .
" $sub_np(NP) owed money to $value(NP) "
{ $sub_np(NP) /past owe $value(NP) } .
" $sub_np(NP) is in debt to $value(NP) "
{ $sub_np(NP) /pres owe $value(NP) }
:: curt
.

# --- STANCE VERBS (trust / distrust / suspect) -------------------------------
# Yes/No answers render without these; the statement forms are for volunteering
# ("I suspect Mr Hale") and the parse direction.
" $sub_np(NP) trusts $value(NP) "
{ $sub_np(NP) /pres trust $value(NP) } .
" $sub_np(NP) distrusts $value(NP) "
{ $sub_np(NP) /pres distrust $value(NP) } .
" $sub_np(NP) suspects $value(NP) "
{ $sub_np(NP) /pres suspect $value(NP) } .
" $sub_np(NP) admires $value(NP) "
{ $sub_np(NP) /pres admire $value(NP) } .
" $sub_np(NP) despises $value(NP) "
{ $sub_np(NP) /pres despise $value(NP) } .
" $sub_np(NP) relies on $value(NP) "
{ $sub_np(NP) /pres rely $value(NP) } .