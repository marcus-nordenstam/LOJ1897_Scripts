# Birthplace / home are object-valued; same possessive shape.
" $sub_np(NP) ++'s birthplace is $value(NP) "
{ $sub_np(NP) /pres birthplace $value(NP) } .
" $sub_np(NP) ++'s home is $value(NP) "
{ $sub_np(NP) /pres home $value(NP) } .

# ---------------------------------------------------------------------------
# REGARD-SLOT CLAUSES - love and emotion beliefs.
# ---------------------------------------------------------------------------
# The .mph person_description schema's `regard` slot is filled by {X love Y}
# and {X emotion <kind> <focus>} beliefs (see discourse_planner.cc's slot_for_label).
# Several intent-tagged variants per shape: the .mph regard select walks
# warm -> flowery -> blunt -> curt -> deferential -> neutral, falling through
# until a template carrying the chosen intent exists for the belief.
#
# Belief shapes:
#   { X /pres love Y }                     - 3 args, Y is a human object.
#   { X /pres emotion [k <kind>] }         - 3 args, ambient (no focus, aux=_).
#   { X /pres emotion [k <kind>] Y }       - 4 args, Y is what the feeling is
#                                            about (the focus, in aux slot).
#
# All variants share their belief shape with the neutral fallback - parsing
# any of the surface forms recovers the same MC.

# --- LOVE (relationship) ----------------------------------------------------

# Neutral - the unmarked statement of love. The .mph fallback chain always
# ends here, so EVERY love belief renders even when no intent matches.
" $sub_np(NP) $verb(VERB|love) $value(NP) "
{ $sub_np(NP) /ever love $value(NP) } .

# Warm - the affectionate narrator's gloss. "Loves dearly" tags the love
# with the speaker's own approval; the warmest non-flowery reading.
" $sub_np(NP) loves $value(NP) dearly "
{ $sub_np(NP) /pres love $value(NP) }
:: warm
.

# Flowery - the romantic-narrator's grand register. The figurative reach a
# sensory speaker takes when describing someone they themselves love.
" $sub_np(NP) holds $value(NP) dear above all the world "
{ $sub_np(NP) /pres love $value(NP) }
:: flowery
.

# Elaborated - the schooled voice. Periphrastic, slightly formal, the way a
# well-read speaker glosses an affection without quite reaching for the
# romantic. Picked by the .mph regard select when schooling:high holds.
" $sub_np(NP) bears a deep and abiding affection for $value(NP) "
{ $sub_np(NP) /pres love $value(NP) }
:: elaborated
.

# Blunt - the matter-of-fact recital, no varnish. Picked when the speaker
# resents the subject and grudgingly reports the bond as fact.
" $sub_np(NP) dotes on $value(NP) "
{ $sub_np(NP) /pres love $value(NP) }
:: blunt
.

# Curt - the dismissive aside, half-shrugged. "Carries a torch for" carries
# the faint disapproval a brisk gossip puts on someone else's attachment.
" $sub_np(NP) carries a torch for $value(NP) "
{ $sub_np(NP) /pres love $value(NP) }
:: curt
.

# Deferential - cautious, formal, "given to understand". Picked when the
# speaker fears the subject and reports the bond at a respectful remove.
" $sub_np(NP) is given to a deep regard for $value(NP) "
{ $sub_np(NP) /pres love $value(NP) }
:: deferential
.


# --- EMOTION : AFFECTION (object focus) ------------------------------------
" $sub_np(NP) is fond of $value(NP) "
{ $sub_np(NP) /pres emotion [k affection ] $value(NP) } .
" $sub_np(NP) feels great tenderness toward $value(NP) "
{ $sub_np(NP) /pres emotion [k affection ] $value(NP) }
:: warm flowery
.
" $sub_np(NP) thinks well enough of $value(NP) "
{ $sub_np(NP) /pres emotion [k affection ] $value(NP) }
:: curt
.

# --- EMOTION : JOY ---------------------------------------------------------
" $sub_np(NP) delights in $value(NP) "
{ $sub_np(NP) /pres emotion [k joy ] $value(NP) } .
" $sub_np(NP) takes the greatest joy in $value(NP) "
{ $sub_np(NP) /pres emotion [k joy ] $value(NP) }
:: warm flowery
.
" $sub_np(NP) likes $value(NP) well enough "
{ $sub_np(NP) /pres emotion [k joy ] $value(NP) }
:: curt
.
" $sub_np(NP) is glad "
{ $sub_np(NP) /pres emotion [k joy ] } .

# --- EMOTION : PRIDE -------------------------------------------------------
" $sub_np(NP) is proud of $value(NP) "
{ $sub_np(NP) /pres emotion [k pride ] $value(NP) } .
" $sub_np(NP) takes a great pride in $value(NP) "
{ $sub_np(NP) /pres emotion [k pride ] $value(NP) }
:: warm flowery
.
" $sub_np(NP) thinks highly of himself for $value(NP) "
{ $sub_np(NP) /pres emotion [k pride ] $value(NP) }
:: blunt
.

# --- EMOTION : GRIEF -------------------------------------------------------
" $sub_np(NP) grieves for $value(NP) "
{ $sub_np(NP) /pres emotion [k grief ] $value(NP) } .
" $sub_np(NP) is heartbroken over $value(NP) "
{ $sub_np(NP) /pres emotion [k grief ] $value(NP) }
:: flowery
.
" $sub_np(NP) bears a great sorrow for $value(NP) "
{ $sub_np(NP) /pres emotion [k grief ] $value(NP) }
:: deferential
.
" $sub_np(NP) hasn't gotten over $value(NP) "
{ $sub_np(NP) /pres emotion [k grief ] $value(NP) }
:: curt
.
" $sub_np(NP) is sad "
{ $sub_np(NP) /pres emotion [k grief ] } .

# --- EMOTION : ANGER (the "resents" reading) ------------------------------
" $sub_np(NP) is angry at $value(NP) "
{ $sub_np(NP) /pres emotion [k anger ] $value(NP) } .
" $sub_np(NP) cannot abide $value(NP) "
{ $sub_np(NP) /pres emotion [k anger ] $value(NP) }
:: blunt
.
" $sub_np(NP) has no patience for $value(NP) "
{ $sub_np(NP) /pres emotion [k anger ] $value(NP) }
:: curt
.
" $sub_np(NP) bears a long-standing grievance against $value(NP) "
{ $sub_np(NP) /pres emotion [k anger ] $value(NP) }
:: flowery
.
" $sub_np(NP) is angry "
{ $sub_np(NP) /pres emotion [k anger ] } .

# --- EMOTION : FEAR --------------------------------------------------------
" $sub_np(NP) is afraid of $value(NP) "
{ $sub_np(NP) /pres emotion [k fear ] $value(NP) } .
" $sub_np(NP) lives in great dread of $value(NP) "
{ $sub_np(NP) /pres emotion [k fear ] $value(NP) }
:: flowery
.
" $sub_np(NP) holds $value(NP) in awe and apprehension "
{ $sub_np(NP) /pres emotion [k fear ] $value(NP) }
:: deferential
.
" $sub_np(NP) gives $value(NP) a wide berth "
{ $sub_np(NP) /pres emotion [k fear ] $value(NP) }
:: curt
.
" $sub_np(NP) is afraid "
{ $sub_np(NP) /pres emotion [k fear ] } .

# --- EMOTION : SHAME -------------------------------------------------------
" $sub_np(NP) is ashamed of $value(NP) "
{ $sub_np(NP) /pres emotion [k shame ] $value(NP) } .
" $sub_np(NP) bears a deep shame over $value(NP) "
{ $sub_np(NP) /pres emotion [k shame ] $value(NP) }
:: deferential flowery
.
" $sub_np(NP) is not proud of $value(NP) "
{ $sub_np(NP) /pres emotion [k shame ] $value(NP) }
:: curt
.

# --- EMOTION : GUILT -------------------------------------------------------
" $sub_np(NP) feels guilty about $value(NP) "
{ $sub_np(NP) /pres emotion [k guilt ] $value(NP) } .
" $sub_np(NP) cannot forgive himself for $value(NP) "
{ $sub_np(NP) /pres emotion [k guilt ] $value(NP) }
:: flowery deferential
.
" $sub_np(NP) carries a weight over $value(NP) "
{ $sub_np(NP) /pres emotion [k guilt ] $value(NP) }
:: warm
.

# --- EMOTION : ENVY --------------------------------------------------------
" $sub_np(NP) envies $value(NP) "
{ $sub_np(NP) /pres emotion [k envy ] $value(NP) } .
" $sub_np(NP) cannot help but envy $value(NP) "
{ $sub_np(NP) /pres emotion [k envy ] $value(NP) }
:: blunt
.
" $sub_np(NP) covets what $value(NP) has "
{ $sub_np(NP) /pres emotion [k envy ] $value(NP) }
