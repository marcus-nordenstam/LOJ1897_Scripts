action = REACH_FOR
sided = true
action_side_field = aux
left_motor  = left_arm
right_motor = right_arm
transmission = obs

proc_anim = reachfor

preroll = 0.0
in      = 1
run     = 0.1
out     = 1

# Effect-only bounded action: run_func is a no-op. The reach is "successful"
