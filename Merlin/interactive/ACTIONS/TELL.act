action = TELL
motor = mouth
transmission = listen
uninterruptable = true
sub = @msgAuthor
tar = @msg @excl @S
aux = @msgAudience

belief_timeout = 5

proc_anim = tell
state = telling

preroll = 0.0
in      = 0.1
run     = 1.0
out     = 0.1

# TELL's run-duration is a per-utterance value computed in in_func from the
# viseme stream (presented) or kTellUnpresentedDurationS (unpresented). The
# 1.0 here is a placeholder default the binding falls back to if in_func
# fails to compute a duration. Commit success at the cap - run_func is a
# no-op, so the only natural completion is "the bounded duration elapsed".
anim_timeout_mode = success
