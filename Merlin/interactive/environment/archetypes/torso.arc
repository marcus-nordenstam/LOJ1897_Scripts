# PR-evi-A 2026-05-25 - one torso per human; capacity scales with human_npc
# cap (4096). The default wound-site for perpetration method rows whose
# :wound-site slot is omitted (stab / shoot / beating land on the torso).
archetype "torso" (cap 4096) (mech obs) (non-occluder)
{
    "struct_parent"
    "obb"
    "wounds"
    "stains"
    "marks"
}
