{/prop @self TAKE ?thing ?freeHand}: ?TAKE
{?freeHand isa [k left_hand]}
    ->
(penalize ?TAKE 1).

rule 
{/prop @self TAKE ?thing ?freeHand}: ?TAKE
    ->
(penalize ?TAKE (distance @self ?thing)).
