

rule get-maintain-within_reach_of-proposal
{@self get ?thing}
    ->
(maintain_proposal {@self keep_near_and_facing ?thing} (des abs_util 1000)).

rule get-take-proposal
{@self get ?thing}
{?thing obb !@unknown}
{@self within_reach_of ?thing}
{@self facing ?thing}
(realis ?thing)
    ->
(maintain_proposal {@self take ?thing}).


# Base the activity's outcome on the corresponding take task's outcome
rule get-outcome
{@self /ever get ?thing /no_out}: ?get
{@self /past take ?thing /caused_by ~?get}: ?take
    ->
(set_outcome ?get (outcome ?take)).

/*
