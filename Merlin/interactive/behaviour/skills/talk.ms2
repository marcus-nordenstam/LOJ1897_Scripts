
# talk.ms2 - Proximity-based SAY with bb_public_maintain coordination.
#
# SAY is the ONE verbal action label: the mood lives in the payload func -
# (msg ...) states, (qs ...) asks.
#
# Conversations arise naturally from the interplay of bb_public_maintain signals and cell claims:
#   - If you want to SAY something to someone, maintain a signal and claim a cell near them.
#   - If someone signals they want to talk to you, claim your current cell and stay put.
#   - If neither party maintains the signal for 3 seconds, everything auto-releases.
#
# The SAY action system handles one speech act at a time (lock_rule talk...).
# Multiple concurrent conversations are allowed - the lock only serializes the
# physical act of speaking.

# copy <override_talk_cell ?old_cell ?new_cell ?person>
#    (bb_public_read @self talk_cell) = ?old_cell
#    (if (neq ?old_cell ?preempted_talk_cell) (unclaim_env_cell ?old_cell))
#    (bb_public_maintain @self try_to_talk_to ?person 30)
#    (bb_public_write @self talk_cell ?preempted_talk_cell)
#    (bb_public_clear @self preempted_talk_cell)
#    (maintain_attention ?person).

# ------------------------------------------------------------------------------------------------
# Wanting to talk to someone
# ------------------------------------------------------------------------------------------------

# If I want to say some message to someone, I want to talk to them
rule talk-to-goal
{@self goal {@self SAY ? ?person}}
    ->
(maintain_goal {@self talk_to ?person}).

# If you want to talk to someone, signal that to them
rule talk-signal-try-to-talk
{@self goal {@self talk_to ?person}}
    ->
(bb_public_maintain @self try_to_talk_to ?person 10).

# ------------------------------------------------------------------------------------------------
# Determining the 'talk cell', e.g. the cell from which you will hold your end of the conversation
# ------------------------------------------------------------------------------------------------

# If the talk-cell-constraint changes (e.g. a new conversation partner or something)
# then force a re-trigger of the two rules below to find a new/better talking cell
rule talk-force-revaluate-talk-cell-rules
(bb_private_changed @self talk_cell_constraint)
(bb_public_read @self talk_cell): ?old_cell # but don't do this unless we have an old talk-cell to clear...
    ->
(unclaim_env_cell ?old_cell)
(bb_public_clear @self talk_cell).

# If someone wants to talk to me and I am unprepared to talk to (e.g. I don't have a talk-cell for them)
# then claim a talk cell near their talk cell so we can talk
rule talk-recipient-claim-talk-cell
(bb_public_none @self talk_cell)
(bb_public_any ? try_to_talk_to @self /output_subject): ?person
# I could gate the rest of this rule on NOT being in talk-range..
(bb_public_read ?person talk_cell): ?their_talk_cell
# using = so condition succeeds regardless if bb_private_read returns @fail
(bb_private_read @self talk_cell_constraint) = ?constraint_des
(if ?constraint_des
    (claim_env_cell ?constraint_des)
    (claim_env_cell (des in_talk_range_of ?their_talk_cell))): ?my_talk_cell
 # Note the use of CONTINUOUS response to guarantee that a new talk_cell is written, even if
 # the logic above ends up claiming the same talk-cell as was claimed last time conditions evaluated
    -> /cont
(maintain_goal {@self talk_to ?person})
(bb_public_write @self talk_cell ?my_talk_cell)
(maintain_attention ?person).

# The rule that sets the goal to talk typically will also
# set the talk-cell, but if not, this is the general catch-call
rule talk-claim-talk-cell
{@self goal {@self talk_to ?person}}
(bb_public_none @self talk_cell)
# using = so condition succeeds regardless if bb_private_read returns @fail
(bb_private_read @self talk_cell_constraint) = ?constraint_des
(if ?constraint_des
    (claim_env_cell ?constraint_des)
    (claim_env_cell (des in_talk_range_of ?person))): ?talk_cell
(lock_rule talk 0)
 # Note the use of CONTINUOUS response to guarantee that a new talk_cell is written, even if
 # the logic above ends up claiming the same talk-cell as was claimed last time conditions evaluated
    -> /cont
(bb_public_write @self talk_cell ?talk_cell)
(maintain_attention ?person).

# The rendezvous initiator (claim_rendezvous) writes each party's reserved seat
# straight to their talk_cell and seeds the initiator's try_to_talk_to. A
# recipient holds the talk_cell it was given and acts on it once its own
# behaviour sets a {@self talk_to ?person} goal (see talk-go-to-talk-cell below).

# ------------------------------------------------------------------------------------------------
# Ensuring I am in my talk cell
# ------------------------------------------------------------------------------------------------

# If I have a talk-cell and I'm not in it, go to it
rule talk-go-to-talk-cell
{@self goal {@self talk_to}}
(bb_public_read @self talk_cell): ?talk_cell
(at /not ?talk_cell (des factor 0.5))
    ->
# Intentionally higher utility than TURN_TO below, so the NPC
# continues into the center of the cell, if possible
(maintain_proposal {@self go_env_cell ?talk_cell} (des abs_util 1100)).

# If I have a talk-cell and I'm in it, stay there and face the person you're talking to
rule talk-face-person-talking-to-me
{@self goal {@self talk_to ?person}}
(bb_public_read @self talk_cell): ?talk_cell
(overlaps ?talk_cell @self)
    ->
(maintain_proposal {@self keep_looking_at_part ?person eyes} (des abs_util 1000))
(maintain_proposal {@self TURN_TO ?person} (des abs_util 1000)).

# If I have a talk-cell and I'm in it, go ahead and talk, 
# stay there and face the person you're talking to
rule talk-say-proposal
{@self goal {@self SAY ?msg ?person}:?talk_action}
(bb_public_read @self talk_cell): ?talk_cell
(overlaps ?talk_cell @self)
    ->
(begin_proposal ?talk_action).

# ------------------------------------------------------------------------------------------------
# RELEASE
# ------------------------------------------------------------------------------------------------

# Release cell when I am no longer trying to talk to anyone AND
# nobody is trying to talk to me
rule talk-release-cell
(bb_public_read @self talk_cell): ?talk_cell
(none {@self goal {@self talk_to}})
(bb_public_none ? try_to_talk_to @self)
    ->
(unclaim_env_cell ?talk_cell)
(bb_public_clear @self talk_cell).
# This also frees a rendezvous seat: the reserved cell IS the talk_cell, so
# unclaim_env_cell here releases it.

# ------------------------------------------------------------------------------------------------
# OUTCOMES
# ------------------------------------------------------------------------------------------------

# Track SAY outcome (statements and questions alike)
rule goal-SAY-outcome
{@self goal {@self SAY ?msg ?audience}}: ?goal
{@self /past SAY ?msg ?audience /caused_by ~?goal /out?}: ?SAY
    ->
(set_outcome ?goal (outcome ?SAY)).

# When asking a question (a qs payload), expect an answer. The label no
# longer discriminates mood, so gate on the payload func name - eq_func_name
# is arity-agnostic (a (qs ... (reg_des ...)) instance still passes).
rule goal-SAY-question-expect-answer
{@self goal {@self SAY ?question ?person}}: ?goal
{@self /past SAY ?question ?person /caused_by ~?goal /out?}: ?SAY
(eq_func_name ?question qs)
    ->
(begin_belief {@self expect_answer ?person /caused_by ?SAY}).
