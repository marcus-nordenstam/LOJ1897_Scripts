action = ASK
motor = mouth
transmission = listen
uninterruptable = true
sub = @msgAuthor
tar = @qs @excl @S
aux = @msgAudience

proc_anim = tell
alias = TELL
state = telling

preroll = 0.0
in      = 0.1
run     = 1.0
out     = 0.1

# ASK shares TELL's lifecycle: in_func computes run_duration_s from the viseme
# stream (presented) or kTellUnpresentedDurationS (unpresented). The 1.0 here
# is the placeholder default the binding falls back to. Bounded run + commit
# success at the cap is what produces /succ ASK so HearAnswer rules can fire.
anim_timeout_mode = success
nature = neutral_act
