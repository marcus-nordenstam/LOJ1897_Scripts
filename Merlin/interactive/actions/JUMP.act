action = JUMP
motor = legs
transmission = obs

preroll = 0.0
in      = 0.1
run     = 1.0
out     = 0.1

# Jump impulse is fired once in in_func; bounded run covers the air-time and
# landing animation. Commit success at the cap regardless of physics outcome -
# the jump is "done" once the duration completes.
anim_timeout_mode = success
nature = neutral_act
