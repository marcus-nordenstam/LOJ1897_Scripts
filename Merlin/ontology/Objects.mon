# PHYSICAL objects

object (+ obs)
    label
        applications
        mail
        out-mail
    # Natural (non-living) things
    mineral
        rock
    # Living things
    plant
        flower
            rose
        tree
    being
        robot
        cyborg
        animal
            human
            dog
                whippet
                german-shepard
            cat
                siamese
    # Forensic-trace families. The `blemish` parent unifies three
    # sub-trees so the `blemishes` plural-kind attr (common.arc) can
    # hold any mix and the forensic-detective layer reasons over the
    # union with one attr walk:
    #   wound  - body-internal injury (puncture-wound, slash-wound,
    #            blunt-wound, ligature-mark, burn-wound, bite-wound,
    #            bruise).
    #   stain  - substance deposited on a surface (ink, blood, dirt,
    #            gunpowder-residue, ash, mud, paint, wine).
    #   mark   - physical surface alteration (scratch, dent, crack,
    #            scuff, tool-mark, tear).
    # Per Rule 4 of knowledge_design_notes.md no leaf restates a
    # weapon kind: a gunshot entry is a `puncture-wound`, not a
    # `gunshot_wound`.
    blemish
        wound
            puncture-wound
            slash-wound
            blunt-wound
            ligature-mark
            burn-wound
            bite-wound
            bruise
        stain
            ink-stain
            blood-stain
            dirt-stain
            gunpowder-residue
            ash
            mud-stain
            paint-stain
            wine-stain
        mark
            scratch-mark
            dent
            crack
            scuff
            tool-mark
            tear
    # Meals & food. The leaves double as the OCCASION vocabulary the
    # evidence layer samples ("the wine, at supper") - a poisoning's
    # consume record carries one of these as its /aux occasion, chosen
    # consistently with the victim's habit beliefs. Victorian table:
    # breakfast / luncheon / tea / supper alongside the plain lunch /
    # dinner.
    meal                        (price 5)
        breakfast
        lunch
        luncheon
        dinner
        tea
        supper
    # Man-made things
    prop
        container
            drinking-glass
            # Table-service vessels - the poison-delivery layer's concrete
            # props. The victim's drink (a wine / tea fluid) sits in one of
            # these; a poisoning TAINTS that drink fluid (the `taint` attr),
            # so the vessel is the recovered delivery object and the tainted
            # fluid inside it is the forensic proof.
            cup
            decanter
            jewelry-box         (price 25)
        # Currency - a single coin: the buildable unit of cash (a plain gripped
        # prop). A bribe / gift hands over ONE via give -> OFFER. Not a wealth
        # model - the coin entity IS the cash: a real, transferable, discoverable
        # object, never a fictional sum.
        coin                    (price 1)
        accessory
            cufflink
            ring
                engagement-ring
                wedding-band
            hat
                bowler
            umbrella
            backpack
        clothing
            police-uniform
            dress
                summer-dress
            # Footwear, the muddy-prints clue class.
            boots
        # Inert household furniture - scene dressing the detective walks
        # through and searches. None carry a weapon facet (a heavy chair is
        # not modelled as an improvised bludgeon - keeping these inert stops
        # furniture from flooding the improvised-weapon pool; the genuine
        # improvised weapons are the candlestick / fire-poker / cutlery kinds
        # under their own families).
        loose-furniture
            table
                kitchen-table
                dining-table
            chair
            stool
            armchair
            bed
            wardrobe
            chest
            crate
            writing-desk
            writing-bureau
            bookshelf
            sideboard
            display-cabinet
            smoking-cabinet
            hat-stand
            umbrella-stand
            bell-pull
            sewing-machine
            drying-rack
            fireplace
            piano
                upright-piano
                grand-piano
            evidence-box
        # Purpose-built instruments of harm. Each leaf is naturally a
        # weapon (designed for combat / violence) - non-weapon items
        # that CAN be used to harm (a bust, a candlestick, a knife) live
        # under their natural parent kinds and pick up the relevant
        # (facets bludgeon / pierce / ...) instead.
        weapon
            dagger              (facets pierce)
            stiletto            (facets pierce)
            sword               (facets slash pierce)
            sabre               (facets slash)
            cutlass             (facets slash)
            club                (facets bludgeon)
            cudgel              (facets bludgeon)
            # conspicuous: a gun sale is REMEMBERED (the shopkeeper, the
            # sales-record); the acquisition calculus has careful buyers
            # prefer a safe theft over the paper trail. Per-leaf - facets
            # do not cascade.
            firearm             (price 60)
                pistol          (facets conspicuous)
                duelling-pistol (facets conspicuous)
                musket          (facets conspicuous)
                revolver        (facets conspicuous)
                shotgun         (facets conspicuous)
                hunting-rifle   (facets conspicuous)
            explosive           (price 40)
                gunpowder-keg   (facets conspicuous)
                dynamite-stick  (facets conspicuous)
        # Kitchen / table-service blades. Knife is the canonical sub-kind;
        # cleaver is the heavy-bladed chopping variant.
        cutlery
            knife               (facets pierce slash) (price 2)
            cleaver             (facets slash chop bludgeon) (price 3)
        # Decorative sculpture (the canonical Victorian crime-novel
        # improvised bludgeon).
        sculpture
            bust                (facets bludgeon)
        # Cordage. Natural taxonomic parent for rope-like materials. The
        # strangle facet covers garrotte / hang use.
        cordage
            rope                (facets strangle) (price 1)
            twine               (facets strangle)
            garrotte-wire       (facets strangle)
        # Household textiles. Bedding / linen. The smother facet covers
        # smother / suffocate use.
        textile
            pillow              (facets smother)
            bedsheet            (facets smother strangle)
            towel               (facets smother)
            blanket             (facets smother)
        # Lighting fixtures. A candlestick can also be used to bludgeon
        # (the brass-base variety); an oil-lamp carries fuel as well as
        # being an ignition source.
        lighting
            candle              (facets ignite)
            candlestick         (facets bludgeon ignite) (price 12)
            oil-lamp            (facets ignite burn_fuel) (price 4)
            lantern             (facets ignite)
            gas-lamp            (facets ignite)
            chandelier          (facets ignite)
        # Fire-starting implements that aren't themselves a light fixture.
        fire-starter
            matches             (facets ignite)
            tinderbox           (facets ignite)
        # Tools - purpose-built craft / labour implements.
        tools
            hammer              (facets bludgeon) (price 2)
            awl                 (facets pierce)
            chisel
            scissors            (facets pierce)
            saw
            axe                 (facets chop slash bludgeon) (price 3)
            fire-poker          (facets bludgeon)
        # Surgical instruments - a hospital / surgeon's sharps. They pierce
        # and slash like any blade, so they satisfy the same perpetration
        # facet gates (a surgeon killing with a scalpel is the in-period case).
        surgical-instrument
            scalpel             (facets pierce slash)
            lancet              (facets pierce)
            bone-saw            (facets slash chop)
        # Physician's carry-bag, holds substance bottles.
        medical-bag
        # Stoppered glass containers - the generic carriable vessel. There
        # is NO `poison_bottle` kind: a bottle is just a bottle, and the
        # POISON it holds is a concrete `poison` fluid (Objects.mon `fluid`)
        # with its own fill level. The apothecary / hospital dispensary
        # stocks a `toxin` fluid (the perpetration row gates on
        # (control_any toxin)); purchasing it rides mint_purchase_trail
        # (receipt + sales-record + shopkeeper memory) - the Victorian
        # poison register.
        bottle
        # Clocks and timepieces. Inert household time-keeping props; a stopped
        # mantel / grandfather clock is the classic time-of-death clue.
        timepiece
            wall-clock
            mantel-clock        (price 12)
            grandfather-clock
        # Decorative ornaments - inert scene dressing the detective searches.
        ornament
            figurine            (price 8)
            painting
            mirror
            taxidermy
            photograph
            vase
        # Floor coverings - rugs / carpets (the body-under-the-rug clue).
        floor-covering
            rug
                rag-rug
                persian-rug
        # Scientific / observation instruments - a gentleman's study pieces.
        scientific-instrument
            globe
            telescope
        # Household / kitchen utility goods. Inert (no weapon facet) so they
        # furnish rooms without flooding the improvised-weapon pool; the
        # cutting goods that ARE weapons live under `cutlery`.
        houseware
            cooking-pot
            stove
            coal-scuttle
            wash-basin
            pitcher
            chamber-pot
            broom
            sewing-kit
            flatiron
            washtub
            tin-cup
            tin-plate
            teacup
            inkstand
        # Tea / dinner services - class-signalling tableware (a silver service
        # marks an upper-class home).
        tableware
            tea-set             (price 10)
            silver-tea-service  (price 30)
            china-service       (price 20)
        # Parlour games. (`game` proper is a Concepts.mon activity object; these
        # are the physical play sets.)
        parlour-game
            chess-set
            playing-cards
        collection
            stack               (sub space|structure)  (tar @excl)
                root-npc-knowledge-stack
                for-sale-listing-stack
                for-lease-listing-stack
                title-deed-stack
                # The company registry's INCORPORATION stack: every org's
                # articles-of-incorporation doc is filed here (the companies house),
                # not at the org's own premises. An NPC learns the town's orgs by
                # browsing it (orient); the founding lane pushes each new AOC on.
                incorporation-stack
                # Per-premises INCOMING mail pile (ONE in each home's mail room,
                # one inside each hiding-spot cache): letters land here on
                # delivery and stay put - the pile IS the correspondence record.
                # Read-state is each reader's own {@self read <letter>}
                # act-memory, not a spatial move.
                mail-stack
                # Per-building OUTGOING mail pile (ONE per building, seeded at
                # world setup). A resident/officer posts a letter by depositing
                # it here (post_mail); the magic mail service drains every
                # outgoing pile each morning and teleports each letter to the
                # incoming mail-stack of the building at its written address.
                outgoing-mail-stack
            row
            # A pile of N identical FUNGIBLE items (shop-shelf bread, a coin
            # heap, a larder's stock): ONE entity + ONE mental object standing
            # for the whole, storing the item KIND (content-kind) and a COUNT,
            # never per-item entities. increment/decrement change the count;
            # subsume folds a real item in; extract spawns one out. A
            # memory-compression device - its bounds are the pile SHAPE.
            pile
        sporting-gear
            ball
                football
            cricket-bat         (facets bludgeon)
        # Documents are props - loose, carriable items. As prop subkinds they
        # inherit the prop archetype (writing + obb + in-stack attrs), so
        # mx_make_entity can create them; the org / property documents the
        # historical sim builds depend on that.
        document
            diploma
            letter
                adverts-letter
                # Perpetrator's own admission; writing embeds their
                # band-5 self-beliefs. Discovery internalizes the
                # crime fact via the standard read path.
                confession-letter
                # Kidnap-arc artifact; writing embeds
                # {family goal {family pay perp ?amount}} and a per-mind
                # "expects-to-see-victim" belief shape (missingness is
                # what other minds believe about an NPC, not a physical
                # fact about the body, so it lives in beliefs rather
                # than as a condition).
                ransom-note
                # Structurally a letter but claimed_author env attr differs
                # from the real author; plant-evidence events place these.
                forged-letter
                # Multi-generational revenge channel: a dying ancestor
                # writes one embedding {@self enemy ?perp_line} beliefs.
                # Descendants reading it internalize the grievance
                # (boundary liveness gate prevents fresh-internalization
                # of dead ancestors otherwise).
                family-history-letter
                # Affair correspondence (see Docs/hsim/hsim_social.md).
                # A love-letter's writing carries the affair fact itself
                # ({author lover recipient}) - reading one IS discovering
                # the affair. A tryst-note's writing carries a concrete
                # meeting ({author meet recipient /at venue}) - the
                # rendezvous channel.
                love-letter
                tryst-note
                # The repeat-demand coercion pass's physical demand note
                # ({blackmailer coerce victim /aux <demand>}), routed down
                # the covert letter channel. Its own kind so the per-kind
                # cache caps don't share a budget with conspiracy letters.
                blackmail-note
                # A victim's report to the police station: sentence 1 the
                # crime that befell them (the grievance act), sentence 2 -
                # when the wrongdoer is known - {victim suspect culprit}.
                # Nobody staffs the station, so reports accumulate unread:
                # the PLAYER's case feed.
                crime-report-letter
                # An exposure sent OPENLY to someone a secret wounds (not the
                # covert channel): the writing carries the exposed fact - e.g. a
                # spurned paramour naming an affair to the wronged spouse
                # ({cheater lover author}). Delivered to the target's home mail
                # pile, read in the morning post, and left there as evidence.
                denunciation-letter
                # A courtship declaration (billet-doux): the writing carries the
                # author's own regard ({author fancy recipient}). A suitor and a
                # SPECIFIC beloved rarely share a room, so the confession that
                # grounds reciprocal courtship travels by post - the beloved reads
                # it in the morning mail and comes to know she is fancied.
                courtship-letter
                # The labour-market verdict letters (recruit_actions.hs). A TYPED signal:
                # the seeker has one apply_for task in flight, so the letter's KIND alone
                # tells him the verdict - offer-letter -> take the post (apply_for succ),
                # rejection-letter -> apply_for fail. Delivered to his home mail pile, read
                # (held) in the morning post.
                offer-letter
                rejection-letter
            pamphlet
            book
            newspaper
            application
                job-application
            articles-of-incorporation
            employee-register
            job-description
            # A hotel's guest book: the
            # front desk's record of who stayed when - the paper residue a
            # shared-hotel rendezvous leaves for the detective.
            hotel-register
            title-deed
            # Purchase trail (weapon_acquire purchase mode). receipt
            # spawns at the buyer's home; sales-record spawns at the
            # selling shop. Both serve as physical evidence a detective
            # can find later. The shopkeeper additionally holds a
            # `{shopkeeper sell <item> /aux <buyer>}` belief; that
            # memory is the richest queryable signal until writings
            # patterns on these documents are wired.
            receipt
            sales-record
            root-npc-knowledge-doc
            for-sale-listing
            # The singleton for-sale REGISTER: one compressed table-doc (writing = a
            # list_form table of the available premises, one [building] row each) the
            # house-agency holds. Premises-seekers scan it (table-match) for a match, mint
            # {?b availability for-sale}, then reason via beliefs.
            for-sale-listings
            for-lease-listing
            lease-agreement
            # Testamentary document; writing encodes the testator's
            # goal beliefs about disinheritance / inheritance / expose.
            # Ruled model: writings encode the heirs' bequest prospects
            # (future-tense `inherit` per object, States.mon) once engine
            # future-interval support lands; the death-trigger estate
            # settlement then realises them per thing.
            will
    fluid
        beer
        # Drink fluids - what sits in a table-service vessel. A poisoning
        # TAINTS the victim's drink: the chosen drink fluid's `taint` attr
        # (common.arc) names the concentrated poison kind it was laced with
        # (the forensic ground truth a chemical analysis reveals - distinct
        # from the perpetrator's `add_substance` act-record belief). The
        # occasion picks the drink: supper / luncheon -> wine, tea ->
        # tea, breakfast -> water.
        wine
        tea
        water
        # Concentrated poison substances - the contents of a poison bottle,
        # the trade good behind the perpetration row's (control_any toxin)
        # gate. (`toxin`, not `poison`: `poison` is already the leaf kill
        # TASK in Tasks.mon, and two noun kinds of the same name make the
        # kind-value parser ambiguous.) Each is a real Victorian-era poison;
        # the `fluid-amount` (fluid.arc) is the bottle's fill level, depleted
        # one dose at a time by chronic poisoning - an emptied bottle is
        # spent evidence at the killer's home. A dose laces the victim's
        # drink (sets that drink fluid's `taint` to this kind). Modelled
        # under `fluid` as the deliverable concentrated substance; the
        # vermin killers below were physically powders (white arsenic) or
        # crystals (oxalic acid) dissolved into food / drink - the dose
        # mechanics are identical. Availability per venue lives in
        # weapon_seed.cc, not the ontology.
        toxin                   (price 8)
            # Medicinal extracts / draughts - apothecary & hospital
            # dispensary (purchase / authorized). The line between medicine
            # and poison was the dose. laudanum=opium tincture,
            # opium=raw opiate, digitalis-tincture=foxglove heart stimulant,
            # prussic-acid=hydrocyanic (rapid neat), chloral-draught=sedative,
            # antimony=tartar emetic, aconite=monkshood, belladonna=deadly
            # nightshade, chloroform=anaesthetic, corrosive-sublimate=mercuric
            # chloride disinfectant.
            # conspicuous: every toxin sale goes in the poison register -
            # the canonical paper trail a careful poisoner avoids.
            laudanum            (facets conspicuous)
            opium               (facets conspicuous)
            digitalis-tincture  (facets conspicuous)
            prussic-acid        (facets conspicuous)
            chloral-draught     (facets conspicuous)
            antimony            (facets conspicuous)
            aconite             (facets conspicuous)
            belladonna          (facets conspicuous)
            chloroform          (facets conspicuous)
            corrosive-sublimate (facets conspicuous)
            # Vermin killers / household chemicals - general shop, grocer,
            # agricultural supplier (purchase, no profession gate). The
            # classic over-the-counter poisons. white-arsenic=arsenic trioxide
            # (tasteless rat poison), strychnine=convulsant vermin killer,
            # oxalic-acid=rust / stain remover mistaken for sugar.
            white-arsenic       (facets conspicuous)
            strychnine          (facets conspicuous)
            oxalic-acid         (facets conspicuous)
        # Combustible accelerants. The (facets burn_fuel) flag is what
        # perpetration's immolate / arson methods key on, not the
        # parent kind.
        whiskey         (facets burn_fuel)
        lamp-oil        (facets burn_fuel)
        kerosene        (facets burn_fuel)
        turpentine      (facets burn_fuel)

    # Food taxonomy for trap-set / trap-fire arcs. Parallel to fluid;
    # poisoning a food vessel uses the same `add_substance` task as
    # fluids. Sub-kinds are starter content; extend as authored arcs
    # demand more variants.
    food
        bread
        cheese
        soup

    # Man-made structures
    structure
        path
            road
            trail
        sporting-grounds
            racing-grounds
            cricket-grounds
        container-structure
            wagon
            train-car
            ship
            building
                residential-building
                    manor
                    townhouse
                    rowhouse
                    farmhouse
                    chapel
                commercial-building
                    office
                    # (facets public_space) flag on open-to-public
                    # leaves: any actor is welcome_at without a personal
                    # invitation. Authored per-leaf so private
                    # commercial spaces (office / factory / warehouse /
                    # hotel / school / police-station / newspaper /
                    # shop) do NOT inherit. bank carries the flag for
                    # the lobby; a future refinement can split bank into
                    # bank_lobby / bank_vault.
                    bank        (facets public_space)
                    newspaper   (facets public_space)
                    shop        (facets public_space)
                    barbershop  (facets public_space)
                    restaurant  (facets public_space) (markup 3)
                    pub         (facets public_space) (markup 2)
                    factory
                        warehouse
                    hotel
                    school
                    hospital    (facets public_space)
                    police-station
                    church      (facets public_space)
                    theatre     (facets public_space)
                    # Public civic / cultural venues - founded + minimally
                    # staffed at sim start by the govt-bootstrap pass
                    # (public_orgs.hsc), and the venues the interest activity
                    # lane sends enthusiasts to (activity-lanes L5). All
                    # open-to-public, so they carry the public_space facet.
                    library     (facets public_space)
                    museum      (facets public_space)
                    meeting-hall (facets public_space)
                    sports-ground (facets public_space)
                    # Private members' club premises (activity-lanes L8). NOT
                    # public_space - a club is members-only, so a non-member is
                    # not welcome_at without invitation. The club lane convenes
                    # the member-register here (clubhouse co-presence). Split by
                    # club type: athletic (sporting) vs social (gentlemen's).
                    clubhouse
                        athletic-clubhouse
                        social-clubhouse
        pier
        bridge
            suspension-bridge
    part (tar space|part)
        body-part
            head
            hand
                left-hand  (side left)
                right-hand (side right)
            finger
                ring-finger
            eye
            mouth
            # Central body. Default wound-site when a method-row's
            # :wound-site slot is omitted; carries generic torso
            # wounds (stab, gunshot, beating). Additional body-parts
            # (neck, arm, leg, lungs) land alongside the method rows
            # that need them.
            torso
        structure-part
            counter
                bar-counter
            wall
            opening (+ nav_passage)
                window
                door