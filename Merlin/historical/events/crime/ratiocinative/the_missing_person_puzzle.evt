# Frequently seeded by other events. Mechanic: a person vanishes; the
# region's salience-weighted memory of them lingers, and a partial-fidelity
# belief spreads.
event "the_missing_person_puzzle" {
    display "The Missing Person Puzzle"
    tag crime ratiocinative missing_person
    schedule recurring from=1700 to=1897
    magnitude 70
    cooldown_years 5
    max_per_decade_global 5
    role "perpetrator" {
        kind=npc alive age=20..65
    }
    role "victim" {
        kind=npc alive age=10..70
    }
    on_fire {
        disappear victim
        propagate went_missing victim observers=region_of fidelity=0.4 salience=0.6
        emotion_delta perpetrator fear 0.2
    }
}
