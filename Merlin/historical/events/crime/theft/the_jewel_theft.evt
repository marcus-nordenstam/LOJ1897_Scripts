# A high-value theft from an aristocratic household. The perpetrator can be
# anyone with material need or thrill-seeking impulse - no dark-triad floor
# is imposed, since theft is non-violent. The victim is an upper-class
# household member whose loss is publicly known.
event "the_jewel_theft" {
    display "The Jewel Theft"
    tag crime theft property
    schedule recurring from=1750 to=1897
    magnitude 50
    cooldown_years 4
    max_per_decade_global 4
    format "?perpetrator steals jewels from ?victim"
    event_type theft
    motive material_gain survival fear_of_loss thrill social_climbing
    role "perpetrator" {
        kind=npc alive age=18..55
    }
    role "victim" {
        kind=npc alive aristocratic age=20..80
    }
    on_fire {
        assert_world stole_from perpetrator victim
        emotion_delta perpetrator pride 0.3
        emotion_delta victim     anger 0.5
        attitude_set  victim perpetrator hate 0.6
        propagate stole_from perpetrator victim observers=region_of fidelity=0.5 salience=0.5
    }
}
