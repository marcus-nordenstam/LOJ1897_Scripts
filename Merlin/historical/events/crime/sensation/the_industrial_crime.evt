# Industrial-era only (Industrial Revolution event spans 1820-1880).
# Mechanic: an employer kills a worker over a debt or a labor dispute,
# installing the structural inequality of the era as a region mood shift.
event "the_industrial_crime" {
    display "The Industrial Crime"
    tag crime sensation industrial
    schedule recurring from=1830 to=1897
    magnitude 80
    cooldown_years 7
    max_per_decade_global 3
    role "perpetrator" {
        kind=npc alive age=25..60
    }
    role "victim" {
        kind=npc alive lower_class age=14..60
    }
    on_fire {
        kill victim cause=cause_murder
        assert_world indebted_to perpetrator victim
        emotion_delta perpetrator contempt 0.5
        propagate died victim observers=region_of fidelity=0.5 salience=0.7
        region_mood_delta region_of=victim anti_aristocratic 0.2
    }
}
