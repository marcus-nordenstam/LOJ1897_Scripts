# A high-class kin murder driven by inheritance. Mechanic: kill the victim,
# install suspicion-belief about the perpetrator at all kin observers,
# stamp a feud edge as scandal, and seed a possible revenge event 8-25
# years later targeting the perpetrator or a descendant.
event "the_inheritance_murder" {
    display "The Inheritance Murder"
    tag crime sensation
    schedule recurring from=1700 to=1897
    magnitude 90
    cooldown_years 6
    max_per_decade_global 3
    role "perpetrator" {
        kind=npc alive aristocratic age=20..60
        tetrad_mach>=140
    }
    role "victim" {
        kind=npc alive aristocratic age=40..90
        kin_of=perpetrator
        inheritance_above=perpetrator
    }
    on_fire {
        kill victim cause=cause_murder
        propagate died victim observers=region_of fidelity=0.55 salience=0.7
        attitude_set perpetrator victim hate 0.9
        attitude_set victim perpetrator distrust 0.95
        emotion_delta perpetrator guilt 0.4
        seed_event "the_revenge_of_the_wronged" lag_min=8 p=0.3
    }
}
