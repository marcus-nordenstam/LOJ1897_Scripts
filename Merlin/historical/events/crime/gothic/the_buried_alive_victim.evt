# Sadism + psychopathy floors. Mechanic: the victim *disappears* (fate
# ambiguous to others), the perpetrator's region develops an elevated
# plague_fear / haunting mood, and a region_of grief ripple installs.
event "the_buried_alive_victim" {
    display "The Buried Alive Victim"
    tag crime gothic
    schedule recurring from=1700 to=1897
    magnitude 95
    cooldown_years 14
    max_per_decade_global 2
    role "perpetrator" {
        kind=npc alive age=25..70
        tetrad_psy>=200
        tetrad_sad>=140
    }
    role "victim" {
        kind=npc alive age=10..80
    }
    on_fire {
        disappear victim
        emotion_delta perpetrator pride 0.25
        attitude_set perpetrator victim scorn 0.95
        propagate went_missing victim observers=region_of fidelity=0.45 salience=0.85
        region_mood_delta region_of=victim plague_fear 0.15
    }
}
