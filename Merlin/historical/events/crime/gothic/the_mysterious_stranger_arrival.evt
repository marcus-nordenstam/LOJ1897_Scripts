# Mechanic: an outsider arrives, befriends a local family, and a murder
# follows. The outsider gate makes this template *only* fire when the
# perpetrator is non-local. Multiple ripples: anti_outsider mood, suspicion
# attitudes spread, possible follow-on missing-person.
event "the_mysterious_stranger_arrival" {
    display "The Mysterious Stranger Arrival"
    tag crime gothic outsider
    schedule recurring from=1700 to=1897
    magnitude 85
    cooldown_years 9
    max_per_decade_global 2
    role "stranger" {
        kind=npc alive age=20..60
        outsider
        tetrad_mach>=140
    }
    role "victim" {
        kind=npc alive age=15..70
    }
    on_fire {
        kill victim cause=cause_murder
        propagate died victim observers=region_of fidelity=0.5 salience=0.75
        attitude_set victim stranger distrust 0.7
        emotion_delta stranger pride 0.3
        region_mood_delta region_of=victim anti_outsider 0.4
        seed_event "the_missing_person_puzzle" lag_min=1 p=0.3
    }
}
