# A trusted middle-class clerk or steward siphons funds from an aristocratic
# employer over months or years. Industrial-era only - the modern bookkeeping
# practices that make this crime legible only emerge with industry. No dark
# triad floor; the motive lives in fear, ambition, or quiet resentment.
event "the_embezzlement" {
    display "The Embezzlement"
    tag crime white_collar fraud industrial
    schedule recurring from=1830 to=1897
    magnitude 60
    cooldown_years 5
    max_per_decade_global 3
    format "?perpetrator embezzles from ?victim"
    event_type financial
    motive material_gain face_saving social_climbing fear_of_loss family_preservation
    role "perpetrator" {
        kind=npc alive middle_class age=25..60
    }
    role "victim" {
        kind=npc alive aristocratic age=30..80
    }
    on_fire {
        assert_world embezzled_from perpetrator victim
        attitude_set perpetrator victim contempt 0.4
        emotion_delta perpetrator shame 0.3
        emotion_delta victim     anger 0.6
        propagate embezzled_from perpetrator victim observers=region_of fidelity=0.4 salience=0.6
    }
}
