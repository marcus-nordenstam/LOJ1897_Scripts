# A child or young relative of an aristocratic family is taken for ransom.
# Coercive but not inherently lethal - classified as `kidnapping`, which
# imposes only a mild trait floor (above-average machiavellianism) since
# the crime requires planning and emotional detachment but not cruelty.
event "the_ransom_kidnapping" {
    display "The Ransom Kidnapping"
    tag crime kidnapping coercion
    schedule recurring from=1820 to=1897
    magnitude 75
    cooldown_years 8
    max_per_decade_global 2
    format "?perpetrator kidnaps ?victim for ransom"
    event_type abduction
    motive material_gain survival revenge vendetta family_preservation
    role "perpetrator" {
        kind=npc alive age=22..55
    }
    role "victim" {
        kind=npc alive aristocratic age=8..30
    }
    on_fire {
        assert_world kidnapped perpetrator victim
        emotion_delta victim       fear     0.9
        emotion_delta perpetrator  pride    0.2
        attitude_set  victim perpetrator hate 0.8
        propagate kidnapped perpetrator victim observers=region_of fidelity=0.7 salience=0.9
    }
}
