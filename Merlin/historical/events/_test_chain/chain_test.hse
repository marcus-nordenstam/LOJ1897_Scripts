; ----------------------------------------------------------------------------
; Phase C item 9.B validation chain. Two events demonstrating the
; (schedule ...) effect verb + chained role binding:
;
;   - chain_test_origin fires once a year in june; for ~5% of eligible humans
;     it schedules a follow-up 14 days later with its ?host pre-bound.
;
;   - chain_test_followup is (chain-only); it never fires from a seed pass.
;     Pre-bound role values let it skip the host enumeration entirely; the
;     when-gate ((alive ?host) check) gates a host who died in the interim.
;
; Verification:
;   1. chain_test_origin fires in june each year (visible in narrative).
;   2. chain_test_followup fires in the same year as its origin, on june 15
;     (14 days after june 1).
;   3. Followup fire-count <= origin fire-count (chains drop when the host
;     died between scheduling and firing - the alive when-gate fires).
;
; Delete this file (and the _test_chain/ directory) once the chain mechanism
; is in production use by Phase D content.
; ----------------------------------------------------------------------------

(include "../shared/roles.hse")

(hsim-event chain_test_origin
  (nl       "?host opens a chain")
  (kind     _chain_test_origin)
  (schedule (annually june))
  (roles
    (role ?host (template any_human)
                (chance 0.05)))
  (effects
    (log _chain_test_origin ?host)
    (schedule chain_test_followup
              :lag 14
              (host ?host))))

(hsim-event chain_test_followup
  (nl       "?host feels the chain ripple")
  (kind     _chain_test_followup)
  (schedule (chain-only))
  (roles
    (role ?host (template any_human)))
  (when     (alive ?host))
  (effects
    (log _chain_test_followup ?host)))
