; ----------------------------------------------------------------------------
; test_seed_kill_goal.hse - Phase D PR-2 kill-path validation (2026-05-24+).
;
; TEST scaffold. Directly mints a kill goal in actor's mind so commit-kill's
; kill path can be exercised every sweep instead of waiting for the RNG-rare
; deliberate-driven kill goal to fire. The shape:
;
;   {actor goal {actor kill victim _}}    (loose-phrase inner clause, same
;                                          shape as deliberate's kill branch)
;
; Next monthly tick: improvised_kill -> commit-kill picks up the goal,
; mints the act-anchor, propagates death, appends the crime-ledger entry,
; destroys the victim.
;
; Annual schedule + low chance: this is validation infrastructure, not a
; content driver. A handful of kills per 197-year sweep is enough to
; exercise the path. Delete this directory once PR-3/PR-4 produce natural
; kill goals via the discovery -> pressure -> deliberate cascade.
; ----------------------------------------------------------------------------

(include "../shared/roles.hse")

(hsim-event test_seed_kill_goal
  (nl       "TEST: ?actor plots to kill ?victim")
  (kind     _test_seed_kill_goal)
  (schedule (annually june))
  (rng-stream test_seed)

  (roles
    (role ?actor  (template any_human)
                  (chance 0.02))
    (role ?victim (template any_human)
                  (not (= ?victim ?actor))
                  (chance 0.10)))

  (effects
    (seed-test-kill-goal ?actor ?victim)
    (log _test_seed_kill_goal ?actor)))
