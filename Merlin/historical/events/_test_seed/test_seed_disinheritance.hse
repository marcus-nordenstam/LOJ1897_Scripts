; ----------------------------------------------------------------------------
; test_seed_disinheritance.hse - pressure-source diversity scaffold
; (2026-05-26).
;
; Mints {actor disinherit victim} anchors. The `disinherit` label is
; tagged (construed_act abandonment_act wrong_act) in States.mon, so
; categorize fires:
;
;   victim (pov=patient):
;     - abandonment_act -> grief + distress + attachment_loss pressure
;                          + status_loss pressure + end-bonds (love / friend)
;     - wrong_act       -> anger + distress + humiliation + injustice pressure
;   actor (pov=actor):
;     - abandonment_act -> guilt + moral_violation pressure
;     - wrong_act       -> guilt + fear + moral_violation + exposure_risk
;
; Unlocks attachment_loss (driving mourn / withdraw / replace / seduce
; affinities) and status_loss (driving withdraw / confront_privately /
; flee). Test scaffold writes the anchor without restricting actor /
; victim to parent / child; reality-fidelity arrives when the will-
; event substrate lands.
;
; TEST SCAFFOLD: delete with the rest of _test_seed/ when organic
; will / testament events mint disinherit anchors during inheritance
; flow.
;
; Fire-rate: 1% per actor x 8% per victim = 0.08% per pair per year.
; Disinheritance is rare in absolute terms but emotionally heavy when
; it happens.
; ----------------------------------------------------------------------------

(include "../shared/roles.hse")

(hsim-event test_seed_disinheritance
  (nl       "TEST: ?actor disinherits ?victim")
  (kind     _test_seed_disinheritance)
  (schedule (annually september))
  (rng-stream test_seed)

  (roles
    (role ?actor  (template any_human)
                  (chance 0.01))
    (role ?victim (template any_human)
                  (not (= ?victim ?actor))
                  (chance 0.08)))

  (effects
    (seed-test-anchor ?actor disinherit ?victim)
    (log _test_seed_disinheritance ?actor)))
