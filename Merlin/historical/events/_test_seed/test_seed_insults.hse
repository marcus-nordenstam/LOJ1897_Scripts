; ----------------------------------------------------------------------------
; test_seed_insults.hse - Phase 10 Pivot A loop-closure bootstrap
; (2026-05-24, TEST SCAFFOLD).
;
; Vanilla hsim has no upstream pressure source today - the deliberate
; event picks floor branches only and the loop stays dormant. This
; scaffold mints a small number of {actor insult victim} act-anchors per
; year. The cascade:
;
;   {actor insult victim}                              (anchor)
;     -> categorize (Pivot B) sees slight_act tag
;     -> {actor slight_act victim} construal
;     -> appraisal.hsc reaction row :pov patient
;     -> {victim pressure humiliation /aux actor}      (pressure!)
;   next deliberate fire on victim
;     -> humiliation-keyed branches synthesized
;     -> non-floor branch may win
;     -> {victim goal {victim <action-label> actor}}   (goal!)
;   perpetrate_goal next month
;     -> commits {victim <action-label> actor}         (act anchor)
;     -> categorize fires again -> more construals -> more pressures
;
; This is a TEST scaffold. Delete this directory once real content events
; (Phase D's authored crime-arc events) mint anchors organically. The
; scaffold's fire rate (5% per year) is calibrated to seed a handful of
; arc-starts per population per year without overwhelming the substrate.
; ----------------------------------------------------------------------------

(include "../shared/roles.hse")

(hsim-event test_seed_insult
  (nl       "TEST: ?actor insults ?victim")
  (kind     _test_seed_insult)
  (schedule (annually march))
  (rng-stream test_seed)

  (roles
    (role ?actor  (template any_human)
                  (chance 0.05))
    (role ?victim (template any_human)
                  (not (= ?victim ?actor))
                  (chance 0.20)))

  (effects
    ; (seed-test-insult) writes {actor insult victim} in BOTH minds so the
    ; slight_act pov=patient reaction row fires on victim and mints
    ; humiliation pressure - the bootstrap substrate the loop needs.
    (seed-test-insult ?actor ?victim)
    (log _test_seed_insult ?actor)))
