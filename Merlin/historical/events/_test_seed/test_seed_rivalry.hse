; ----------------------------------------------------------------------------
; test_seed_rivalry.hse - pressure-source diversity scaffold (2026-05-26).
;
; Mints {actor outdo victim} anchors. The `outdo` label is tagged
; (construed_act rivalrous_act) in States.mon, and the rivalrous_act
; reaction row in appraisal.hsc mints rivalry_pressure on the
; outcompeted patient. Until this scaffold landed, rivalry_pressure
; had NO organic source - the deliberation.hsc affinity rows keyed on
; rivalry_pressure (discredit / humiliate / kill / confront_privately
; / expose) were unreachable.
;
;   victim (pov=patient):
;     - rivalrous_act -> envy + contempt + rivalry_pressure pressure
;   actor (pov=actor):
;     - (no reaction row authored - winners do not appraise their own
;       positional success as a wrong; achievement pride lives in a
;       separate achieve_act cascade if added later)
;
; TEST SCAFFOLD: delete with the rest of _test_seed/ when organic
; competitive events (lost-job-to, outbid-by, out-courted-by) mint
; outdo anchors during real career / courtship flow.
;
; Fire-rate: 3% per actor x 12% per victim = 0.36% per pair per year.
; Higher than fraud / disinheritance because positional competition
; is everywhere in a stratified society - merchants compete for
; clients, suitors compete for matches, heirs compete for favour.
; ----------------------------------------------------------------------------

(include "../shared/roles.hse")

(hsim-event test_seed_rivalry
  (nl       "TEST: ?actor outdoes ?victim")
  (kind     _test_seed_rivalry)
  (schedule (annually november))
  (rng-stream test_seed)

  (roles
    (role ?actor  (template any_human)
                  (chance 0.03))
    (role ?victim (template any_human)
                  (not (= ?victim ?actor))
                  (chance 0.12)))

  (effects
    (seed-test-anchor ?actor outdo ?victim)
    (log _test_seed_rivalry ?actor)))
