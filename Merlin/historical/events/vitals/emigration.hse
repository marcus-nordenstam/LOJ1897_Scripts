; ----------------------------------------------------------------------------
; Emigration. Young adults occasionally leave the parish for opportunity
; elsewhere. Distinct from death: an emigrant leaves the world without
; leaving a corpse, so PR-evi-B 2026-05-25 split the effect verb: this
; event now calls (emigrate) which destroys the entity immediately,
; whereas (die) used by mortality events writes death_date and leaves
; the corpse for burial.hse to clean up after the persistence window.
; ----------------------------------------------------------------------------

(include "../shared/roles.hse")

(hsim-event emigration
  (nl         "?who emigrates")
  (kind       _emigration)
  (schedule   (annually january))
  (rng-stream migrations)

  (roles
    (role ?who (template young_adult)))

  ; High openness (seeking new experience) emigrates more readily. The
  ; mean-1.0 multiplier preserves the ~1.5%/yr baseline emigration volume.
  (when (chance (* 0.015 (+ 0.5 (attr ?who openness)))))

  (effects
    (end-belief ?who spouse)
    ; (emigrate) settles the residence (list owned for sale / end a lease) in
    ; its handler before destroying the entity - see release_home_on_emigration.
    (emigrate   ?who)
    (log        _emigration ?who)))
