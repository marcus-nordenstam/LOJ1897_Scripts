# Channel storms / shipwreck cluster of 1859 - one_shot with locally heavy
# casualties.
event "storm_cluster_1859" {
    display "Channel Storms and Shipwrecks of 1859"
    tag local_disaster
    schedule one_shot from=1859 to=1859
    magnitude 60
    role "drowned" {
        kind=npc alive gender=male age=14..60
        optional
    }
    on_fire {
        kill drowned cause=cause_accident
        emotion_delta drowned fear 0.7
        region_mood_delta region_of=drowned plague-fear 0.2
    }
}
