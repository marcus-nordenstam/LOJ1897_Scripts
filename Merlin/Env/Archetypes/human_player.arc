# Any human PLAYER
archetype "human_player" [256] /obs /raycast_visible /player /non_occluder /occupies_env_grid /blackboard /infer_kind_override human player
{
    "physical_motors"
    "role"
    "date"
    "age"
    "age_group"
    "gender"
    "appearance"
    "height"
    "girth"
    "name"
    "nationality"
    "condition"
    "pregnant_when"
    "alertness"
    "in"
    "region"
    # Parts are not auto-perceived — we perceive specific body-parts below instead
    "parts"
    "left_hand"
    "right_hand"
    "eyes"
    "mouth"
    "pregnant_by"
    "control"
    "obb"
}
