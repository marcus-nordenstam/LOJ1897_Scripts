archetype "transaction_zone" [256]  /obs /alwaysVisible /nonOccluder
{
    "isa"              kind                                 /kind               /passivePercept
    "obb"              obb                                  /spatialBounds      /passivePercept
    "parent"           entity                               /parent
    "parts"            entity [4] /label "part"             /children           /passivePercept
}
