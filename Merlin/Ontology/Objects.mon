# PHYSICAL objects

object (+ obs)
    label
        applications
        mail
        out_mail
    # Natural (non-living) things
    mineral
        rock
    # Living things
    plant
        flower
            rose
        tree
    being
        robot
        cyborg
        animal
            human
            dog
                whippet
                german_shepard
            cat
                siamese
    # PR-evi-A 2026-05-25 - wound taxonomy as the target-kind enum for the
    # `wounds` body-part attr. Per Rule 4 of knowledge_design_notes.md the
    # wound label does NOT name the weapon - a gunshot entry is a
    # `puncture_wound` with `firearm` in the method-aux; a `blunt_wound`
    # is generic to clubs / fists / falls.
    wound
        puncture_wound
        slash_wound
        blunt_wound
        ligature_mark
        burn_wound
        bite_wound
        bruise
    # PR-evi-A 2026-05-25 - extended stain taxonomy (gunpowder_residue, ash,
    # mud_stain, paint_stain, wine_stain) for the `stains` attr. Stains are
    # things DEPOSITED on a surface (distinct from marks, which physically
    # alter the surface - declared as the `mark` parent below).
    stain
        ink_stain
        blood_stain
        dirt_stain
        gunpowder_residue
        ash
        mud_stain
        paint_stain
        wine_stain
    # PR-evi-A 2026-05-25 - mark parent: physical surface alterations
    # (scratches, dents, cracks). Distinct from stains (deposits) and from
    # wounds (body-internal). Backs the `marks` attr on prop /
    # structure_part / body-part archetypes.
    mark
        scratch_mark
        dent
        crack
        scuff
        tool_mark
        tear
    # Meals & food
    meal
        breakfast
        lunch
        dinner
    # Man-made things
    prop
        container
            drinking_glass
        accessory
            cufflink
            ring
                engagement_ring
                wedding_band
            hat
                bowler
            umbrella
            backpack
        clothing
            police_uniform
            dress
                summer_dress
            # Phase 10 Phase C - footwear, the muddy-prints clue class.
            boots
        loose_furniture
            table
                kitchen_table
            evidence_box
        # Purpose-built instruments of harm. PR-3b 2026-05-25 expanded the
        # subkinds to cover the perpetration.hsc method-row :requires gates -
        # pointed_blade / edged_blade / heavy_blade subsume the existing
        # `knife`; blunt_object subsumes the existing `bust`; the rest are
        # new families.
        weapon
            pointed_blade
                knife
            edged_blade
            heavy_blade
            blunt_object
                # Phase 10 Phase C - bronze bust / marble sculpture / similar
                # improvised bludgeons. Now a sub-kind of blunt_object.
                bust
            cord_or_wire
            firearm
            explosive
        # Improvised harm materials (PR-3b 2026-05-25). NOT weapons - these
        # are items the world otherwise uses for non-violent purposes
        # (rope for hauling, cloth for bedding, matches for lighting fires,
        # a hammer for carpentry) that perpetration.hsc method rows can
        # nominate as the means. Kept as siblings to `weapon` so a
        # (controls-any ?actor [k weapon]) check correctly EXCLUDES these.
        rope
        pillow_or_cloth
        ignition_source
        electrical_apparatus
        tools
        # Phase 10 Phase C - physician's carry-bag, holds substance bottles.
        medical_bag
        collection
            stack               (sub space|structure)  (tar @excl)
                root_npc_knowledge_stack
                for_sale_listing_stack
                for_lease_listing_stack
                title_deed_stack
            row
        sporting_gear
            ball
                football
        # Documents are props - loose, carriable items. As prop subkinds they
        # inherit the prop archetype (writing + obb + in_stack attrs), so
        # mx_make_entity can create them; the org / property documents the
        # historical sim builds depend on that.
        document
            diploma
            letter
                adverts_letter
                # Phase 10 Phase C - the perpetrator's own admission;
                # writing embeds their band-5 self-beliefs. Discovery
                # internalizes the crime fact via the standard read path.
                confession_letter
                # Kidnap-arc artifact; writing embeds
                # {family goal {family pay perp ?amount}} and a per-mind
                # "expects-to-see-victim" belief shape (NOT
                # `condition missing` - that atom was retired in PR-life-A
                # because missingness is what other minds believe about an
                # NPC, not a physical fact about the body).
                ransom_note
                # Structurally a letter but claimed_author env attr differs
                # from the real author; plant-evidence events place these.
                forged_letter
                # Multi-generational revenge channel: a dying ancestor
                # writes one embedding {@self enemy ?perp_line} beliefs.
                # Descendants reading it internalize the grievance
                # (boundary liveness gate prevents fresh-internalization
                # of dead ancestors otherwise).
                family_history_letter
            pamphlet
            book
            newspaper
            application
                job_application
            articles_of_incorporation
            employee_register
            job_description
            title_deed
            root_npc_knowledge_doc
            for_sale_listing
            for_lease_listing
            lease_agreement
            # Phase 10 Phase C - testamentary document; writing encodes the
            # testator's goal beliefs about disinheritance / inheritance /
            # expose. Death-trigger reads it to convert heir_of -> inherit.
            will
    fluid
        beer
        # Wine fluid for trap-set/trap-fire arcs. Tampering is recorded via
        # the `add_substance` belief (States.mon, PR-evi-C 2026-05-25):
        # `{actor add_substance <poison-obj> <wine-obj>}`. WHO tampered,
        # WHAT they added, and the affected vessel are all captured in one
        # belief shape, parallel to other act-records.
        wine
        # PR-3b 2026-05-25 - combustible accelerant for arson / immolate
        # perpetration method rows. Sibling to beer / wine because it
        # follows the same env shape (a fluid carried in a vessel that the
        # actor possesses); kerosene / paraffin / lamp_oil are future
        # sub-kinds.
        flammable_liquid

    # Food taxonomy for trap-set / trap-fire arcs. Parallel to fluid;
    # poisoning a food vessel uses the same `add_substance` belief
    # (States.mon, PR-evi-C 2026-05-25) as fluids. Sub-kinds are starter
    # content; extend as authored arcs demand more variants.
    food
        bread
        cheese
        soup

    # Man-made structures
    structure
        path
            road
            trail
        sporting_grounds
            racing_grounds
            cricket_grounds
        container_structure
            wagon
            train_car
            ship
            building
                residential_building
                    manor
                    cottage
                    terrace
                        townhouse
                    tenement
                    farmhouse
                    chapel
                commercial_building
                    office
                    # PR-poss-A 2026-05-25 - (public) flag on open-to-public
                    # leaves: any actor is welcome_at without a personal
                    # invitation. Authored per-leaf so private commercial
                    # spaces (office / factory / warehouse / hotel / school /
                    # police_station / newspaper / shop) do NOT inherit.
                    # bank carries the flag for v1 (the lobby); a future
                    # refinement can split bank into bank_lobby / bank_vault.
                    bank        (public)
                    newspaper
                    shop
                    barbershop  (public)
                    restaurant  (public)
                    pub         (public)
                    factory
                        warehouse
                    hotel
                    school
                    hospital    (public)
                    police_station
                    church      (public)
                    theatre     (public)
        pier
        bridge
            suspension_bridge
    part
        body_part
            head
            hand
                left_hand  (side left)
                right_hand (side right)
            finger
                ring_finger
            eye
            mouth
            # PR-evi-A 2026-05-25 - the central body. Default wound-site
            # when a method-row's :wound-site slot is omitted; carries
            # generic torso wounds (stab, gunshot, beating). Additional
            # body-parts (neck, arm, leg, lungs) land alongside the
            # method rows that need them.
            torso
        structure_part
            counter
                bar_counter
            wall
            opening (+ nav_passage)
                window
                door