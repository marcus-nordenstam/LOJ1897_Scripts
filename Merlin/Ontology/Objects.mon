# PHYSICAL objects

object (+ obs)
    label
        applications
        mail
        out_mail
    # Natural (non-living) things
    mineral
        rock
    # Living things
    plant
        flower
            rose
        tree
    being
        robot
        cyborg
        animal
            human
            dog
                whippet
                german_shepard
            cat
                siamese
    wound
        stab_wound
        # Phase 10 Phase C - blunt-instrument injury (bust, club, fall).
        blunt_wound
    stain
        ink_stain
        blood_stain
        dirt_stain
    # Meals & food
    meal
        breakfast
        lunch
        dinner
    # Man-made things
    prop
        container
            drinking_glass
        accessory
            cufflink
            ring
                engagement_ring
                wedding_band
            hat
                bowler
            umbrella
            backpack
        clothing
            police_uniform
            dress
                summer_dress
            # Phase 10 Phase C - footwear, the muddy-prints clue class.
            boots
        loose_furniture
            table
                kitchen_table
            evidence_box
        # Purpose-built instruments of harm. PR-3b 2026-05-25 expanded the
        # subkinds to cover the perpetration.hsc method-row :requires gates -
        # pointed_blade / edged_blade / heavy_blade subsume the existing
        # `knife`; blunt_object subsumes the existing `bust`; the rest are
        # new families.
        weapon
            pointed_blade
                knife
            edged_blade
            heavy_blade
            blunt_object
                # Phase 10 Phase C - bronze bust / marble sculpture / similar
                # improvised bludgeons. Now a sub-kind of blunt_object.
                bust
            cord_or_wire
            firearm
            explosive
        # Improvised harm materials (PR-3b 2026-05-25). NOT weapons - these
        # are items the world otherwise uses for non-violent purposes
        # (rope for hauling, cloth for bedding, matches for lighting fires,
        # a hammer for carpentry) that perpetration.hsc method rows can
        # nominate as the means. Kept as siblings to `weapon` so a
        # (controls-any ?actor [k weapon]) check correctly EXCLUDES these.
        rope
        pillow_or_cloth
        ignition_source
        electrical_apparatus
        tools
        # Phase 10 Phase C - physician's carry-bag, holds substance bottles.
        medical_bag
        collection
            stack               (sub space|structure)  (tar @excl)
                root_npc_knowledge_stack
                for_sale_listing_stack
                for_lease_listing_stack
                title_deed_stack
            row
        sporting_gear
            ball
                football
        # Documents are props - loose, carriable items. As prop subkinds they
        # inherit the prop archetype (writing + obb + in_stack attrs), so
        # mx_make_entity can create them; the org / property documents the
        # historical sim builds depend on that.
        document
            diploma
            letter
                adverts_letter
                # Phase 10 Phase C - the perpetrator's own admission;
                # writing embeds their band-5 self-beliefs. Discovery
                # internalizes the crime fact via the standard read path.
                confession_letter
                # Kidnap-arc artifact; writing embeds
                # {family goal {family pay perp ?amount}} and
                # {victim condition missing} beliefs.
                ransom_note
                # Structurally a letter but claimed_author env attr differs
                # from the real author; plant-evidence events place these.
                forged_letter
                # Multi-generational revenge channel: a dying ancestor
                # writes one embedding {@self enemy ?perp_line} beliefs.
                # Descendants reading it internalize the grievance
                # (boundary liveness gate prevents fresh-internalization
                # of dead ancestors otherwise).
                family_history_letter
            pamphlet
            book
            newspaper
            application
                job_application
            articles_of_incorporation
            employee_register
            job_description
            title_deed
            root_npc_knowledge_doc
            for_sale_listing
            for_lease_listing
            lease_agreement
            # Phase 10 Phase C - testamentary document; writing encodes the
            # testator's goal beliefs about disinheritance / inheritance /
            # expose. Death-trigger reads it to convert heir_of -> inherit.
            will
    fluid
        beer
        # Phase 10 Phase D PR-3 - wine fluid for the trap-set/trap-fire arc.
        # Tainted via the `tainted_with` attr (declared in common.arc); the
        # perpetrator is recorded via `tainted_by` on the same vessel.
        wine
        # PR-3b 2026-05-25 - combustible accelerant for arson / immolate
        # perpetration method rows. Sibling to beer / wine because it
        # follows the same env shape (a fluid carried in a vessel that the
        # actor possesses); kerosene / paraffin / lamp_oil are future
        # sub-kinds.
        flammable_liquid

    # Phase 10 Phase D PR-3 - food taxonomy for the trap-set/trap-fire arc.
    # Parallel to fluid: a `food` entity carries the same tainted_with /
    # tainted_by attrs so non-liquid poisoning works too. Sub-kinds are
    # starter content; extend as authored arcs demand more variants.
    food
        bread
        cheese
        soup

    # Man-made structures
    structure
        path
            road
            trail
        sporting_grounds
            racing_grounds
            cricket_grounds
        container_structure
            wagon
            train_car
            ship
            building
                residential_building
                    manor
                    cottage
                    terrace
                        townhouse
                    tenement
                    farmhouse
                    chapel
                commercial_building
                    office
                    bank
                    newspaper
                    shop
                    barbershop
                    restaurant
                    pub
                    factory
                        warehouse
                    hotel
                    school
                    hospital
                    police_station
                    church
                    theatre
        pier
        bridge
            suspension_bridge
    part
        body_part
            head
            hand
                left_hand  (side left)
                right_hand (side right)
            finger
                ring_finger
            eye
            mouth    
        structure_part
            counter
                bar_counter
            wall
            opening (+ nav_passage)
                window
                door