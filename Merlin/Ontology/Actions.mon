
# NOTE: Words in parenthesis -- such as (traits) and (emo) -- are used for GROUPING only: they don't define a sub-category.

relation

    behaviour /noun

        # By convention, actions are ALL CAPS, and always written in the singular
        #
        # /noun = defines 'action' as a noun
        # For all subsequent definitions:
        # * Assume that they are actions: //action
        # * Assume that their subject field is is always a human: //sub human
        # * Assume that their target field is exclusive: //tar @excl
        #
        # IMPORTANT: Each action must use exactly ONE motor.
        action /noun //action //sub human //tar @excl

            READ                /read   /motor eyes
            PERCEIVE_ATTR       /obs    /motor eyes

            ASK                 /listen /motor mouth /uninterruptable /sub @msgAuthor /tar @qs @excl @S /aux @msgAudience
            TELL                /listen /motor mouth /uninterruptable /sub @msgAuthor /tar @msg @excl @S /aux @msgAudience

            CHAT                /obs /motor legs

            HANG_HEAD           /obs /motor head
            CRY_EXPR            /obs /motor face

            LEFT_ARM_OUT        /obs /motor left_arm    /sub human
            LEFT_ARM_BURY_FACE  /obs /motor left_arm    /sub human
            LEFT_REACH_FOR      /obs /motor left_arm    /sub human
            RIGHT_ARM_OUT       /obs /motor right_arm   /sub human
            RIGHT_ARM_BURY_FACE /obs /motor right_arm   /sub human
            RIGHT_REACH_FOR     /obs /motor right_arm   /sub human

            LEFT_GRASP          /obs /motor left_hand   /sub human
            RIGHT_GRASP         /obs /motor right_hand  /sub human
            WRITE_DOC           /obs /motor right_hand  /aux @msg @excl
            STACK_TAKE          /obs /motor right_hand
            STACK_PUT           /obs /motor right_hand
            MAKE_DONE_STACK     /obs /motor eyes

            TURN_TO         /obs /motor body
            MIRROR          /obs /motor body
            LOOK_AT         /obs /motor head

            WALK_TO         /obs /motor legs
            WALK            /obs /motor legs
            RUN             /obs /motor legs
            JUMP            /obs /motor legs
            SIT             /obs /motor legs
            STAND           /obs /motor legs
            HALT            /obs /motor legs

            # Expression actions (engine-driven, not Merlin-proposed)
            SMILE           /obs /motor face
            BLINK           /obs /motor eyes

            STAB            /obs /motor right_hand
            OFFER           /obs /motor right_hand
            # TAKE removed — replaced by take task (REACH_FOR + GRASP)
            STOW            /obs /motor mind
            PUT             /obs /motor right_hand
            POUR            /obs /motor right_hand
            WEAR            /obs /motor right_hand

            HAVE_SEX_WITH   /obs /motor legs /sub human /tar human
            GIVE_BIRTH      /obs /motor legs /sub human
            DIE             /obs /motor legs /sub human

            # Meta-entity actions are imperceptible
            MAKE_CONV_META_ENT      /motor mind /sub human
            DESTROY_CONV_META_ENT   /motor mind /sub human
            START_PERFORMING        /motor mind /tar activity /sub human
            STOP_PERFORMING         /motor mind /tar activity /sub human

            CLAIM_TRANSACTION_STATION   /motor mind
            SET_PROVIDER_OCCUPIER_SLOT  /motor mind

            # These are a bit hacky
            ACQUIRE                 /motor mind
            SPAWN                   /motor mind
