
# Abstract concepts

concept
    nothing
    something
    someone

    # Weather components. rain/snow/fog/wind carry a strength_measurement;
    # sky carries a sky_condition.
    weather             /obs /tar @excl
        rain            /tar @excl strength_measurement
        snow            /tar @excl strength_measurement
        fog             /tar @excl strength_measurement
        wind            /tar @excl strength_measurement
        sky             /tar @excl sky_condition
        thunder         /obs /tar @excl strength_measurement
        temperature     /obs /tar @excl

    phrase
        yes
        no

    # Sidedness. Used by sided actions (REACH_FOR, GRASP, ARM_DRINK, ...) to
    # designate which arm/hand engages. The (side ?x) rule-function evaluates
    # to one of these by reading /side off the symbol's kind.
    side
        left  /side left
        right /side right

    availability        /sub building /tar @excl
        for_sale
        for_rent
        off_the_market

    rights
        property        /sub being

    condition           /tar @excl
        alive
        dead

    alertness           /tar @excl
        alert
        sleepy

    death_cause         /tar @excl
        disease
        accident
        old_age
        childbirth
        violence

    # Region mood components (the mood_kinds attr is plural - a region carries
    # several at once, so no @excl).
    mood
        anti_aristocratic
        anti_outsider
        plague_fear
        pro_reform
        war_weariness

    # Hereditary interests (the interests attr is plural - no @excl).
    interests
        music
        theatre
        literature
        riding
        history
        science
        spiritualism
        religion
        antiques
        sports
        suffrage

    living_arrangement  /sub human /tar ? @excl
        owner           /tar human|org @excl
        houseguest
        renting

    status              /tar ? @excl
        examined
        accepted
        rejected

    capacity            /tar ? @excl
        pub_patron

    activity
        bartending
        
    org_pos
        apprenticeship
        membership          /sub human
        job                 /sub human
            editor
            printer
            journalist
            banker
            landlord
            industrialist
            principal
            merchant
            apothecary
            proprietor
            solicitor
            physician
            priest
            clerk
            teacher
            engineer
            surgeon
            typist
            barber
            gardener
            cook
            farmer
            nurse
            shop_clerk
            waiter
            maid
            bartender
            factory_worker
            house_agent


    # level grades a human, or a job / org_pos. A trainee clerk is
    # {@self job ?j} + {?j level trainee}.
    level               /sub human|org_pos /tar @excl
            trainee
            apprentice
            junior
            regular
            senior
            org_head
    unit
        social
            family          /sub human /tar @excl /def @unknown
    movement
        political
            suffrage
    org
        edu
            apprenticeship
            private_school
            state_school
            university
        gov
            church
            hospital
            agency
                land_registry
                company_registry
        com
            club
                athletic
                    race_club
                    rugby_union
            business
                factory
                bank
                shipping_agent
                insurance_co
                solicitor_firm
                house_agency
                newspaper
                pawnbroker
                hotel
                restaurant
                bookseller
                grocer
                pub
                apothecary
                barbershop
                antiques_shop
                theatre

    # Fields of study - the target of the `study` and `diploma` relations.
