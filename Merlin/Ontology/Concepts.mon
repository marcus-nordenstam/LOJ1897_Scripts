
# Abstract concepts

concept
    nothing
    something
    someone

    # Weather components. rain/snow/fog/wind carry a strength_measurement;
    # sky carries a sky_condition.
    weather             /obs /tar @excl
        rain            /tar @excl strength_measurement
        snow            /tar @excl strength_measurement
        fog             /tar @excl strength_measurement
        wind            /tar @excl strength_measurement
        sky             /tar @excl sky_condition
        thunder         /obs /tar @excl strength_measurement
        temperature     /obs /tar @excl

    phrase
        yes
        no

    # Sidedness. Used by sided actions (REACH_FOR, GRASP, ARM_DRINK, ...) to
    # designate which arm/hand engages. The (side ?x) rule-function evaluates
    # to one of these by reading /side off the symbol's kind.
    side
        left  /side left
        right /side right

    availability        /sub building /tar @excl
        for_sale
        for_rent
        off_the_market

    rights
        property        /sub being

    condition           /tar @excl
        alive
        dead

    alertness           /tar @excl
        alert
        sleepy

    death_cause         /tar @excl
        disease
        accident
        old_age
        childbirth
        violence

    # Region mood components (the mood_kinds attr is plural - a region carries
    # several at once, so no @excl).
    mood
        anti_aristocratic
        anti_outsider
        plague_fear
        pro_reform
        war_weariness

    # Hereditary interests (the interests attr is plural - no @excl).
    interests
        music
        theatre
        literature
        riding
        history
        science
        spiritualism
        religion
        antiques
        sports
        suffrage

    living_arrangement  /sub human /tar ? @excl
        owner           /tar human|org @excl
        houseguest
        renting

    status              /tar ? @excl
        examined
        accepted
        rejected

    capacity            /tar ? @excl
        pub_patron

    activity
        bartending
        
    org_pos
        apprenticeship
        membership          /sub human
        job                 /sub human
            editor
            printer
            journalist
            banker
            landlord
            industrialist
            principal
            merchant
            apothecary
            proprietor
            solicitor
            physician
            priest
            clerk
            teacher
            engineer
            surgeon
            typist
            barber
            gardener
            cook
            farmer
            nurse
            shop_clerk
            waiter
            maid
            bartender
            factory_worker
            house_agent


    level               /sub human /tar @excl
            apprentice
            junior
            regular
            senior
            org_head
    unit
        social
            family          /sub human /tar @excl /def @unknown
    movement
        political
            suffrage
    org
        edu
            apprenticeship
            private_school
            state_school
            university
        gov
            church
            hospital
            agency
                land_registry
                company_registry
        com
            club
                athletic
                    race_club
                    rugby_union
            business
                factory
                bank
                shipping_agent
                insurance_co
                solicitor_firm
                house_agency
                newspaper
                pawnbroker
                hotel
                restaurant
                bookseller
                grocer
                pub
                apothecary
                barbershop
                antiques_shop
                theatre
    message
        declaration
        property_description
        article
        advert
        chapter
    payment
        wage
        annual_wage
    
    sky_condition
        clear
        overcast
        cloudy

    strength_measurement
        none
        light
        medium
        heavy

    mass_measurement
        weight
    
    personality_trait
        charisma            /tar @excl
            dull
            regular
            charismatic
        passion             /tar @excl
            dispassionate
            neutral
            passionate
        romanticism         /tar @excl
            unromantic
            romantic
        sexual_orient       /tar @excl
            hetero
            bi
            homo

    cultural_aspect
        title
        class_situation     /sub human /tar @excl
            upper
            middle
            lower
        nationality         /sub human /tar @excl
            english
            irish
            st_revieran
            french

    physical_quality
        color               /tar @excl
            blue
            brown
            green
            grey
            hazel
            black
            red
            auburn
            blonde
            white
        gender              /tar @excl
            male
            female
        appearance          /tar @excl
            ugly
            plain_looking
            beautiful
        girth               /tar @excl
            thin
            medium
            fat
        height              /tar @excl
            short
            medium
            tall

    blood_type          /obs /tar @excl
        A
        B
        AB
        O

    role                /tar @excl
        player
        nonplayer

    # ---------------------------------------------------------------------
    # Relational states migrated from States.mon - a noun is a state, so each
    # is declared once, here. (States.mon now holds only non-noun verb states.)
    # ---------------------------------------------------------------------

    # Transaction spots and stack-system states.
    actor_spot          /obs /tar location @excl
    counterpart_station /obs /tar @excl
    price               /tar @excl
    item                /obs /tar object
    from_stack          /obs /sub object /tar @excl stack
    view                /obs /sub human /tar @excl object
    mail_stack          /obs /sub space|structure /tar @excl stack
    done_stack          /obs /sub stack /tar @excl stack

    # Kinship and social bonds - subject and target are both human.
    person_role         //sub human //tar human
        parent
        mother          /tar @excl
        father          /tar @excl
        brother
        sister
        sibling
        half_sibling
        grandmother     /tar @excl
        grandfather     /tar @excl
        grandparent
        grandchild
        aunt
        uncle
        niece
        nephew
        cousin
        mother_in_law   /tar @excl
        father_in_law   /tar @excl
        parent_in_law
        sister_in_law
        brother_in_law
        sibling_in_law
        daughter_in_law
        son_in_law
        child_in_law
        stepmother      /tar @excl
        stepfather      /tar @excl
        stepchild
        child
        spouse          /tar @excl
        fiancee         /tar @excl
        lover
        friend
        acquaintance
        neighbour
        close_to
        relied_on_by
        respected_by
        enemy
        marriage_desirability   /tar ? @excl
        love                    /tar ?
        reputation              /tar ? @excl
        deceased                /tar ? @excl
        deceased_year           /tar ? @excl

    birthplace          /sub human /tar structure @excl

    # Vocational / educational / societal states (subject is a human).
    vocational_state    //sub human
        marital_state       /tar @excl /def @unknown
        training_pos        /tar org_pos @excl
        time_of_retirement  /tar ? @excl
        home                /tar structure @excl
        # Work life-cycle. job and level are noun-states (declared in the
        # org_pos / level taxonomy higher up); only the non-noun relations
        # are declared here. employer is the worker's org; apprenticed_to is
        # the master a youth trains under.
        employer            /tar org @excl
        apprenticed_to      /tar human @excl
        # Education life-cycle. pupil_of is the pupil's school; schooling is
        # the schooling-level outcome left behind when the pupil leaves.
        pupil_of            /tar org @excl
        schooling           /tar ? @excl

    # Property holdings (subject owns them).
    holding_state       //sub property
        buildings           /tar [structure]
        lands               /tar [space]

    # States describing an organisation (subject is the org mental object).
    # employee is repeated once per worker; record points at the org's
    # articles_of_incorporation document.
    org_state           //sub org
        informal_name       /tar ? @excl
        founder             /tar human @excl
        head_pos            /tar org_pos @excl
        founding_year       /tar ? @excl
        workplace           /tar space|structure @excl
        workplace_kind      /tar ?
        employee            /tar human
        vacant_job          /tar job
        record              /tar document @excl
        diploma             /tar ? @excl

    # States describing an activity-object.
    activity_state
        participant         /tar human
        todo                /tar task
