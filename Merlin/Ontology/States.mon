
# NOTE: Words in parenthesis -- such as (traits) and (emo) -- are used for GROUPING only.
#
# States that correspond to env attrs are auto-registered from attr definitions in .arc files.
# Only states WITHOUT a corresponding attr are defined here.

relation

    state //state

        # Sounds may hold spoken messages
        speech                  /hear /sub sound @msg

        # Environmental states
        weather                 /obs /tar @excl weather
        thunder                 /obs /tar @excl strength_measurement
        temperature             /obs /tar @excl

        # Spatial states (not directly from attrs)
        within_reach_of         /tar object|space
        facing                  /tar object|space

        # Physical states not from attrs
        wound                   /obs /tar
        blood_stain              /obs /tar
        blood_type               /obs /tar @excl

        # Transaction system states (not from attrs)
        actor_spot              /obs /tar location @excl
        staging_spot            /obs /tar location @excl
        counterpart_station     /obs /tar @excl

        # Abstract states
        know                    /sub human              /tar @S
        price                   /sub ?                  /tar @excl
        possess                 /sub human              /tar object
        expect_answer           /sub human              /tar ?
        expect_question         /sub human              /tar ?
        status                  /tar ? @excl
        talk_to                 /sub human

        # Stack states not from attrs
        item                    /obs /tar object
        from_stack               /obs /sub object         /tar @excl stack
        view                    /obs /sub human          /tar @excl object
        stack                   /obs /sub space|structure    /tar @excl stack
        mail_stack               /obs /sub space|structure    /tar @excl stack
        done_stack               /obs /sub stack              /tar @excl stack

        # Special states
        must_found_org            /sub human          /tar org

        # Emotional states
        (emo)                   //sub human
            likes               /tar [?]
            hates               /tar [?]
            # Directed attitudes - per-NPC beliefs about another person.
            distrusts           /tar human
            jealous_of          /tar human
            admires             /tar human
            envies              /tar human
            respects            /tar human
            fears               /tar human
            enemy               /tar human
            # Undirected emotional state - probability/intensity carried in
            # the belief itself; Salience drives decay over time.
            feels_joy
            feels_grief
            feels_anger
            feels_fear
            feels_shame
            feels_envy
            feels_pride

        # Relationships with others
        (social)                //sub human
            family              /sub human              /tar family @excl   /def @unknown
            parent              /tar human
            mother              /tar human @excl
            father              /tar human @excl
            brother             /tar human
            sister              /tar human
            # Sibling is asserted in parallel with brother/sister so that
            # "who are your siblings?" answers across genders. Half-siblings
            # get both sibling AND half_sibling.
            sibling             /tar human
            half_sibling        /tar human
            # Grandparents and their inverse. Grand{mother,father} are gendered
            # and exclusive at-a-time; grandparent/grandchild are the
            # ungendered plurals.
            grandmother         /tar human @excl
            grandfather         /tar human @excl
            grandparent         /tar human
            grandchild          /tar human
            # Aunts/uncles and their inverses. Gendered, non-exclusive
            # (you can have several aunts).
            aunt                /tar human
            uncle               /tar human
            niece               /tar human
            nephew              /tar human
            cousin              /tar human
            # In-laws acquired through marriage. propagate-in-laws asserts
            # these at marriage time on both sides.
            mother_in_law       /tar human @excl
            father_in_law       /tar human @excl
            parent_in_law       /tar human
            sister_in_law       /tar human
            brother_in_law      /tar human
            sibling_in_law      /tar human
            daughter_in_law     /tar human
            son_in_law          /tar human
            child_in_law        /tar human
            # Step-relations created when an NPC remarries and brings
            # children from a previous spouse.
            stepmother          /tar human @excl
            stepfather          /tar human @excl
            stepchild           /tar human
            spouse              /tar human @excl
            fiancee             /tar human @excl
            # Lover: non-exclusive (the model permits affairs alongside
            # marriage). Past lovers are represented by interval-ended
            # lover beliefs, not by a separate former_lover label.
            lover               /tar human
            child               /tar human
            # Friend / acquaintance / neighbour are SINGULAR. Multiple
            # friends are represented by multiple beliefs, not by a list
            # target.
            friend              /tar human
            acquaintance        /tar human
            neighbour           /tar human
            # Typed relationship bonds (F2.1). Warmth bonds (close_to) and
            # utility bonds (relied_on_by, respected_by) are independent - a
            # man can be widely relied upon yet close to no one. All
            # non-exclusive: repeated beliefs, one per partner. respected_by
            # is the inverse of (emo) respects.
            close_to            /tar human
            relied_on_by        /tar human
            respected_by        /tar human
            eligible_for_marriage
            marriage_desirability /tar @excl
            love                 /tar
            # Financial / inheritance audit trail.
            # owe: {debtor owe creditor <debt>} - debtor is the subject,
            # creditor the target. The auxiliary slot holds the debt - an
            # integer amount for a money debt, a debt mobject for a
            # non-money obligation. One owe belief per (debtor, creditor)
            # pair; the amount is updated in place.
            owe                 /tar human|org
            inherited_from      /tar human
            # Self-perceived public/material standing.
            reputation          /tar @excl
            # Awareness that another person has died. Asserted with the
            # deceased person as subject, in the minds of those who knew
            # them. Romantic-relationship beliefs (spouse, fiancee, lover)
            # toward the deceased are additionally interval-ended at the
            # time of death. Kinship beliefs (mother, father, sibling, ...)
            # stay ongoing — kinship does not end on death.
            deceased            /tar @excl
            deceased_year       /tar @excl
            # Self-identity belief: the structure the newborn was placed
            # in at birth (typically mother's home). The birth_date attr
            # (see common.arc) auto-registers its own belief label, so
            # {?p birth_date <date>} works without an explicit entry here.
            birthplace          /tar structure @excl

        # Vocational, legal, "societal" states
        (cultural)
            capacity            /tar ? @excl
            marital_state        /tar @excl              /sub human      /def @unknown
            class               /tar ? @excl            /sub human
            titles              /tar ?                  /sub human
            training_pos         /tar org_pos @excl       /sub human
            diplomas            /tar [?]                /sub human
            job                 /tar job                /sub human
            membership                                  /sub human
            hours               /tar ? @excl            /sub human
            time_of_retirement    /tar ? @excl            /sub human
            living_arrangement   /tar ? @excl            /sub human
            buildings           /tar [structure]        /sub property
            lands               /tar [space]            /sub property
            property            /sub being
            home                /tar structure @excl    /sub human
            owner               /tar human|org @excl

        # States describing a building
        (bldg)                  //sub building
            availability        /tar @excl

        # States used to describe a job
        (job)                   //sub job
            employer            /tar org @excl
            level               /tar @excl
            holder              /tar human @excl
            annual_wage          /tar @excl

        # States that describe an organisation
        (org)                   //sub org
            informal_name        /tar ? @excl
            founder             /tar human @excl
            head_prof_name        /tar ? @excl
            worker_prof_names     /tar ? [?]
            annual_revenue       /tar ? @excl
            rev_position_mult     /tar ? @excl
            start_time           /tar ? @excl
            app_stack            /tar ? @excl
            main_building        /tar ? @excl
            employees           /tar [human]
            jobs                /tar [job]
            head_pos             /tar ? @excl
            worker_jobs          /tar [job]
            vacant_job           /tar job
            memberships         /tar [membership]
            workplace           /tar space|structure @excl
            workplace_kind       /tar ?
            diploma             /tar ? @excl

        # States used to describe an activity-object
        (activity)
            participant         /tar human
            todo                /tar task

        # Historical-sim-only beliefs (hsim_ prefix). These are situations,
        # motives, and secrets the event engine reads to drive crime / drama
        # template eligibility and role binding. Pruned from NPC minds at
        # the historical -> interactive phase transition.
        (hsim)                  //sub human
            hsim_motive             /tar @excl
            hsim_has_affair_with    /tar human
            hsim_rival_courting_spouse  /tar human
            hsim_rival_blocks_courtship /tar human
            hsim_suspects_infidelity    /tar human
            hsim_secret_at_risk
            hsim_publicly_humiliated
            hsim_family_dishonored
            hsim_legacy_threatened
            hsim_class_resentful
            hsim_religious_zealot
            hsim_political_radical
            hsim_witness_to_suffering
            hsim_business_failing
            hsim_homeless
