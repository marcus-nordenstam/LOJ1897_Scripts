
# NOTE: Words in parenthesis -- such as (attitude) -- are used for GROUPING only.
#
# A noun IS a state (see Merlin/docs/knowledge_design_notes.md). Every noun
# declared in Concepts.mon / Objects.mon / etc. is automatically usable as a
# state, and env attrs contribute the physical realization. This file holds
# only the states that are NOT nouns: verb / predicate states (know, owe,
# like, hate, ...) and the historical-sim situation predicates.

relation

    state (+ state)

        # Spatial predicate states.
        within_reach_of         (tar object|space)
        facing                  (tar object|space)

        # to believe that someone ELSE knows something; theory-of-knowledge
        know                    (sub human)           (tar @S)

        # avoid: a held aversive state w.r.t. an embedded task pattern,
        # a substance, a person, a place, or any other symbol. Composes
        # with task patterns to express "subject is in the avoid-state
        # of X": {son avoid {son marry girl}} means son is currently
        # refraining from / disinclined toward the marry-girl task.
        # {witness avoid {witness tell secret}} expresses the silenced-
        # witness state. {actor avoid alcohol} expresses sobriety as a
        # held aversion to a substance. Persists across intervals; ends
        # when the avoiding circumstance lifts. Causes (the reason
        # the subject avoids the thing) ride the /causes slot, not a
        # sub-kind. Read by deliberation (an actor's standing avoid-
        # beliefs suppress branches that would put them in the avoided
        # state) and by `urge` (the task that argues a target into an
        # avoid-state).
        avoid                   (sub human)           (tar ?)

        # transient_marker - generic short-lived self-belief with
        # per-mint decay. One unified state replacing four scattered
        # patterns: recent_incident cooldowns (PR-A bonded /
        # public incidents), stalk_target prep markers (PR-B
        # perpetration), administering progress trackers (PR-C
        # drugging / slow poisoning), and practice tickers
        # (PR-skill-life atrophy suppression). Sub-kinds declared as
        # `marker_kind` in Concepts.mon. Non-@excl: an actor may
        # hold many concurrently - one per (kind, focus) pair, where
        # the aux slot carries the focus (the other party, the
        # domain, the substance). Minted via
        # `shared_functions/markers::mint_transient_marker(actor,
        # kind, focus, decay_days)`; checked via
        # `has_recent_marker(actor, kind, focus, max_age_days)`. The
        # belief interval start is the mint time; the decay rate is
        # encoded as a salience cap at mint time, so
        # pattern_decay drops the belief naturally once the window
        # elapses.
        transient_marker        (sub human)           (tar marker_kind)  (aux ?)

        expect_answer           (sub human)           (tar ?)
        expect_question         (sub human)           (tar ?)
        talk_to                 (sub human)

        # Attitudes - persistent dispositions toward a person, object or
        # fact. These are the DRIVERS of emotion, not emotions themselves:
        # emotions are transient affective states, declared as the `emotion`
        # noun-taxonomy in Concepts.mon. //appraisal_input marks the whole
        # block as context the appraisal categorizer consults. See
        # Docs/emotion_sim_plan.md.
        (attitude)              (+ sub human)  (+ appraisal_input)
            # like / hate may target a person, an object, OR a fact (@S).
            like                (tar ? @S)
            hate                (tar ? @S)
            admires             (tar human)
            respects            (tar human)
            distrusts           (tar human)
            # value: a held virtue - the identity / values appraisal input.
            value               (tar ?)
            # justify: a held cognitive narrative that frames a past or
            # planned act as acceptable (plan section 10.3-AFFECT item E).
            # Target is a `narrative` kind ({@self justify they_deserved_it
            # /aux <victim>}). Pre-perpetration deliberation events mint
            # justify on the chosen harmful branch as the actor commits;
            # post-perpetration the actor-POV reaction row mints it when
            # moral_violation pressure crosses threshold. Each held
            # justification discounts inhibition (item D's classifier) so
            # the second bar is lower than the first - the rationalization
            # feedback loop that turns a one-off crime into a habit.
            # Detective-gameplay payoff: a guilty NPC's justify beliefs are
            # queryable through normal interrogation.
            justify             (tar narrative)
            # infatuation: obsessive directed attraction; distinct from
            # like / love. Read by the appraise_obsession deliberation
            # and by opportunity events that gate on standing
            # infatuation (a tail_through_streets recurrence biased
            # toward target's location).
            infatuation         (tar human)
            # identity: the salient role(s) an NPC self-identifies as
            # (parent / spouse / worker / christian / ...). Each
            # identity is a held belief that biases categorize
            # thresholds, deliberate affinities, and the
            # justify-narrative pick. Non-@excl: an NPC may hold
            # multiple identities simultaneously; their composite is
            # the "I am X first" weighting. Derived from substrate
            # state in hsim_derive::classify_identities (kids -> parent,
            # job -> worker, ...); explicit identity-adoption events
            # may extend the set.
            identity            (tar role)

        # Construals are tags, not beliefs. Each construal is one of
        # the construed_act sub-kinds in Concepts.mon (wrong_act,
        # harm_act, betray_act, etc.) declared on a task / ACTION;
        # categorize() reads the tag set on the anchor's label and
        # dispatches one reaction row per tag per POV. No construal
        # beliefs are minted; the anchor itself is the /causes link.

        # Semantic summaries (memory-system Phase 5 - Docs/memory_system_plan.md).
        # Distilled gists minted by fuse_old_memories when N routine episodes
        # sharing the same (theme, subject, target) accumulate. The peak-
        # intensity episode is retained as exemplar (in /causes); the rest
        # are forgotten. Authored here as ordinary verb-states so they
        # render through the existing NLG / belief-recall paths. Each one
        # is named in a (theme ...) clause on the underlying episode
        # relations below. Appraisal_input - a held "X is rude to me"
        # influences future categorization of X's acts.
        (semantic_summary)      (+ sub human)  (+ appraisal_input)
            rude_to             (tar human)
            violent_to          (tar human)
            thief_to            (tar human)
            coercive_to         (tar human)

        # Social predicate states. The noun-form social roles (mother,
        # friend, spouse, ...) are noun-states declared in Concepts.mon.
        (social)                (+ sub human)
            # The three independent axes of "having a thing":
            # (a) Legal - own / lease / rent / borrow (verb-states below).
            # (b) Physical control - env attrs on body-parts and
            #     containers (controlled_by / wear / in_stack); the
            #     derived (hold ?actor ?thing) rule-function walks the
            #     body-part chain to the actor.
            # (c) Physical access - the derived (access ?actor ?thing)
            #     = hold OR (recent position-belief AND nav-path-exists).
            # Welcome is a separate axis (may_use / welcome_at). Derived
            # rule-functions live in shared_functions/possession.
            #
            # own: legal ownership. Subject is the owner; target is the
            # owned thing (movable prop, building, space). Authored by
            # `.hse` transactions (BuyBuilding, inheritance) and by
            # reading documents (title_deed) whose writings encode the
            # legal fact.
            own                 (tar object|space|structure)
            # hold: physical control - what the actor currently has in
            # hand / on body / in carried containers (via body-part
            # chain). Dual purpose: goal-target verb-state
            # ({@self goal {@self hold ?t}}) AND name of the derived
            # predicate `(hold ?actor ?thing)`. When the predicate
            # matches a standing goal, the engine ends the satisfied
            # belief. Distinct from the body-part env attr `control`
            # (common.arc), which is the ground-truth primitive the
            # hold predicate walks.
            hold                (tar object)
            # lease: premises rental. Subject is the lessee, target is
            # the leased premises (building / space), aux is the lessor.
            # Interval-ends on lease expiry / termination.
            lease               (tar structure|space)  (aux human|org)
            # rent: movable-prop rental (carriage, horse, tools). Distinct
            # from lease by target kind (object vs space). Aux is the
            # lessor.
            rent                (tar object)           (aux human|org)
            # borrow: free loan, no payment. Interval-ends on return.
            # Aux is the lender.
            borrow              (tar object)           (aux human|org)
            # sell: shopkeeper's memory of an over-the-counter purchase.
            # Subject is the seller (a clerk / shopkeeper, or in some
            # cases the shop org itself); target is the item (a specific
            # weapon entity or a leaf-kind reference); aux is the buyer.
            # Minted by hsim::acquire_weapon in purchase mode; the
            # belief decays under normal forgetting so "if recent" the
            # shopkeeper still remembers, but a years-stale sale fades.
            sell                (sub human|org)  (tar object)  (aux human)
            # owe: {debtor owe creditor <debt>} - debtor is the subject,
            # creditor the target. The auxiliary slot holds the debt - an
            # integer amount for a money debt, a debt mobject for a non-money
            # obligation. One owe belief per (debtor, creditor) pair; the
            # amount is updated in place.
            owe                 (tar human|org)
            # inherit: {heir inherit <estate> <benefactor>} - target is the
            # estate / thing inherited, auxiliary is the benefactor.
            inherit             (tar ?)               (aux human)
            # member_of: club / society membership - distinct from employment
            # (`employer`). Non-exclusive: an NPC may join several.
            member_of           (tar org)
            # participant: the roster of a game OBJECT - {<game> participant
            # <person>}. Subject is the game (overriding the block's human
            # default), target a co-player. The inverse, player-side belief is
            # {@self play <game>} (Tasks.mon); the two are wired symmetrically
            # per-mind, like family membership.
            participant         (sub game)  (tar human)
            # dwell / work are activity-lane TASKS, not states - they live in
            # Tasks.mon ({@self dwell <home>} / {@self work <org>}).
            # backed_by: an investor who has put up founding capital for this
            # NPC's venture (the investment event). Subject is the backed
            # party, target the investor. Non-exclusive - a venture may have
            # several backers.
            backed_by           (tar human)
            # heir_of: {heir heir_of benefactor} - prospect, non-@excl
            # (an estate may name multiple heirs). Parallel to fiancee
            # (prospect for marriage). Distinct from the past-tense
            # `inherit` event minted when the benefactor dies.
            # Disinheritance during life ends the heir_of belief; the
            # death-triggered conversion in mortality .hse turns
            # surviving heir_of into inherit.
            heir_of             (tar human)
            # captor_of: {captor captor_of victim} - kidnap-in-progress
            # relationship. Ended by release / escape / mortality.
            captor_of           (tar human)
            # circumstances_of_death: {victim circumstances_of_death
            # <incident>} - the cause-of-death narrative witnesses
            # form when perceiving a death scene. F2 gossip carries it
            # village-wide so the staged story crystallizes. @excl -
            # one held narrative per observer per victim.
            circumstances_of_death  (tar incident @excl)

        # Competence - the domains an NPC is practically skilled in. Targets a
        # `domain` kind (Concepts.mon): the academic_field disciplines (classics,
        # medicine, accountancy), the martial / illicit competences
        # (marksmanship, forgery), the performance_art / athletics skills, etc.
        # The earned-competence band of the unified domain axis (interest ->
        # skilled_in -> calling). The /aux holds a `competence_level`
        # (novice / trained / expert); absent /aux is treated as novice.
        # Non-exclusive: an NPC may be skilled in several domains; each is its
        # own belief.
        (competence)            (+ sub human)
            skilled_in          (tar domain)  (aux ?)

        # Achievements - sporting / competitive participation and victories.
        # Targets stay unconstrained until the Phase 6 sports events pin the
        # event / trophy kinds. Non-exclusive: a life accumulates many.
        (achievement)           (+ sub human)
            participated_in     (tar ?)
            won                 (tar ?)

        # Zero-sum outcome records. NOT tasks - act-RECORDS minted by
        # classifiers from base substrate facts (`{actor hired_at ?org}`,
        # `{actor spouse ?partner}`, `{actor own ?lot_won_at_auction}`)
        # when the substrate shows a competing patient. The tag drives
        # the patient's rivalry_pressure via the reaction cascade.
        (rivalrous_outcome)     (+ sub human)  (+ appraisal_input)
            # outdo: actor positionally outcompetes patient (won a post
            # the patient applied for; outbid them at auction; married
            # the partner they courted).
            outdo               (tar human)  (aux ?)  (construed_act rivalrous_act)

        # Acquired interior drives (F4.3). A drive is neither an emotion nor a
        # heritable temperament - it is deposited by a life of events and then
        # shapes which events cast the NPC.
        #   interest - the casual-pull band of the unified `domain` axis
        #     (interest -> skilled_in -> calling): an NPC is drawn to a domain
        #     without (yet) practising it. {@self interest <domain>}. Seeded
        #     hereditary in mx_make_human + grown / shed by interest_acquired /
        #     interest_lost. Non-exclusive. (Was a noun-kind doubling as a label
        #     before the PR-skill-life domain collapse; now an explicit
        #     verb-state so the label keeps validating its domain targets.)
        #   calling - the life-organising band: a drive toward a `domain`, seeded
        #     once in childhood for a minority of NPCs and never lost by
        #     interest_lost. @excl - one overriding calling ({@self calling
        #     music} / {@self calling engineering}). Drives event-casting and
        #     feeds the `purpose` felt-life dimension.
        #   craving - an acquired compulsive drive (addiction to drink); durable
        #     - reform resists it, never erases it - and non-exclusive (an NPC
        #     may crave more than one thing). The target is the craved substance
        #     kind: {@self craving alcohol}.
        (drive)                 (+ sub human)
            interest            (tar domain)
            calling             (tar domain @excl)
            craving             (tar ?)
            # life_aim - the existential-frame drive: what the NPC
            # wants their LIFE to amount to. Target is a life_aim kind
            # (legacy_aim / wealth_aim / piety_aim / respectability_aim
            # / autonomy_aim / power_aim / belonging_aim). Distinct
            # from calling (DOMAIN: music / engineering / soldiering)
            # and from craving (substance-targeted compulsion). DERIVED
            # by hsim_derive::classify_life_aim annually from substrate
            # (Big Five + Dark Tetrad + class trajectory + bond counts
            # + worship); never minted by events. Feeds the
            # LIFE_AIM_ALIGN factor in the unified weight formula used
            # by deliberation / perpetration / incident outcome
            # selectors. NOT @excl - the classifier explicitly ends the
            # prior dominant belief with k_unforgettable salience on a
            # qualitative shift, so multi-decade life_aim history is
            # queryable as repeated {@self life_aim ?} beliefs with
            # non-overlapping intervals. See PR-aim-history.
            life_aim            (tar life_aim)

        # Derived dimensions (F3.2) - each a single numeric quality, computed
        # and cached by an F3.5 classifier, never authored by hand (the same
        # status as the derived {?thing age ?age}). @excl - one ongoing value
        # per subject; the value is a number, so /tar stays unconstrained.
        (dimension)             (+ sub human)
            # Conduct - all 0..100 by hsim_derive convention; the (range LO
            # HI) on each line is the canonical source for hse_engine's
            # (chance ...) static-bound analyser (no parallel hardcoded
            # table in C++ - data-driven from the .mon files).
            honesty             (tar ? @excl) (range 0 1)
            sobriety            (tar ? @excl) (range 0 1)
            piety               (tar ? @excl) (range 0 1)
            diligence           (tar ? @excl) (range 0 1)
            chastity            (tar ? @excl) (range 0 1)
            decorum             (tar ? @excl) (range 0 1)
            generosity          (tar ? @excl) (range 0 1)
            # Conduct-risk
            aggression          (tar ? @excl) (range 0 1)
            criminality         (tar ? @excl) (range 0 1)
            # disinhibition: the externalizing temperament - low industriousness
            # + low politeness + high volatility. The temperamental root of
            # impulsive / antisocial conduct; the drinking events read the
            # aspects directly, this caches the fused score for the F3 cascade
            # and the interview.
            disinhibition       (tar ? @excl) (range 0 1)
            # inhibition: the moral/conscientious brake (plan section
            # 10.3-AFFECT item D). Fuses Big Five aspects (politeness +
            # industriousness + compassion), F3 dimensions (piety + decorum -
            # disinhibition), held virtues, current stress, and held
            # rationalizations. Higher inhibition = less likely to cross moral
            # lines under pressure; deliberation events read this to weight
            # their forgive / confess / kill branches. The runaway feedback
            # loop is built in: stress lowers inhibition, lowered inhibition
            # makes a harm branch likelier to fire, the harm event mints
            # justify beliefs which further lower inhibition.
            inhibition          (tar ? @excl) (range 0 1)
            # Material
            wealth              (tar ? @excl) (range 0 1)
            income_security     (tar ? @excl) (range 0 1)
            # Standing
            prestige            (tar ? @excl) (range 0 1)
            breeding            (tar ? @excl) (range 0 1)
            influence           (tar ? @excl) (range 0 1)
            connectedness       (tar ? @excl) (range 0 1)
            # Physical / mental
            constitution        (tar ? @excl) (range 0 1)
            affliction          (tar ? @excl) (range 0 1)
            soundness           (tar ? @excl) (range 0 1)
            # Mind
            radicalism          (tar ? @excl) (range 0 1)
            education           (tar ? @excl) (range 0 1)
            # Felt life - contentment / agitation are the valence / arousal
            # halves of mood; their classifiers (F4.6) read emotion_sim_plan.md's
            # derive_mood. agitation is added by the emotion model.
            belonging           (tar ? @excl) (range 0 1)
            contentment         (tar ? @excl) (range 0 1)
            agitation           (tar ? @excl) (range 0 1)
            # stress: the salience-weighted aggregate of standing `pressure`
            # beliefs (plan section 10.3-AFFECT item F). Sibling to
            # contentment / agitation; written by derive_mood. 0..100. Read by
            # the inhibition classifier (item D) and the stress-biased
            # categorize() threshold (item G) - both produce the runaway
            # feedback loop that turns simmering pressure into paranoid
            # construal and crime-decision motivation.
            stress              (tar ? @excl) (range 0 1)
            purpose             (tar ? @excl) (range 0 1)
            autonomy            (tar ? @excl) (range 0 1)
            # Rootedness in the community - tenure, employer, property, kin,
            # club memberships. The life_satisfaction band classifier reads
            # it to distinguish a LONER (low life_sat with high rootedness:
            # established but solitary by character) from an ADRIFT drifter
            # (low life_sat with low rootedness: newly arrived, no anchor).
            rootedness          (tar ? @excl) (range 0 1)

        # Historical-sim-only situation predicates (hsim_ prefix). Read by the
        # event engine to drive crime / drama template eligibility and role
        # binding. Pruned from NPC minds at the historical -> interactive
        # phase transition.
        (hsim)                  (+ sub human)
            hsim_motive             (tar @excl)
            hsim_secret_at_risk
            hsim_publicly_humiliated
            hsim_family_dishonored
            hsim_legacy_threatened
            hsim_class_resentful
            hsim_religious_zealot
            hsim_political_radical
            hsim_witness_to_suffering
            hsim_business_failing
            hsim_homeless
