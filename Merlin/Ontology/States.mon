
# NOTE: Words in parenthesis -- such as (attitude) -- are used for GROUPING only.
#
# A noun IS a state (see Merlin/docs/knowledge_design_notes.md). Every noun
# declared in Concepts.mon / Objects.mon / etc. is automatically usable as a
# state, and env attrs contribute the physical realization. This file holds
# only the states that are NOT nouns: verb / predicate states (know, owe,
# like, hate, ...) and the historical-sim situation predicates.

relation

    state (+ state)

        # Spatial predicate states.
        within_reach_of         (tar object|space)
        facing                  (tar object|space)

        # to believe that someone ELSE knows something; theory-of-knowledge
        know                    (sub human)           (tar @S)

        # `possess` was retired by PR-poss-A 2026-05-25 - the label
        # overloaded "wants to physically have," "legally owns," and "is
        # welcome to use" into one symbol. Goal callers migrated to
        # `control` (in (social) below); legal callers to `own` / `lease` /
        # `rent` / `borrow`; permission to the derived `may_use` /
        # `welcome_at` rule-functions in shared_functions/possession.
        expect_answer           (sub human)           (tar ?)
        expect_question         (sub human)           (tar ?)
        talk_to                 (sub human)

        # Attitudes - persistent dispositions toward a person, object or
        # fact. These are the DRIVERS of emotion, not emotions themselves:
        # emotions are transient affective states, declared as the `emotion`
        # noun-taxonomy in Concepts.mon. //appraisal_input marks the whole
        # block as context the appraisal categorizer consults. See
        # Docs/emotion_sim_plan.md.
        (attitude)              (+ sub human)  (+ appraisal_input)
            # like / hate may target a person, an object, OR a fact (@S).
            like                (tar ? @S)
            hate                (tar ? @S)
            admires             (tar human)
            respects            (tar human)
            distrusts           (tar human)
            # value: a held virtue - the identity / values appraisal input.
            value               (tar ?)
            # justify: a held cognitive narrative that frames a past or
            # planned act as acceptable (plan section 10.3-AFFECT item E).
            # Target is a `narrative` kind ({@self justify they_deserved_it
            # /aux <victim>}). Pre-perpetration deliberation events mint
            # justify on the chosen harmful branch as the actor commits;
            # post-perpetration the actor-POV reaction row mints it when
            # moral_violation pressure crosses threshold. Each held
            # justification discounts inhibition (item D's classifier) so
            # the second bar is lower than the first - the rationalization
            # feedback loop that turns a one-off crime into a habit.
            # Detective-gameplay payoff: a guilty NPC's justify beliefs are
            # queryable through normal interrogation.
            justify             (tar narrative)
            # infatuation: obsessive directed attraction, distinct from the
            # existing like / love (Phase 10 Phase C). Read by the
            # appraise_obsession deliberation (10.3h) and by opportunity
            # events that gate on standing infatuation (a
            # tail_through_streets recurrence biased toward target's
            # location).
            infatuation         (tar human)
            # identity: the salient role(s) an NPC self-identifies as
            # (parent / spouse / worker / christian / ...). Plan section
            # 10.3 Pivot C (2026-05-24). Each identity is a held belief that
            # biases categorize thresholds, deliberate affinities, and the
            # justify-narrative pick. Non-@excl: an NPC may hold multiple
            # identities simultaneously; their composite is the "I am X
            # first" weighting. Derived from substrate state in
            # hsim_derive::classify_identities (kids -> parent, job ->
            # worker, ...); future PRs add explicit identity-adoption
            # events.
            identity            (tar role)

        # Construals are no longer a parallel vocabulary - each construal is
        # one of the construed_act sub-kinds in Concepts.mon (wrong_act,
        # harm_act, betray_act, etc.). categorize() mints a construal belief
        # whose label IS the relevant construed_act kind; apply_construal
        # looks up reaction rows keyed on that kind. The (construal) block
        # that used to live here (betray / wrong / help / honour / slight /
        # threaten / abandon / achieve / suffer_loss) is retired.

        # Social predicate states. The noun-form social roles (mother,
        # friend, spouse, ...) are noun-states declared in Concepts.mon.
        (social)                (+ sub human)
            # PR-poss-A 2026-05-25 - the three-axis split of the retired
            # `possess` label. See Docs/hsim_plan.md "possession / control
            # / access vocabulary." Each label below is one of the three
            # ownership / control / leasing axes; the derived
            # rule-functions (control, control_any, access, may_use,
            # welcome_at) live in shared_functions/possession.
            #
            # own: legal ownership. Subject is the owner; target is the
            # owned thing (movable prop, building, space). Authored by
            # `.hse` transactions (BuyBuilding, inheritance) and by
            # reading documents (title_deed) whose writings encode the
            # legal fact. Replaces the pre-PR-poss-A `{?bldg owner ?h}`
            # noun-state pattern (owner stays declared in Concepts.mon
            # only as a `living_arrangement` sub-kind; the base legal
            # fact is now `{?h own ?bldg}`).
            own                 (tar object|space|structure)
            # hold: physical control - what the actor currently has in
            # hand / on body / in carried containers (via body-part chain).
            # Dual purpose: goal-target verb-state ({@self goal {@self
            # hold ?t}}) AND name of the derived predicate `(hold ?actor
            # ?thing)`. When the predicate matches a standing goal, the
            # engine ends the satisfied belief.
            #
            # Named `hold` instead of `control` to avoid colliding with
            # the existing body-part env attr `control` (common.arc:35,
            # which auto-registers a body-part-subject noun-state with
            # the same name read by ~14 .mc files via {?hand control
            # ?thing}). The plan originally proposed `control`; this is
            # the substrate-constrained equivalent.
            hold                (tar object)
            # lease: premises rental. Subject is the lessee, target is
            # the leased premises (building / space), aux is the lessor.
            # Interval-ends on lease expiry / termination.
            lease               (tar structure|space)  (aux human|org)
            # rent: movable-prop rental (carriage, horse, tools). Distinct
            # from lease by target kind (object vs space). Aux is the
            # lessor.
            rent                (tar object)           (aux human|org)
            # borrow: free loan, no payment. Interval-ends on return.
            # Aux is the lender.
            borrow              (tar object)           (aux human|org)
            # owe: {debtor owe creditor <debt>} - debtor is the subject,
            # creditor the target. The auxiliary slot holds the debt - an
            # integer amount for a money debt, a debt mobject for a non-money
            # obligation. One owe belief per (debtor, creditor) pair; the
            # amount is updated in place.
            owe                 (tar human|org)
            # inherit: {heir inherit <estate> <benefactor>} - target is the
            # estate / thing inherited, auxiliary is the benefactor.
            inherit             (tar ?)               (aux human)
            # member_of: club / society membership - distinct from employment
            # (`employer`). Non-exclusive: an NPC may join several.
            member_of           (tar org)
            # frequents: a haunt the NPC visits often - a pub, a club.
            frequents           (tar structure|org)
            # backed_by: an investor who has put up founding capital for this
            # NPC's venture (the investment event). Subject is the backed
            # party, target the investor. Non-exclusive - a venture may have
            # several backers.
            backed_by           (tar human)
            # heir_of: {heir heir_of benefactor} - prospect, non-@excl (an
            # estate may name multiple heirs). Parallel to fiancee (prospect
            # for marriage). Distinct from the past-tense `inherit` event
            # which mints when the benefactor dies. Disinheritance during
            # life ends the heir_of belief; the death-triggered conversion
            # in mortality .hse turns surviving heir_of into inherit
            # (10.3d). Phase 10 Phase C.
            heir_of             (tar human)
            # captor_of: {captor captor_of victim} - the kidnap-in-progress
            # relationship. Ended by release / escape / mortality. Phase 10
            # Phase C; consumed by 10.3h kidnap lifecycle.
            captor_of           (tar human)
            # circumstances_of_death: {victim circumstances_of_death
            # <incident>} - the cause-of-death NARRATIVE witnesses form
            # when perceiving a death scene. F2 gossip carries it
            # village-wide so the staged story crystallizes. @excl - one
            # held narrative per observer per victim. Phase 10 Phase C.
            circumstances_of_death  (tar incident @excl)

        # Competence - the domains an NPC is practically skilled in. The target
        # is a field_of_study kind, which doubles as the competence taxonomy
        # (an NPC may be skilled in several - non-exclusive).
        (competence)            (+ sub human)
            skilled_in          (tar field_of_study)

        # Achievements - sporting / competitive participation and victories.
        # Targets stay unconstrained until the Phase 6 sports events pin the
        # event / trophy kinds. Non-exclusive: a life accumulates many.
        (achievement)           (+ sub human)
            participated_in     (tar ?)
            won                 (tar ?)

        # Appraisable behaviours - act-record beliefs the F3.5 classifier
        # cascade reads (Phase 8 / Step 8.1). A behaviour label lives here ONLY
        # when the behaviour has no ACTION (interactive/ACTIONS/*.act) and no
        # task (Tasks.mon) form - otherwise the classifier reads that existing
        # symbol. So `give` (a task) and `HAVE_SEX_WITH` (an ACTION) are NOT
        # re-declared here; only behaviours with no motor-enacted form are.
        (behaviour)             (+ sub human)
            # attend: {actor attend ?place} - the churchgoing seed event writes
            # it, the piety classifier reads it.
            attend              (tar structure|org)
            # play_game: {actor play_game ?game} - a game / gambling pastime.
            # Target stays unconstrained until the game taxonomy is pinned
            # (same convention as `won`).
            play_game           (tar ?)
            # Criminal act-records (plan section 10.3-AFFECT item J +
            # restructure). Each tag drives a reaction row in appraisal.hsc.
            # Multiple tags accumulate at appraisal time: the patient of an
            # embezzle gets both the appropriation_act reaction AND the
            # betray_act reaction AND the wrong_act reaction.
            assault             (tar human)       (construed_act harm_act wrong_act)
            # insult: lesser-affront act. Tagged slight_act so categorize
            # emits the slight_act construal and the patient-pov reaction
            # row in appraisal.hsc mints humiliation pressure on the
            # patient. The minimum-viable anchor for testing the pressure
            # cascade in vanilla hsim until richer perpetration content
            # lands.
            insult              (tar human)       (construed_act slight_act)
            # outdo: actor positionally outcompetes patient (won a post,
            # outbid them, married the partner they courted). Distinct
            # from insult (unprovoked affront) - this is a zero-sum
            # outcome. Tagged rivalrous_act so the patient picks up
            # rivalry_pressure via the appraisal.hsc reaction row.
            outdo               (tar human)  (aux ?)  (construed_act rivalrous_act)
            # kill - method (substance kind, weapon object, or _ for
            # unspecified) rides the aux. Phase 10 Phase C: relaxed from
            # /tar human alone so {clara kill ashcombe /aux digitalis} and
            # {clara kill ashcombe /aux bronze_bust} both fit one label
            # (Rule 4 of knowledge_design_notes - don't restate target kind
            # in label).
            kill                (tar human)  (aux ?)  (construed_act harm_act wrong_act)
            steal               (tar human)       (construed_act appropriation_act wrong_act)
            defraud             (tar human)       (construed_act appropriation_act wrong_act betray_act)
            embezzle            (tar human|org)   (construed_act appropriation_act wrong_act betray_act)
            kidnap              (tar human)       (construed_act coercion_act threaten_act wrong_act)
            # Phase 10 Phase C - additional Phase 10 act-records.
            # disinherit: testamentary act; its effect is to end the
            # target's heir_of belief. The dropped heir feels abandonment.
            disinherit          (tar human)       (construed_act abandonment_act wrong_act)
            # expose: public-disclosure act. Target is a fact (@S). The
            # fact's sensitivity band determines whether scandal_breaks
            # (10.3h) fires alongside.
            expose              (tar @S)          (construed_act expose_act betray_act wrong_act)
            # tamper: generic trap-setting act. The substance / sabotage
            # vector rides the aux. Not directly appraisable - it is the
            # PREPARATION for a perpetration; the trap-fire event mints
            # the appraisable kill / harm act-record when the trap fires.
            # So no construed_act tag here.
            tamper              (tar object)  (aux ?)
            # add_substance: PR-evi-C 2026-05-25 - canonical "this actor
            # added substance X to vessel Y" record. Subject is the
            # perpetrator; target is the substance entity (the poison /
            # contaminant); aux is the vessel (food / fluid entity).
            # Replaces the retired `tainted_with` env attr - all evidence
            # of what's in a vessel lives in beliefs (perpetrator's
            # band-5 self-belief plus any witnessing minds). Not
            # construed_act-tagged: preparation, like tamper.
            add_substance       (tar object)  (aux object)
            # recruit: conspiracy delegation. The recruiter holds
            # {perp recruit accomplice /aux <embedded-goal-fact>}; the
            # event-effect mints {accomplice goal {accomplice <act>
            # ?victim}} in accomplice's mind. Preparatory (the eventual
            # crime carries the appraisal), so no construed_act tag here.
            recruit             (tar human)  (aux ?)

            # Phase 10 Pivot A loop-closure (2026-05-24). Action labels for
            # every non-floor action atom in deliberation.hsc's affinity
            # table. The deliberate event mints {actor goal {actor <action>
            # <focus>}} - the inner clause uses one of these labels. They
            # are NOT yet construed_act-tagged - perpetration events in
            # follow-up PRs will commit copies as anchors and the tagging
            # decision lives with each anchor-producing event. kill /
            # assault / steal / defraud / embezzle / kidnap / disinherit /
            # expose / tamper / recruit above already cover the harm-act
            # side of the table; the labels below cover the rest of
            # deliberation.hsc's actions.
            confront_privately  (tar human)
            withdraw            (tar human)
            plead               (tar human)
            flee                (tar human)
            surrender           (tar human)
            mourn               (tar human)
            replace             (tar human)
            confess_letter      (tar human)
            confess_in_person   (tar human)
            atone               (tar human)
            silence_witness     (tar human)
            expose_first        (tar human)

            # PR-goal-A 2026-05-25 - additional goal / act-record labels
            # (dual: goal-target atoms in {actor goal {actor <label>
            # <focus>}} AND act-record labels minted by perpetration
            # terminals). Each unlocks a deliberation.hsc affinity row
            # plus one or more perpetration.hsc method rows.
            #
            # seduce: pursue a sexual relationship. Driven by infatuation
            # or attachment_loss-rebound. The resulting consummation
            # mints a `lover` bond; whether it's an affair is DERIVED
            # from spousal context (no separate label per
            # knowledge_design_notes.md rule against duplicate-by-
            # context labels).
            seduce              (tar human)   (construed_act intimacy_act)
            # humiliate: publicly degrade. Distinct from `expose` (which
            # reveals a TRUE secret) - humiliate can be insult / mockery
            # / orchestrated embarrassment without any prior wrong by
            # the target. Driven by humiliation pressure.
            humiliate           (tar human)   (construed_act slight_act wrong_act)
            # discredit: destroy reputation via lies / character
            # assassination / rumour. Distinct from `expose` because the
            # content may be false, and from `humiliate` because the
            # target is reputation specifically. betray_act-tagged
            # because the discreditor frequently uses inside information.
            discredit           (tar human)   (construed_act expose_act betray_act wrong_act)
            # bribe: corrupt someone via payment. Functional inverse of
            # coerce (extract compliance via threat vs cash). Aux holds
            # the requested act so the recipient's mind ends with
            # {recipient goal {recipient <requested-act> <focus>}} on
            # accept. No construed_act tag - bribe is the
            # MEANS-of-pressure, and the appraisable harm is whatever
            # gets done with the bought compliance.
            bribe               (tar human)   (aux ?)
            # frame: plant evidence to incriminate a third party. Severe
            # - the framed party may suffer the full appraisal weight
            # of the original crime. Aux carries the redirected crime
            # fact ({framer frame ?innocent /aux {?actual_perp <crime>
            # ?victim}} reads "framer makes innocent appear to be the
            # actor of the actual crime").
            frame               (tar human)   (aux ?)   (construed_act harm_act betray_act wrong_act)

        # Acquired interior drives (F4.3). A drive is neither an emotion nor a
        # heritable temperament - it is deposited by a life of events and then
        # shapes which events cast the NPC.
        #   calling - a life-organising drive toward a domain, seeded once in
        #     childhood for a minority of NPCs and never lost by interest_lost.
        #     @excl - one overriding calling. The target is that domain: an
        #     `interests` topic ({@self calling music}) or a `field_of_study`
        #     specialism ({@self calling engineering}). Drives event-casting and
        #     feeds the `purpose` felt-life dimension. (The plan's separate
        #     topic / specialism subtrees were dropped in Phase 5.2 - `interests`
        #     is the topic taxonomy, `field_of_study` the specialism one.)
        #   craving - an acquired compulsive drive (addiction to drink); durable
        #     - reform resists it, never erases it - and non-exclusive (an NPC
        #     may crave more than one thing). The target is the craved substance
        #     kind: {@self craving alcohol}.
        (drive)                 (+ sub human)
            calling             (tar interest|field_of_study @excl)
            craving             (tar ?)

        # Derived dimensions (F3.2) - each a single numeric quality, computed
        # and cached by an F3.5 classifier, never authored by hand (the same
        # status as the derived {?thing age ?age}). @excl - one ongoing value
        # per subject; the value is a number, so /tar stays unconstrained.
        (dimension)             (+ sub human)
            # Conduct
            honesty             (tar ? @excl)
            sobriety            (tar ? @excl)
            piety               (tar ? @excl)
            diligence           (tar ? @excl)
            chastity            (tar ? @excl)
            decorum             (tar ? @excl)
            generosity          (tar ? @excl)
            # Conduct-risk
            aggression          (tar ? @excl)
            criminality         (tar ? @excl)
            # disinhibition: the externalizing temperament - low industriousness
            # + low politeness + high volatility. The temperamental root of
            # impulsive / antisocial conduct; the drinking events read the
            # aspects directly, this caches the fused score for the F3 cascade
            # and the interview.
            disinhibition       (tar ? @excl)
            # inhibition: the moral/conscientious brake (plan section
            # 10.3-AFFECT item D). Fuses Big Five aspects (politeness +
            # industriousness + compassion), F3 dimensions (piety + decorum -
            # disinhibition), held virtues, current stress, and held
            # rationalizations. Higher inhibition = less likely to cross moral
            # lines under pressure; deliberation events read this to weight
            # their forgive / confess / kill branches. The runaway feedback
            # loop is built in: stress lowers inhibition, lowered inhibition
            # makes a harm branch likelier to fire, the harm event mints
            # justify beliefs which further lower inhibition.
            inhibition          (tar ? @excl)
            # Material
            wealth              (tar ? @excl)
            income_security     (tar ? @excl)
            # Standing
            prestige            (tar ? @excl)
            breeding            (tar ? @excl)
            influence           (tar ? @excl)
            connectedness       (tar ? @excl)
            # Physical / mental
            constitution        (tar ? @excl)
            affliction          (tar ? @excl)
            soundness           (tar ? @excl)
            # Mind
            radicalism          (tar ? @excl)
            education           (tar ? @excl)
            # Felt life - contentment / agitation are the valence / arousal
            # halves of mood; their classifiers (F4.6) read emotion_sim_plan.md's
            # derive_mood. agitation is added by the emotion model.
            belonging           (tar ? @excl)
            contentment         (tar ? @excl)
            agitation           (tar ? @excl)
            # stress: the salience-weighted aggregate of standing `pressure`
            # beliefs (plan section 10.3-AFFECT item F). Sibling to
            # contentment / agitation; written by derive_mood. 0..100. Read by
            # the inhibition classifier (item D) and the stress-biased
            # categorize() threshold (item G) - both produce the runaway
            # feedback loop that turns simmering pressure into paranoid
            # construal and crime-decision motivation.
            stress              (tar ? @excl)
            purpose             (tar ? @excl)
            autonomy            (tar ? @excl)
            # Rootedness in the community - tenure, employer, property, kin,
            # club memberships. The life_satisfaction band classifier reads
            # it to distinguish a LONER (low life_sat with high rootedness:
            # established but solitary by character) from an ADRIFT drifter
            # (low life_sat with low rootedness: newly arrived, no anchor).
            rootedness          (tar ? @excl)
            # PR-life-C 2026-05-25 - derived observable locomotion level
            # (mobile / crutch_assisted / wheelchair_bound / bedridden).
            # Read from condition + (future) leg-wound state + age in
            # classify_mobility. Kind-valued (target is one of the
            # mobility_level sub-kinds declared in Concepts.mon).
            mobility            (tar @excl mobility_level)

        # Historical-sim-only situation predicates (hsim_ prefix). Read by the
        # event engine to drive crime / drama template eligibility and role
        # binding. Pruned from NPC minds at the historical -> interactive
        # phase transition.
        (hsim)                  (+ sub human)
            hsim_motive             (tar @excl)
            hsim_secret_at_risk
            hsim_publicly_humiliated
            hsim_family_dishonored
            hsim_legacy_threatened
            hsim_class_resentful
            hsim_religious_zealot
            hsim_political_radical
            hsim_witness_to_suffering
            hsim_business_failing
            hsim_homeless
