# Typically arrives via seed_event from another crime. Mechanic: the
# perpetrator (often a guilt-ridden accomplice) writes a confession - we
# install a high-fidelity belief about a prior crime in the region's
# population.
event "the_confession_letter" {
    display "The Confession Letter"
    tag crime psychological
    schedule seeded
    magnitude 70
    role "writer" {
        kind=npc alive age=20..80
        optional
    }
    on_fire {
        emotion_delta writer guilt 0.95
        emotion_delta writer shame 0.9
        propagate confessed writer observers=region_of fidelity=0.85 salience=0.9
    }
}
